#!/usr/bin/env ruby

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "set"
require "tempfile"
require "time"

options = { repo_root: File.expand_path("..", __dir__), validate_schema: true }
OptionParser.new do |parser|
  parser.banner = "publish-perspective-library --channel authoring|release"
  parser.on("--channel CHANNEL") { |value| options[:channel] = value }
  parser.on("--repo-root PATH") { |value| options[:repo_root] = File.expand_path(value) }
  parser.on("--source PATH") { |value| options[:source] = File.expand_path(value) }
  parser.on("--schema-dir PATH") { |value| options[:schema_dir] = File.expand_path(value) }
  parser.on("--skip-schema") { options[:validate_schema] = false }
end.parse!

channel = options[:channel]
abort("--channel must be authoring or release") unless %w[authoring release].include?(channel)
repo_root = options.fetch(:repo_root)
source_root = options[:source] || File.join(repo_root, "apps/selflo/perspective-library/source/vi")
output_root = File.join(repo_root, "apps/selflo/perspective-library/#{channel}/vi")
schema_root = options[:schema_dir] || File.join(repo_root, "apps/selflo/perspective-library/tooling/schema")

def read_json(path)
  JSON.parse(File.binread(path))
rescue Errno::ENOENT
  abort("Missing file: #{path}")
rescue JSON::ParserError => error
  abort("Invalid JSON #{path}: #{error.message}")
end

def json_bytes(value)
  JSON.pretty_generate(value) + "\n"
end

def sha(bytes)
  Digest::SHA256.hexdigest(bytes)
end

def atomic_write(path, bytes)
  FileUtils.mkdir_p(File.dirname(path))
  temporary = "#{path}.next"
  File.binwrite(temporary, bytes)
  File.rename(temporary, path)
end

def immutable_write(path, bytes)
  FileUtils.mkdir_p(File.dirname(path))
  if File.exist?(path)
    abort("Immutable path conflict: #{path}") unless File.binread(path) == bytes
    return
  end
  File.binwrite(path, bytes)
end

def revisioned_path(source_path, revision)
  extension = File.extname(source_path)
  stem = source_path.delete_suffix(extension)
  "#{stem}.r#{revision}#{extension}"
end

def release_ready_review?(entity)
  entity.dig("review", "status") == "approved" &&
    entity.dig("rights", "status") != "unverified"
end

def release_ready_story?(story)
  story.fetch("status") == "active" && release_ready_review?(story)
end

def without_revisions(value)
  case value
  when Hash
    value.each_with_object({}) do |(key, child), result|
      result[key] = without_revisions(child) unless key == "revision"
    end
  when Array
    value.map { |child| without_revisions(child) }
  else
    value
  end
end

def validate_source_index!(source_root, index)
  abort("Unsupported source schema") unless index.fetch("schema_version") == "selflo.perspective.authoring-source.v1"
  index.fetch("files").each do |entry|
    path = File.expand_path(entry.fetch("path"), source_root)
    root = source_root.end_with?("/") ? source_root : source_root + "/"
    abort("Unsafe source path: #{entry.fetch("path")}") unless path.start_with?(root)
    abort("Missing source file: #{entry.fetch("path")}") unless File.file?(path)
  end
end

def canonical_source_digest(source_root, index)
  material = index.fetch("files").sort_by { |entry| entry.fetch("path") }.map do |entry|
    path = File.join(source_root, entry.fetch("path"))
    "#{entry.fetch("path")}\0#{sha(File.binread(path))}"
  end.join("\n")
  sha(material)
end

def validate_references!(payloads, channel)
  knowledge = payloads.fetch("knowledge_catalog").fetch(0)
  themes = payloads.fetch("quote_pack")
  stories = payloads.fetch("story", [])
  quotes = themes.flat_map { |theme| theme.fetch("quotes") }
  theme_ids = themes.map { |theme| theme.fetch("primary_theme") }.to_set
  quote_ids = quotes.map { |quote| quote.fetch("id") }
  story_ids = stories.map { |story| story.fetch("id") }.to_set
  concepts = knowledge.fetch("concepts").map { |item| item.fetch("id") }.to_set
  theories = knowledge.fetch("theories").map { |item| item.fetch("id") }.to_set
  frameworks = knowledge.fetch("frameworks").map { |item| item.fetch("id") }.to_set
  truths = knowledge.fetch("theories").flat_map { |item| item.fetch("core_truths").map { |truth| truth.fetch("id") } }.to_set
  references = knowledge.fetch("references").map { |item| item.fetch("id") }.to_set
  abort("Quote IDs are not unique") unless quote_ids.uniq.length == quote_ids.length
  abort("Theme IDs are not unique") unless theme_ids.length == themes.length
  quotes.each do |quote|
    id = quote.fetch("id")
    abort("Theme mismatch: #{id}") unless theme_ids.include?(quote.fetch("primary_theme"))
    abort("Broken story: #{id}") if quote["story_id"] && !story_ids.include?(quote.fetch("story_id"))
    {
      "concepts" => concepts,
      "theories" => theories,
      "frameworks" => frameworks
    }.each do |field, valid|
      missing = quote.dig("metadata", field).reject { |value| valid.include?(value) }
      abort("Broken #{field} on #{id}: #{missing.join(", ")}") unless missing.empty?
    end
    next unless quote["knowledge_basis"]
    missing_truths = quote.dig("knowledge_basis", "core_truth_ids").reject { |value| truths.include?(value) }
    missing_refs = quote.dig("knowledge_basis", "reference_ids").reject { |value| references.include?(value) }
    abort("Broken core truth on #{id}: #{missing_truths.join(", ")}") unless missing_truths.empty?
    abort("Broken reference on #{id}: #{missing_refs.join(", ")}") unless missing_refs.empty?
  end
  stories.each do |story|
    abort("Unknown story theme #{story.fetch("id")}") unless theme_ids.include?(story.fetch("primary_theme"))
    missing = story.dig("metadata", "concept_ids").reject { |value| concepts.include?(value) }
    abort("Broken story concept #{story.fetch("id")}: #{missing.join(", ")}") unless missing.empty?
  end
  knowledge.fetch("concepts").each do |concept|
    abort("Broken concept theme #{concept.fetch("id")}") unless concept.fetch("primary_theme_ids").all? { |id| theme_ids.include?(id) }
    abort("Broken related theory #{concept.fetch("id")}") unless concept.fetch("related_theory_ids").all? { |id| theories.include?(id) }
    abort("Broken related framework #{concept.fetch("id")}") unless concept.fetch("related_framework_ids").all? { |id| frameworks.include?(id) }
  end
  knowledge.fetch("theories").each do |theory|
    abort("Broken theory reference #{theory.fetch("id")}") unless theory.fetch("reference_ids").all? { |id| references.include?(id) }
  end
  knowledge.fetch("frameworks").each do |framework|
    abort("Broken framework reference #{framework.fetch("id")}") unless framework.fetch("reference_ids").all? { |id| references.include?(id) }
  end
  return unless channel == "release"
  abort("Release knowledge catalog is not approved") unless knowledge.fetch("status") == "approved"
  knowledge.fetch("concepts").each { |item| abort("Release concept not approved: #{item.fetch("id")}") unless item.fetch("status") == "approved" }
  knowledge.fetch("theories").each do |item|
    abort("Release theory not approved/source_checked: #{item.fetch("id")}") unless item.fetch("status") == "approved" && item.fetch("validation_status") == "source_checked"
  end
  knowledge.fetch("frameworks").each do |item|
    abort("Release framework not approved/source_checked: #{item.fetch("id")}") unless item.fetch("status") == "approved" && item.fetch("validation_status") == "source_checked"
  end
  knowledge.fetch("references").each { |item| abort("Release reference not source_checked: #{item.fetch("id")}") unless item.fetch("validation_status") == "source_checked" }
end

def run_schema_gate!(schema_root, manifest_path, payload_paths)
  schemas = {
    "knowledge_catalog" => "perspective-knowledge.schema.json",
    "quote_pack" => "perspective-theme.schema.json",
    "story" => "perspective-story.schema.json",
    "manifest" => "perspective-library-manifest.schema.json"
  }
  checks = payload_paths + [["manifest", manifest_path]]
  checks.each do |kind, path|
    schema = File.join(schema_root, schemas.fetch(kind))
    abort("Missing schema: #{schema}") unless File.file?(schema)
    command = [
      "npx", "--yes", "--package=ajv-cli@5.0.0", "--package=ajv-formats@3.0.1",
      "ajv", "validate", "--spec=draft2020", "-c", "ajv-formats", "-s", schema, "-d", path
    ]
    stdout, stderr, status = Open3.capture3(*command)
    abort("Schema validation failed for #{path}:\n#{stdout}#{stderr}") unless status.success?
  end
end

source_index = read_json(File.join(source_root, "source.json"))
validate_source_index!(source_root, source_index)
source_digest = canonical_source_digest(source_root, source_index)
content_entries = source_index.fetch("files").select { |entry| %w[knowledge_catalog quote_pack story image].include?(entry.fetch("kind")) }
abort("Canonical source must contain exactly one Knowledge Catalog") unless content_entries.count { |entry| entry.fetch("kind") == "knowledge_catalog" } == 1

decisions_entry = source_index.fetch("files").find { |entry| entry.fetch("kind") == "authoring_decisions" } or abort("Missing decision ledger")
decisions = read_json(File.join(source_root, decisions_entry.fetch("path")))
abort("Owner has not approved CP-003") unless decisions.fetch("owner_gate_status") == "approved"

source_payloads = content_entries.reject { |entry| entry.fetch("kind") == "image" }.to_h do |entry|
  [entry.fetch("id"), read_json(File.join(source_root, entry.fetch("path")))]
end
stories_by_id = source_payloads.select { |id, _| id.start_with?("story.") }
release_story_ids = stories_by_id.select { |_id, story| release_ready_story?(story) }.keys.to_set
release_image_ids = stories_by_id
  .select { |id, _story| release_story_ids.include?(id) }
  .values
  .map { |story| story.dig("hero_image", "file_id") }
  .compact
  .to_set
story_links_nulled = []
explicit_exclusions = decisions.fetch("release_quote_exclusions")

projected_payloads = source_payloads.transform_values { |payload| Marshal.load(Marshal.dump(payload)) }
if channel == "release"
  exclusions_by_id = explicit_exclusions.to_h { |entry| [entry.fetch("quote_id"), entry] }
  invalid_release_quotes = []
  projected_payloads.each do |id, payload|
    next unless id.start_with?("theme.")
    payload["status"] = "approved"
    original_quotes = payload.fetch("quotes")
    invalid_without_decision = original_quotes.reject { |quote| release_ready_review?(quote) || exclusions_by_id.key?(quote.fetch("id")) }
    invalid_release_quotes.concat(invalid_without_decision)
    payload["quotes"] = original_quotes.map do |quote|
      next nil if exclusions_by_id.key?(quote.fetch("id"))
      copy = Marshal.load(Marshal.dump(quote))
      if copy["story_id"] && !release_story_ids.include?(copy.fetch("story_id"))
        story_links_nulled << { "quote_id" => copy.fetch("id"), "story_id" => copy.fetch("story_id") }
        copy["story_id"] = nil
      end
      copy
    end.compact
  end
  unless invalid_release_quotes.empty?
    abort("Release blocked: #{invalid_release_quotes.length} quote(s) are not release-valid and have no explicit quote-level exclusion: #{invalid_release_quotes.first(12).map { |quote| quote.fetch("id") }.join(", ")}")
  end
  projected_payloads.delete_if { |id, _| id.start_with?("story.") && !release_story_ids.include?(id) }
end

current_manifest_path = File.join(output_root, "manifest.json")
current_manifest = File.file?(current_manifest_path) ? read_json(current_manifest_path) : nil
current_descriptors = (current_manifest&.fetch("files") || []).to_h { |entry| [entry.fetch("id"), entry] }
audit_paths = Dir.glob(File.join(output_root, "audit/r*.json")).sort_by do |path|
  File.basename(path)[/\Ar(\d+)\.json\z/, 1].to_i
end
current_audit = audit_paths.empty? ? nil : read_json(audit_paths.last)
current_source_files = (current_audit&.fetch("source_files") || []).to_h { |entry| [entry.fetch("id"), entry] }

descriptors = []
payload_bytes_by_path = {}
source_audit = []
changed = []
reused = []
payloads_by_kind = Hash.new { |hash, key| hash[key] = [] }

content_entries.each do |source_entry|
  id = source_entry.fetch("id")
  kind = source_entry.fetch("kind")
  next if kind == "story" && !projected_payloads.key?(id)
  next if kind == "image" && channel == "release" && !release_image_ids.include?(id)
  source_audit << { "id" => id, "sha256" => sha(File.binread(File.join(source_root, source_entry.fetch("path")))), "path" => source_entry.fetch("path") }
  previous = current_descriptors[id]
  source_bytes = File.binread(File.join(source_root, source_entry.fetch("path")))
  if kind == "image"
    if previous && File.binread(File.join(output_root, previous.fetch("path"))) == source_bytes
      descriptors << previous
      reused << id
      next
    end
    revision = previous ? previous.fetch("revision") + 1 : 1
    bytes = source_bytes
  else
    payload = projected_payloads.fetch(id)
    previous_payload = previous ? read_json(File.join(output_root, previous.fetch("path"))) : nil
    if previous_payload && without_revisions(previous_payload) == without_revisions(payload)
      descriptors << previous
      reused << id
      next
    end
    revision = previous ? previous.fetch("revision") + 1 : 1
    if kind == "story"
      payload["revision"] = revision
    elsif kind == "quote_pack"
      previous_quotes = (previous_payload&.fetch("quotes") || []).to_h { |quote| [quote.fetch("id"), quote] }
      payload.fetch("quotes").each do |quote|
        prior = previous_quotes[quote.fetch("id")]
        quote["revision"] = if prior && without_revisions(prior) == without_revisions(quote)
                              prior.fetch("revision")
                            elsif prior
                              prior.fetch("revision") + 1
                            else
                              quote.fetch("revision", 1)
                            end
      end
    end
    payloads_by_kind[kind] << payload
    bytes = json_bytes(payload)
  end
  path = revisioned_path(source_entry.fetch("path"), revision)
  descriptor = {
    "id" => id,
    "kind" => kind,
    "revision" => revision,
    "path" => path,
    "media_type" => source_entry.fetch("media_type"),
    "sha256" => sha(bytes),
    "byte_count" => bytes.bytesize
  }
  descriptors << descriptor
  payload_bytes_by_path[path] = bytes
  changed << id
end

if changed.empty? && current_manifest
  puts JSON.pretty_generate("status" => "already_up_to_date", "channel" => channel, "library_revision" => current_manifest.fetch("library_revision"), "canonical_source_digest" => source_digest)
  exit(0)
end

library_revision = current_manifest ? current_manifest.fetch("library_revision") + 1 : 1
library_id = channel == "authoring" ? "selflo.perspective.authoring.vi" : "selflo.perspective.vi"
manifest = {
  "schema_version" => "1.0",
  "entity" => "perspective_library_manifest",
  "library_id" => library_id,
  "library_revision" => library_revision,
  "content_version" => source_index.fetch("content_version"),
  "language" => "vi",
  "generated_at" => Time.now.utc.iso8601,
  "files" => descriptors.sort_by { |entry| [entry.fetch("kind"), entry.fetch("id")] }
}

Dir.mktmpdir("selflo-perspective-publish") do |temporary|
  payload_paths = []
  manifest.fetch("files").each do |descriptor|
    bytes = payload_bytes_by_path[descriptor.fetch("path")] || File.binread(File.join(output_root, descriptor.fetch("path")))
    path = File.join(temporary, descriptor.fetch("path"))
    FileUtils.mkdir_p(File.dirname(path))
    File.binwrite(path, bytes)
    payload_paths << [descriptor.fetch("kind"), path] unless descriptor.fetch("kind") == "image"
  end
  manifest_path = File.join(temporary, "manifest.json")
  File.binwrite(manifest_path, json_bytes(manifest))
  grouped = payload_paths.group_by(&:first).transform_values { |items| items.map { |_kind, path| read_json(path) } }
  validate_references!(grouped, channel)
  run_schema_gate!(schema_root, manifest_path, payload_paths) if options[:validate_schema]
end

payload_bytes_by_path.each { |path, bytes| immutable_write(File.join(output_root, path), bytes) }
manifest_bytes = json_bytes(manifest)
atomic_write(current_manifest_path, manifest_bytes)
audit = {
  "schema_version" => "selflo.perspective.publish-audit.v1",
  "channel" => channel,
  "library_revision" => library_revision,
  "canonical_source_revision" => source_index.fetch("source_revision"),
  "canonical_source_digest" => source_digest,
  "canonical_quote_count" => source_index.fetch("canonical_quote_count"),
  "source_files" => source_audit.sort_by { |entry| entry.fetch("id") },
  "changed_file_ids" => changed.sort,
  "reused_file_ids" => reused.sort,
  "story_links_projected_to_null" => story_links_nulled,
  "explicit_quote_exclusions" => explicit_exclusions,
  "manifest_sha256" => sha(manifest_bytes),
  "generated_at" => manifest.fetch("generated_at")
}
immutable_write(File.join(output_root, "audit/r#{library_revision}.json"), json_bytes(audit))

puts JSON.pretty_generate(
  "status" => "published_locally",
  "channel" => channel,
  "library_revision" => library_revision,
  "canonical_source_digest" => source_digest,
  "canonical_quote_count" => source_index.fetch("canonical_quote_count"),
  "changed_file_ids" => changed.sort,
  "reused_file_ids" => reused.sort,
  "story_links_projected_to_null" => story_links_nulled,
  "explicit_quote_exclusions" => explicit_exclusions,
  "manifest_sha256" => audit.fetch("manifest_sha256"),
  "output" => output_root
)
