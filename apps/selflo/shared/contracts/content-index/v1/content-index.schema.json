{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungvo.github.io/apps/selflo/shared/contracts/content-index/v1/content-index.schema.json",
  "title": "Selflo Content Index v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "channel", "items"],
  "properties": {
    "schema_version": { "const": "selflo.content-index.v1" },
    "generated_at": { "type": "string" },
    "channel": { "enum": ["authoring", "release"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content_type", "runtime_entity", "language", "status", "revision", "source_path", "payload_ref", "search_document_vi"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "content_type": { "enum": ["quote", "story", "knowledge_insight"] },
          "runtime_entity": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 2 },
          "status": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "title_vi": { "type": ["string", "null"] },
          "text_vi": { "type": ["string", "null"] },
          "source_path": { "type": "string" },
          "payload_ref": { "type": "string" },
          "search_document_vi": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
