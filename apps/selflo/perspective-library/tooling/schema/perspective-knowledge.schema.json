{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selflo.app/schema/perspective-knowledge.schema.json",
  "title": "PerspectiveKnowledgeCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "entity", "status", "language", "concepts", "theories", "frameworks", "references"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "content_version": { "$ref": "#/$defs/non_empty_string" },
    "entity": { "const": "perspective_knowledge_catalog" },
    "status": { "enum": ["structure_preview", "content_preview", "approved"] },
    "language": { "const": "vi" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "theories": { "type": "array", "items": { "$ref": "#/$defs/theory" } },
    "frameworks": { "type": "array", "items": { "$ref": "#/$defs/framework" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "pattern": "\\S" },
    "nullable_string": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_empty_string" }] },
    "stable_id": { "type": "string", "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$" },
    "stable_id_array": { "type": "array", "items": { "$ref": "#/$defs/stable_id" } },
    "knowledge_status": { "enum": ["draft", "needs_owner_review", "approved", "rejected"] },
    "validation_status": { "enum": ["placeholder", "pending_source_review", "source_checked", "rejected"] },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name_vi", "description_vi", "primary_theme_ids", "related_theory_ids", "related_framework_ids", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "display_name_vi": { "$ref": "#/$defs/non_empty_string" },
        "description_vi": { "$ref": "#/$defs/non_empty_string" },
        "primary_theme_ids": { "type": "array", "allOf": [{ "$ref": "#/$defs/stable_id_array" }, { "type": "array", "minItems": 1 }] },
        "related_theory_ids": { "$ref": "#/$defs/stable_id_array" },
        "related_framework_ids": { "$ref": "#/$defs/stable_id_array" },
        "status": { "$ref": "#/$defs/knowledge_status" }
      }
    },
    "theory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name_vi", "original_name", "kind", "summary_vi", "core_truths", "reference_ids", "validation_status", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "display_name_vi": { "$ref": "#/$defs/non_empty_string" },
        "original_name": { "$ref": "#/$defs/nullable_string" },
        "kind": { "enum": ["psychology_theory", "philosophical_framework", "lived_observation", "public_domain_text"] },
        "summary_vi": { "$ref": "#/$defs/non_empty_string" },
        "core_truths": { "type": "array", "items": { "$ref": "#/$defs/core_truth" } },
        "reference_ids": { "$ref": "#/$defs/stable_id_array" },
        "validation_status": { "$ref": "#/$defs/validation_status" },
        "status": { "$ref": "#/$defs/knowledge_status" }
      }
    },
    "core_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text_vi", "scope_note_vi"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "text_vi": { "$ref": "#/$defs/non_empty_string" },
        "scope_note_vi": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name_vi", "description_vi", "source_domain", "reference_ids", "validation_status", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "display_name_vi": { "$ref": "#/$defs/non_empty_string" },
        "description_vi": { "$ref": "#/$defs/non_empty_string" },
        "source_domain": { "$ref": "#/$defs/stable_id" },
        "reference_ids": { "$ref": "#/$defs/stable_id_array" },
        "validation_status": { "$ref": "#/$defs/validation_status" },
        "status": { "$ref": "#/$defs/knowledge_status" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "authors", "year", "publisher_or_journal", "url", "language", "rights_note", "validation_status"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "type": { "enum": ["book_or_paper", "web", "public_domain_text"] },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "authors": { "type": "array", "items": { "$ref": "#/$defs/non_empty_string" } },
        "year": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
        "publisher_or_journal": { "$ref": "#/$defs/nullable_string" },
        "url": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri", "pattern": "^[hH][tT][tT][pP][sS]://" }] },
        "language": { "$ref": "#/$defs/non_empty_string" },
        "rights_note": { "$ref": "#/$defs/nullable_string" },
        "validation_status": { "$ref": "#/$defs/validation_status" }
      }
    }
  }
}
