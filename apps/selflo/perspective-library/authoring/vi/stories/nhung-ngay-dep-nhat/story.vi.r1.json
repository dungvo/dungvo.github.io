  "sections": [
    {
      "id": "section_00",
      "title_vi": null,
      "blocks": [
        {
          "id": "paragraph_001",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Truyện ngắn — Hoài niệm"
        }
      ]
    },
    {
      "id": "section_01",
      "title_vi": "1. Ba mươi năm sau",
      "blocks": [
        {
          "id": "paragraph_003",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Buổi họp lớp bắt đầu lúc sáu giờ chiều, nhưng đến gần mười giờ vẫn chưa ai muốn về."
        },
        {
          "id": "paragraph_004",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hai mươi ba người ngồi quanh ba chiếc bàn ghép lại. Người làm giám đốc, người kinh doanh, người đã nghỉ việc, người tóc bạc gần hết. Có người mang theo cả kính lão để đọc thực đơn."
        },
        {
          "id": "paragraph_005",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng chỉ cần một người nhắc đến chuyện cũ, tất cả lại nói cười như những đứa học trò mười bảy tuổi."
        },
        {
          "id": "dialogue_006",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_006",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Ê, tụi bây còn nhớ thằng Tuấn trèo tường trốn học không?"
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_007",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_007",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Nhớ chứ! Nó bị thầy thể dục bắt đứng ngoài sân cả buổi!"
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_008",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_008",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Không phải! Hôm đó thầy bắt nó chạy mười vòng sân!"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_009",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cả bàn cười ầm lên."
        },
        {
          "id": "paragraph_010",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tuấn ngồi giữa đám bạn, vừa cười vừa phản đối:"
        },
        {
          "id": "dialogue_011",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_011",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tụi bây nhớ sai hết rồi. Hôm đó tao trèo tường đi mua thuốc cho mẹ tao. Thầy biết nên cho tao về luôn."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_012",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mọi người im lặng một thoáng."
        },
        {
          "id": "paragraph_013",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi có người chuyển sang chuyện khác."
        },
        {
          "id": "paragraph_014",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những câu chuyện cứ nối tiếp nhau. Chuyện cô giáo dạy Văn, chuyện trận bóng thua lớp bên cạnh, chuyện những lá thư tình được chuyền qua ngăn bàn."
        },
        {
          "id": "paragraph_015",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh ngồi nghe, lòng nhẹ đi một cách lạ lùng."
        },
        {
          "id": "paragraph_016",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đã lâu lắm rồi anh không cười nhiều như thế."
        },
        {
          "id": "paragraph_017",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở tuổi bốn mươi tám, Minh có cuộc sống khá ổn định. Anh làm quản lý tại một công ty lớn, có vợ, hai con và một căn nhà đã trả hết nợ."
        },
        {
          "id": "paragraph_018",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng phần lớn những ngày gần đây của anh rất giống nhau."
        },
        {
          "id": "paragraph_019",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sáng đưa con đi học. Đến công ty họp, trả lời email, giải quyết những việc phát sinh. Chiều về nhà, ăn cơm, xem điện thoại rồi ngủ."
        },
        {
          "id": "paragraph_020",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không phải anh không hạnh phúc."
        },
        {
          "id": "paragraph_021",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chỉ là hiếm khi anh có cảm giác một ngày nào đó thật sự đáng nhớ."
        },
        {
          "id": "paragraph_022",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tối ấy, nghe bạn bè gọi mình bằng biệt danh cũ, anh bỗng thấy như mình vừa gặp lại một người đã lâu không xuất hiện."
        },
        {
          "id": "paragraph_023",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chính mình của ba mươi năm trước."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "2. Ngày xưa vui hơn",
      "blocks": [
        {
          "id": "paragraph_025",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Gần cuối buổi, Hùng nâng ly."
        },
        {
          "id": "dialogue_026",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_026",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tao nói thật, càng lớn tao càng thấy ngày xưa vui hơn. Hồi đó không có tiền mà cái gì cũng vui. Bây giờ có đủ thứ, lại thấy thiếu thiếu."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_027",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều người gật đầu."
        },
        {
          "id": "dialogue_028",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_028",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Đúng rồi. Hồi đó chỉ cần một trái bóng là chơi cả chiều."
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_029",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_029",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Ngày xưa bạn bè cũng thân hơn. Có chuyện gì là chạy qua nhà nhau ngay."
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_030",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_030",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Giờ muốn hẹn nhau một bữa phải lên lịch trước cả tháng."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_031",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh đồng tình."
        },
        {
          "id": "paragraph_032",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhớ những buổi chiều đạp xe ra bờ sông. Cả nhóm ngồi đến tối, không ai cần nhìn đồng hồ."
        },
        {
          "id": "paragraph_033",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhớ cảm giác mong đến thứ Bảy, dù chẳng có kế hoạch gì đặc biệt."
        },
        {
          "id": "paragraph_034",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nói:"
        },
        {
          "id": "dialogue_035",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_035",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tao nghĩ tuổi học trò là thời đẹp nhất của đời người."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_036",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở cuối bàn, Phúc đặt ly nước xuống."
        },
        {
          "id": "dialogue_037",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_037",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tao thì không nghĩ vậy."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_038",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mọi người quay sang."
        },
        {
          "id": "paragraph_039",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phúc là người ít nói nhất lớp. Anh từng bỏ học một thời gian để phụ gia đình, sau đó mới quay lại học hết phổ thông."
        },
        {
          "id": "paragraph_040",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "— Với tao, những năm đó mệt lắm — Phúc nói. — Sáng đi học, chiều phụ bán hàng, tối về còn học bài. Nhiều hôm thấy tụi bây rủ nhau đi chơi mà tao chỉ muốn khóc."
        },
        {
          "id": "paragraph_041",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng vỗ vai bạn."
        },
        {
          "id": "dialogue_042",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_042",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Nhưng giờ nhớ lại cũng vui chứ?"
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_043",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_043",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Có chứ. Nhớ tụi bây thì vui. Nhưng nếu được sống lại nguyên những năm ấy, chắc tao không muốn."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_044",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không ai tranh luận."
        },
        {
          "id": "paragraph_045",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một lúc sau, Phúc hỏi:"
        },
        {
          "id": "dialogue_046",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_046",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Mà tụi bây có bao giờ nghĩ, hồi đó mình cũng hay than phiền không?"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_047",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tuấn cười:"
        },
        {
          "id": "dialogue_048",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_048",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tao nhớ ngày nào cũng mong ra trường để được đi làm, kiếm tiền."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_049",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "— Tao thì chỉ mong lớn nhanh để khỏi bị ba mẹ quản — Hùng nói."
        },
        {
          "id": "paragraph_050",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nhớ lại."
        },
        {
          "id": "paragraph_051",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đúng là ngày ấy anh cũng từng mong thời gian trôi nhanh."
        },
        {
          "id": "paragraph_052",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh mong tốt nghiệp, mong có việc làm, mong có tiền mua xe máy, mong có nhà riêng."
        },
        {
          "id": "paragraph_053",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đã dành rất nhiều năm tháng tuổi trẻ để chờ đợi tương lai."
        },
        {
          "id": "paragraph_054",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vậy mà khi tương lai ấy đến, anh lại bắt đầu nhớ về những năm tháng mình từng mong mau chóng đi qua."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": "3. Những phiên bản khác nhau của cùng một ngày",
      "blocks": [
        {
          "id": "paragraph_056",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hai tuần sau buổi họp lớp, nhóm chat vẫn liên tục có tin nhắn."
        },
        {
          "id": "paragraph_057",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người gửi ảnh cũ."
        },
        {
          "id": "paragraph_058",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người đăng bài hát ngày xưa."
        },
        {
          "id": "paragraph_059",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người tìm được đoạn video quay lễ tổng kết năm cuối."
        },
        {
          "id": "paragraph_060",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh mở video vào giờ nghỉ trưa."
        },
        {
          "id": "paragraph_061",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hình ảnh rung lắc, âm thanh rè rè."
        },
        {
          "id": "paragraph_062",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trong đoạn phim, những học sinh mặc áo trắng chen nhau trước sân khấu. Một vài đứa đứng dưới nắng, lấy sách che đầu."
        },
        {
          "id": "paragraph_063",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nhìn thấy mình ở góc màn hình."
        },
        {
          "id": "paragraph_064",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đang đứng cạnh Hùng, khuôn mặt nhăn nhó."
        },
        {
          "id": "paragraph_065",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi anh nghe chính mình nói:"
        },
        {
          "id": "dialogue_066",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_066",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Nóng muốn chết! Bao giờ mới xong cái lễ này?"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_067",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng trong video đáp:"
        },
        {
          "id": "dialogue_068",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_068",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Tao chỉ mong hết năm nay để khỏi phải đến trường nữa."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_069",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh bật cười."
        },
        {
          "id": "paragraph_070",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhớ rất rõ buổi lễ ấy."
        },
        {
          "id": "paragraph_071",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng trong trí nhớ của anh suốt nhiều năm, đó là một buổi sáng đẹp. Nắng vàng, tiếng ve, những gương mặt trẻ trung và cảm giác lưu luyến khi sắp chia tay."
        },
        {
          "id": "paragraph_072",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đã quên mất cái nóng."
        },
        {
          "id": "paragraph_073",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Quên những giờ đứng chờ."
        },
        {
          "id": "paragraph_074",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Quên rằng ngày hôm đó, anh chỉ muốn buổi lễ kết thúc thật nhanh."
        },
        {
          "id": "paragraph_075",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh xem lại video lần nữa."
        },
        {
          "id": "paragraph_076",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Kỷ niệm đẹp trong trí nhớ không hẳn là sai."
        },
        {
          "id": "paragraph_077",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Buổi sáng ấy thực sự có những điều đẹp."
        },
        {
          "id": "paragraph_078",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chỉ là theo thời gian, những điều khó chịu đã mờ đi, còn những gì đáng nhớ thì ở lại."
        },
        {
          "id": "paragraph_079",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng Minh vẫn thắc mắc tại sao bây giờ mình lại thấy buổi sáng ấy đẹp đến thế."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": "4. Điều người ta thật sự nhớ",
      "blocks": [
        {
          "id": "paragraph_081",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một chiều Chủ nhật, Minh hẹn Hùng uống cà phê."
        },
        {
          "id": "paragraph_082",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng vẫn như ngày xưa, nói nhiều và cười lớn."
        },
        {
          "id": "paragraph_083",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng khi nhắc đến công việc, giọng anh trầm xuống."
        },
        {
          "id": "paragraph_084",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cửa hàng kinh doanh của Hùng đang gặp khó khăn. Anh phải cắt giảm nhân viên và gần đây thường mất ngủ."
        },
        {
          "id": "paragraph_085",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "— Mấy hôm nay tao cứ mở ảnh lớp ra xem — Hùng nói. — Nhìn tụi mình hồi đó mà thấy nhẹ cả người."
        },
        {
          "id": "dialogue_086",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_086",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Mày muốn quay lại à?"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_087",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng nghĩ một lát."
        },
        {
          "id": "dialogue_088",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_088",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Không hẳn. Tao không muốn đi học lại đâu. Tao chỉ nhớ hồi đó mỗi lần có chuyện, bước ra sân trường là có đứa ngồi nghe."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_089",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh hỏi:"
        },
        {
          "id": "dialogue_090",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_090",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Giờ không có ai nghe mày sao?"
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_091",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_091",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Có chứ. Nhưng ai cũng có việc riêng. Tao cũng ngại kể chuyện làm ăn thất bại."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_092",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng khuấy ly cà phê."
        },
        {
          "id": "dialogue_093",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_093",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Hồi đó tao chẳng có gì để khoe, nên cũng chẳng có gì phải giấu."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_094",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Câu nói khiến Minh suy nghĩ."
        },
        {
          "id": "paragraph_095",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhớ đến Phúc, người không muốn trở lại tuổi học trò."
        },
        {
          "id": "paragraph_096",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hôm họp lớp, Phúc kể rằng cuộc sống bây giờ tốt hơn nhiều. Anh có một cửa hàng nhỏ, gia đình ổn định và lần đầu tiên trong đời có thể nghỉ ngơi mà không lo ngày mai thiếu tiền."
        },
        {
          "id": "paragraph_097",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng Phúc vẫn giữ liên lạc với lớp."
        },
        {
          "id": "paragraph_098",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh vẫn cười khi nghe chuyện cũ."
        },
        {
          "id": "paragraph_099",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh vẫn nhớ những người từng chia cho mình nửa ổ bánh mì trong giờ ra chơi."
        },
        {
          "id": "paragraph_100",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có lẽ Phúc không nhớ cái nghèo, những ngày làm việc mệt mỏi hay cảm giác thua kém bạn bè."
        },
        {
          "id": "paragraph_101",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhớ những người đã giúp mình vượt qua thời gian đó."
        },
        {
          "id": "paragraph_102",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Còn Hùng nhớ một thời có thể nói ra những lo lắng mà không sợ bị đánh giá."
        },
        {
          "id": "paragraph_103",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh chợt tự hỏi mình đang nhớ điều gì."
        },
        {
          "id": "paragraph_104",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh không thiếu tiền, không quá cô đơn, cũng không có biến cố lớn nào."
        },
        {
          "id": "paragraph_105",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng có lẽ anh nhớ cảm giác mọi thứ còn mới mẻ."
        },
        {
          "id": "paragraph_106",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày ấy, một chuyến đi xa mười cây số cũng có thể trở thành chuyện kể cả tuần."
        },
        {
          "id": "paragraph_107",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một lời tỏ tình, một trận bóng, một kỳ thi đều có thể khiến anh hồi hộp suốt nhiều ngày."
        },
        {
          "id": "paragraph_108",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bây giờ anh đã đi nhiều nơi, gặp nhiều người, trải qua nhiều chuyện."
        },
        {
          "id": "paragraph_109",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những điều từng khiến anh háo hức đã trở nên quen thuộc."
        },
        {
          "id": "paragraph_110",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không phải cuộc sống hiện tại không có gì đẹp."
        },
        {
          "id": "paragraph_111",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chỉ là anh đã ít để ý đến nó theo cách mình từng làm khi còn trẻ."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": "5. Một cuộc hẹn khác",
      "blocks": [
        {
          "id": "paragraph_113",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tháng sau, Minh đề nghị cả nhóm gặp nhau lần nữa."
        },
        {
          "id": "paragraph_114",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần này không phải họp lớp."
        },
        {
          "id": "paragraph_115",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh rủ mọi người đi đạp xe vào sáng Chủ nhật."
        },
        {
          "id": "paragraph_116",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng hưởng ứng đầu tiên."
        },
        {
          "id": "paragraph_117",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phúc từ chối vì phải đưa con đi khám."
        },
        {
          "id": "paragraph_118",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một vài người bận công việc. Có người ở xa. Cuối cùng chỉ còn bốn người tham gia."
        },
        {
          "id": "paragraph_119",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sáu giờ sáng, Minh đến điểm hẹn."
        },
        {
          "id": "paragraph_120",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng đã có mặt, đứng bên chiếc xe đạp thể thao đắt tiền."
        },
        {
          "id": "paragraph_121",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tuấn vừa đến vừa than đau lưng."
        },
        {
          "id": "paragraph_122",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người cuối cùng là Lâm, ngày xưa vốn ít tham gia những cuộc vui."
        },
        {
          "id": "paragraph_123",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cả nhóm đạp xe theo con đường ven sông."
        },
        {
          "id": "paragraph_124",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ban đầu, họ lại kể chuyện cũ."
        },
        {
          "id": "paragraph_125",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai từng bị phạt."
        },
        {
          "id": "paragraph_126",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai từng thích ai."
        },
        {
          "id": "paragraph_127",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai từng nói câu gì ngớ ngẩn."
        },
        {
          "id": "paragraph_128",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng đến đoạn đường dài, câu chuyện dần chuyển sang những việc đang xảy ra."
        },
        {
          "id": "paragraph_129",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tuấn kể con trai sắp thi đại học."
        },
        {
          "id": "paragraph_130",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lâm đang học chơi đàn guitar ở tuổi bốn mươi tám."
        },
        {
          "id": "paragraph_131",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hùng nói anh vừa quyết định đóng một cửa hàng để giảm bớt áp lực tài chính."
        },
        {
          "id": "paragraph_132",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh kể về chuyến đi mà anh định thực hiện cùng vợ nhưng đã hoãn ba lần."
        },
        {
          "id": "paragraph_133",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Họ đạp xe gần hai giờ, rồi ghé một quán ăn sáng."
        },
        {
          "id": "paragraph_134",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không ai nhận xét buổi sáng ấy có gì đặc biệt."
        },
        {
          "id": "paragraph_135",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Họ chỉ ăn, nói chuyện và hẹn lần sau."
        },
        {
          "id": "paragraph_136",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vài tháng trôi qua."
        },
        {
          "id": "paragraph_137",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhóm chat lớp vẫn thỉnh thoảng gửi ảnh cũ, nhưng bắt đầu có thêm những bức ảnh mới."
        },
        {
          "id": "paragraph_138",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tấm chụp Hùng ngã xe giữa đường, cả nhóm đứng bên cạnh cười."
        },
        {
          "id": "paragraph_139",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tấm chụp Tuấn mang chiếc bánh sinh nhật nhỏ đến quán cà phê."
        },
        {
          "id": "paragraph_140",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tấm chụp Phúc lần đầu tham gia chuyến đi, đứng thở dốc sau khi leo hết con dốc."
        },
        {
          "id": "paragraph_141",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tối, Minh mở điện thoại và thấy Hùng gửi ảnh cả nhóm ngồi ăn sáng bên sông."
        },
        {
          "id": "paragraph_142",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bên dưới có dòng chữ:"
        },
        {
          "id": "paragraph_143",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Mấy chục năm nữa, chắc lại nhớ những buổi này.”"
        },
        {
          "id": "paragraph_144",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nhìn bức ảnh."
        },
        {
          "id": "paragraph_145",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh không biết ba mươi năm nữa mình có còn nhớ buổi sáng ấy không."
        },
        {
          "id": "paragraph_146",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có thể khi đó anh sẽ quên cái nắng gắt, cơn đau đầu gối, hay chuyện Hùng than phiền suốt đường đi."
        },
        {
          "id": "paragraph_147",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có thể anh chỉ nhớ bốn người bạn ngồi bên nhau, có đủ thời gian để nói những câu chuyện chẳng cần đi đến đâu."
        },
        {
          "id": "paragraph_148",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cũng có thể những buổi sáng như thế sẽ chẳng còn nhiều."
        },
        {
          "id": "paragraph_149",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh đặt điện thoại xuống."
        },
        {
          "id": "paragraph_150",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngoài phòng khách, vợ anh đang hỏi con gái về một chuyện ở trường. Hai mẹ con vừa nói vừa cười."
        },
        {
          "id": "paragraph_151",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh bước ra, kéo ghế ngồi cùng."
        },
        {
          "id": "paragraph_152",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Con gái ngạc nhiên:"
        },
        {
          "id": "dialogue_153",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_153",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Ba không làm việc nữa hả?"
                }
              ]
            }
          ]
        },
        {
          "id": "dialogue_154",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "turn_154",
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "— Không. Ba ngồi chơi chút."
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_155",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô bé tiếp tục câu chuyện đang kể dở."
        },
        {
          "id": "paragraph_156",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nghe được một lúc thì nhận ra mình chẳng hiểu vì sao hai mẹ con lại thấy chuyện ấy buồn cười đến vậy."
        },
        {
          "id": "paragraph_157",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng anh không hỏi."
        },
        {
          "id": "paragraph_158",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh ngồi nghe tiếp."
        },
        {
          "id": "paragraph_159",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở một nơi nào đó trong tương lai, có thể anh sẽ nhớ đến buổi tối bình thường này."
        },
        {
          "id": "paragraph_160",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Còn tối nay, nó vẫn đang diễn ra."
        },
        {
          "id": "paragraph_161",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hết."
        }
      ]
    }
  ],
  "takeaway": {
    "title_vi": "Góc nhìn",
    "text_vi": "Nhớ một quãng đời không nhất thiết là muốn sống lại toàn bộ quãng đời ấy. Có khi điều còn quý là những người ở bên, cảm giác được lắng nghe, hay sự háo hức trước một điều mới. Có những điều chỉ còn trong ký ức; cũng có những điều vẫn có thể xuất hiện trong một hình thức khác hôm nay. Nỗi nhớ có thể giúp ta nhận ra điều mình coi trọng, mà chưa đủ để kết luận rằng những ngày đẹp nhất đều đã qua."
  },
