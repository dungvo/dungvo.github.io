{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_boatman_and_second_mountain",
  "revision": 2,
  "status": "draft",
  "language": "vi",
  "title_vi": "Người chèo thuyền và ngọn núi thứ hai — Bản gốc",
  "subtitle_vi": "Một hành trình đi tìm con đường không còn chỉ có một lựa chọn.",
  "hero_image": null,
  "primary_theme": "change_growth",
  "metadata": {
    "concept_ids": [
      "concept.autonomous_motivation"
    ],
    "emotion_tags": [
      "uncertainty",
      "curiosity"
    ],
    "keywords": [
      "ngọn núi thứ hai",
      "tự do",
      "thử nghiệm",
      "con đường khác"
    ],
    "story_style": "parable"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": "Lời dẫn",
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Tôi sẽ kể tiếp câu chuyện người chèo thuyền, nhưng lần này theo kiểu ngụ ngôn hành trình: ít giải thích, để ý nghĩa nằm bên dưới câu chuyện."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "Câu chuyện",
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Một buổi sáng, người chèo thuyền thức dậy trước khi mặt trời lên."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Dòng sông vẫn như mọi ngày."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "Những chiếc thuyền nối nhau rời bến. Người trẻ chèo rất nhanh. Người lớn tuổi hơn chèo chậm nhưng chắc. Thi thoảng có một chiếc thuyền lớn đi ngang qua, trên đó là những người đã trở thành quản lý của cả một đội thuyền."
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "Anh nhìn họ."
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "text_vi": "Ngày trước, anh từng muốn một ngày được đứng trên chiếc thuyền lớn ấy."
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "Bây giờ anh không còn chắc nữa."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "Anh hỏi một ông lão sửa lưới bên bờ:"
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "— Nếu tôi chèo đủ lâu, tôi sẽ đi đến đâu?"
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "text_vi": "Ông lão không ngẩng đầu."
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "— Cuối dòng sông."
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "— Ở đó có gì?"
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "— Một bến lớn hơn."
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "Anh im lặng."
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "— Rồi sao nữa?"
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "text_vi": "— Người ta sẽ cho anh một chiếc thuyền lớn hơn."
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "text_vi": "— Rồi sao nữa?"
        },
        {
          "id": "section_02.block_17",
          "type": "paragraph",
          "text_vi": "Ông lão bật cười."
        },
        {
          "id": "section_02.block_18",
          "type": "paragraph",
          "text_vi": "— Anh sẽ phải chèo nó."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Ngày hôm đó anh không đóng thêm thanh gỗ nào cho chiếc bè."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Anh đi bộ."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "Lần đầu tiên sau rất nhiều năm, anh men theo bờ sông thay vì xuống thuyền."
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Đi được khá xa, anh gặp một người bán bánh."
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "text_vi": "Quầy bánh rất nhỏ."
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "Anh hỏi:"
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "— Ông sống bằng cái này sao?"
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "— Phải."
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "text_vi": "— Một ngày ông bán được bao nhiêu?"
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Người bán bánh nói một con số."
        },
        {
          "id": "section_03.block_11",
          "type": "paragraph",
          "text_vi": "Nó ít hơn rất nhiều số tiền người chèo thuyền kiếm được."
        },
        {
          "id": "section_03.block_12",
          "type": "paragraph",
          "text_vi": "Anh thất vọng."
        },
        {
          "id": "section_03.block_13",
          "type": "paragraph",
          "text_vi": "\"Nếu rời dòng sông để sống như thế này thì có ý nghĩa gì?\""
        },
        {
          "id": "section_03.block_14",
          "type": "paragraph",
          "text_vi": "Anh tiếp tục đi."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "text_vi": "Một lúc sau anh gặp một người đang trồng cây."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "text_vi": "Người này trước kia cũng từng là người chèo thuyền."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "text_vi": "— Anh kiếm được bao nhiêu từ khu vườn này?"
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "text_vi": "— Hiện giờ à? Chẳng bao nhiêu."
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "text_vi": "— Vậy tại sao anh bỏ thuyền?"
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "text_vi": "Người làm vườn chỉ vào một cái cây nhỏ."
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "text_vi": "— Anh nghĩ cây này bao nhiêu tuổi?"
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "text_vi": "— Hai năm?"
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "text_vi": "— Bảy năm."
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền ngạc nhiên."
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "text_vi": "— Bảy năm mà chỉ lớn thế này?"
        },
        {
          "id": "section_04.block_12",
          "type": "paragraph",
          "text_vi": "— Năm năm đầu nó gần như chẳng lớn."
        },
        {
          "id": "section_04.block_13",
          "type": "paragraph",
          "text_vi": "— Vậy năm năm đó nó làm gì?"
        },
        {
          "id": "section_04.block_14",
          "type": "paragraph",
          "text_vi": "Người làm vườn lấy một cành cây vẽ xuống đất."
        },
        {
          "id": "section_04.block_15",
          "type": "paragraph",
          "text_vi": "Ông vẽ một cái cây nhỏ phía trên."
        },
        {
          "id": "section_04.block_16",
          "type": "paragraph",
          "text_vi": "Rồi bên dưới, ông vẽ một bộ rễ khổng lồ."
        },
        {
          "id": "section_04.block_17",
          "type": "paragraph",
          "text_vi": "— Nó đi xuống."
        },
        {
          "id": "section_04.block_18",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền nhìn hình vẽ."
        },
        {
          "id": "section_04.block_19",
          "type": "paragraph",
          "text_vi": "Người làm vườn nói:"
        },
        {
          "id": "section_04.block_20",
          "type": "paragraph",
          "text_vi": "— Nếu chỉ nhìn phần trên mặt đất, anh sẽ nghĩ năm năm đó nó không tiến bộ."
        },
        {
          "id": "section_04.block_21",
          "type": "paragraph",
          "text_vi": "— Nhưng thực ra?"
        },
        {
          "id": "section_04.block_22",
          "type": "paragraph",
          "text_vi": "— Nó đang chuẩn bị để sau này không dễ bị gió quật ngã."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền tiếp tục đi."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "text_vi": "Cuối ngày, anh đến chân một ngọn núi."
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "text_vi": "Ở đó có một quán trọ nhỏ."
        },
        {
          "id": "section_05.block_04",
          "type": "paragraph",
          "text_vi": "Trong quán có rất nhiều người."
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "text_vi": "Một thương nhân từng phá sản."
        },
        {
          "id": "section_05.block_06",
          "type": "paragraph",
          "text_vi": "Một người lính đã giải ngũ."
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "text_vi": "Một người từng điều hành hàng trăm người nhưng giờ đang học làm đồ gốm."
        },
        {
          "id": "section_05.block_08",
          "type": "paragraph",
          "text_vi": "Một người phụ nữ từng bán công ty của mình và đang học trồng nho."
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "text_vi": "Và một người đàn ông chẳng làm gì ngoài việc ngồi đọc sách cạnh cửa sổ."
        },
        {
          "id": "section_05.block_10",
          "type": "paragraph",
          "text_vi": "Điều kỳ lạ là tất cả họ đều nói cùng một câu:"
        },
        {
          "id": "section_05.block_11",
          "type": "pull_quote",
          "text_vi": "“Tôi từng rất giỏi một thứ.”",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_12",
          "type": "paragraph",
          "text_vi": "Nhưng chẳng ai còn làm thứ đó nữa."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "text_vi": "Đêm đó người chèo thuyền ngồi cạnh chủ quán."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "text_vi": "Anh hỏi:"
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "text_vi": "— Những người này đang làm gì ở đây?"
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "text_vi": "— Họ đang tìm ngọn núi thứ hai."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "text_vi": "— Ngọn núi thứ hai?"
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "text_vi": "Chủ quán chỉ ra ngoài cửa sổ."
        },
        {
          "id": "section_06.block_07",
          "type": "paragraph",
          "text_vi": "Trong ánh trăng có hai ngọn núi."
        },
        {
          "id": "section_06.block_08",
          "type": "paragraph",
          "text_vi": "Ngọn thứ nhất cao, dốc và đông người."
        },
        {
          "id": "section_06.block_09",
          "type": "paragraph",
          "text_vi": "Trên sườn núi đầy những ngọn đuốc đang tranh nhau leo lên."
        },
        {
          "id": "section_06.block_10",
          "type": "paragraph",
          "text_vi": "Ngọn thứ hai thấp hơn."
        },
        {
          "id": "section_06.block_11",
          "type": "paragraph",
          "text_vi": "Không có đường."
        },
        {
          "id": "section_06.block_12",
          "type": "paragraph",
          "text_vi": "Cũng chẳng thấy ai ở đó."
        },
        {
          "id": "section_06.block_13",
          "type": "paragraph",
          "text_vi": "— Khi còn trẻ, gần như tất cả chúng ta đều leo ngọn núi thứ nhất."
        },
        {
          "id": "section_06.block_14",
          "type": "paragraph",
          "text_vi": "— Trên đỉnh có gì?"
        },
        {
          "id": "section_06.block_15",
          "type": "paragraph",
          "text_vi": "— Tiền. Danh tiếng. Nghề nghiệp. Khả năng. Sự công nhận."
        },
        {
          "id": "section_06.block_16",
          "type": "paragraph",
          "text_vi": "— Còn ngọn thứ hai?"
        },
        {
          "id": "section_06.block_17",
          "type": "paragraph",
          "text_vi": "Chủ quán lắc đầu."
        },
        {
          "id": "section_06.block_18",
          "type": "paragraph",
          "text_vi": "— Tôi không biết."
        },
        {
          "id": "section_06.block_19",
          "type": "paragraph",
          "text_vi": "— Ông chưa từng lên đó sao?"
        },
        {
          "id": "section_06.block_20",
          "type": "paragraph",
          "text_vi": "— Rồi."
        },
        {
          "id": "section_06.block_21",
          "type": "paragraph",
          "text_vi": "— Vậy tại sao ông không biết?"
        },
        {
          "id": "section_06.block_22",
          "type": "paragraph",
          "text_vi": "Ông cười."
        },
        {
          "id": "section_06.block_23",
          "type": "paragraph",
          "text_vi": "— Vì mỗi người có một ngọn núi thứ hai khác nhau."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền nhìn rất lâu."
        },
        {
          "id": "section_07.block_02",
          "type": "paragraph",
          "text_vi": "Rồi hỏi:"
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "text_vi": "— Làm sao biết lúc nào nên rời ngọn núi thứ nhất?"
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "text_vi": "Chủ quán nói:"
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "text_vi": "— Không cần rời."
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "text_vi": "— Tôi không hiểu."
        },
        {
          "id": "section_07.block_07",
          "type": "paragraph",
          "text_vi": "— Ban ngày anh vẫn có thể chèo thuyền."
        },
        {
          "id": "section_07.block_08",
          "type": "paragraph",
          "text_vi": "Ông chỉ về phía con đường nhỏ dẫn lên núi."
        },
        {
          "id": "section_07.block_09",
          "type": "paragraph",
          "text_vi": "— Nhưng thỉnh thoảng, hãy đi sang đây."
        },
        {
          "id": "section_07.block_10",
          "type": "paragraph",
          "text_vi": "— Để làm gì?"
        },
        {
          "id": "section_07.block_11",
          "type": "paragraph",
          "text_vi": "— Đào."
        },
        {
          "id": "section_07.block_12",
          "type": "paragraph",
          "text_vi": "— Đào cái gì?"
        },
        {
          "id": "section_07.block_13",
          "type": "paragraph",
          "text_vi": "— Anh chưa biết."
        },
        {
          "id": "section_07.block_14",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền bật cười."
        },
        {
          "id": "section_07.block_15",
          "type": "paragraph",
          "text_vi": "— Nếu tôi không biết mình tìm gì thì đào để làm gì?"
        },
        {
          "id": "section_07.block_16",
          "type": "paragraph",
          "text_vi": "Chủ quán cũng cười."
        },
        {
          "id": "section_07.block_17",
          "type": "paragraph",
          "text_vi": "— Đó chính là lý do phải đào."
        }
      ]
    },
    {
      "id": "section_08",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_08.block_01",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau anh trở lại dòng sông."
        },
        {
          "id": "section_08.block_02",
          "type": "paragraph",
          "text_vi": "Anh vẫn đi làm."
        },
        {
          "id": "section_08.block_03",
          "type": "paragraph",
          "text_vi": "Vẫn chèo."
        },
        {
          "id": "section_08.block_04",
          "type": "paragraph",
          "text_vi": "Vẫn nhận tiền."
        },
        {
          "id": "section_08.block_05",
          "type": "paragraph",
          "text_vi": "Không có gì thay đổi."
        },
        {
          "id": "section_08.block_06",
          "type": "paragraph",
          "text_vi": "Nhưng mỗi tuần anh dành một buổi đi về phía ngọn núi thứ hai."
        },
        {
          "id": "section_08.block_07",
          "type": "paragraph",
          "text_vi": "Anh thử làm rất nhiều thứ."
        },
        {
          "id": "section_08.block_08",
          "type": "paragraph",
          "text_vi": "Anh làm một chiếc bàn và chẳng ai mua."
        },
        {
          "id": "section_08.block_09",
          "type": "paragraph",
          "text_vi": "Anh dạy một người trẻ chèo thuyền và phát hiện mình thích việc đó."
        },
        {
          "id": "section_08.block_10",
          "type": "paragraph",
          "text_vi": "Anh bỏ tiền vào một vụ buôn bán nhỏ rồi mất gần hết."
        },
        {
          "id": "section_08.block_11",
          "type": "paragraph",
          "text_vi": "Anh viết những điều mình biết về dòng sông. Chẳng ai đọc."
        },
        {
          "id": "section_08.block_12",
          "type": "paragraph",
          "text_vi": "Anh giúp một người thiết kế lại chiếc thuyền và người đó trả cho anh một ít tiền."
        },
        {
          "id": "section_08.block_13",
          "type": "paragraph",
          "text_vi": "Anh bắt đầu chú ý."
        },
        {
          "id": "section_08.block_14",
          "type": "paragraph",
          "text_vi": "Không phải thứ gì kiếm được nhiều tiền nhất."
        },
        {
          "id": "section_08.block_15",
          "type": "paragraph",
          "text_vi": "Mà là thứ nào khiến anh muốn quay lại làm lần nữa."
        },
        {
          "id": "section_08.block_16",
          "type": "paragraph",
          "text_vi": "Nhiều năm trôi qua."
        },
        {
          "id": "section_08.block_17",
          "type": "paragraph",
          "text_vi": "Một sáng nọ, anh nhận ra mình đã không đóng chiếc bè nữa."
        },
        {
          "id": "section_08.block_18",
          "type": "paragraph",
          "text_vi": "Anh chạy đến tìm ông lão sửa lưới."
        },
        {
          "id": "section_08.block_19",
          "type": "paragraph",
          "text_vi": "— Tôi đã sai rồi. Tôi định đóng bè để một ngày bỏ dòng sông. Nhưng mấy năm rồi tôi chẳng đóng nữa."
        },
        {
          "id": "section_08.block_20",
          "type": "paragraph",
          "text_vi": "Ông lão vẫn ngồi ở chỗ cũ."
        },
        {
          "id": "section_08.block_21",
          "type": "paragraph",
          "text_vi": "— Tôi biết."
        },
        {
          "id": "section_08.block_22",
          "type": "paragraph",
          "text_vi": "— Vậy làm sao tôi sang được bờ bên kia?"
        },
        {
          "id": "section_08.block_23",
          "type": "paragraph",
          "text_vi": "Ông lão nhìn anh:"
        },
        {
          "id": "section_08.block_24",
          "type": "paragraph",
          "text_vi": "— Ai nói với anh rằng anh phải sang bờ bên kia?"
        },
        {
          "id": "section_08.block_25",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền đứng im."
        },
        {
          "id": "section_08.block_26",
          "type": "paragraph",
          "text_vi": "Ông lão chỉ về phía xa."
        },
        {
          "id": "section_08.block_27",
          "type": "paragraph",
          "text_vi": "Trên sườn ngọn núi thứ hai có một căn nhà nhỏ."
        },
        {
          "id": "section_08.block_28",
          "type": "paragraph",
          "text_vi": "Xung quanh là những cái cây."
        },
        {
          "id": "section_08.block_29",
          "type": "paragraph",
          "text_vi": "Một vài người trẻ đang ngồi nghe ai đó nói chuyện."
        },
        {
          "id": "section_08.block_30",
          "type": "paragraph",
          "text_vi": "Và cạnh căn nhà là một xưởng nhỏ đầy những thứ kỳ lạ mà anh đã làm trong những năm qua."
        },
        {
          "id": "section_08.block_31",
          "type": "paragraph",
          "text_vi": "Người chèo thuyền nhìn thật lâu."
        },
        {
          "id": "section_08.block_32",
          "type": "paragraph",
          "text_vi": "Rồi anh nhận ra người đang đứng trước căn nhà đó."
        },
        {
          "id": "section_08.block_33",
          "type": "pull_quote",
          "text_vi": "Là mình.",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_34",
          "type": "paragraph",
          "text_vi": "Ông lão nói:"
        },
        {
          "id": "section_08.block_35",
          "type": "paragraph",
          "text_vi": "— Anh cứ nghĩ tự do là ngày mình đủ tiền để bỏ chiếc thuyền."
        },
        {
          "id": "section_08.block_36",
          "type": "paragraph",
          "text_vi": "— Không phải sao?"
        },
        {
          "id": "section_08.block_37",
          "type": "paragraph",
          "text_vi": "— Không."
        },
        {
          "id": "section_08.block_38",
          "type": "paragraph",
          "text_vi": "Ông thu chiếc lưới vừa sửa xong lại."
        },
        {
          "id": "section_08.block_39",
          "type": "paragraph",
          "text_vi": "— Tự do bắt đầu từ ngày chiếc thuyền không còn là con đường duy nhất của anh."
        },
        {
          "id": "section_08.block_40",
          "type": "paragraph",
          "text_vi": "Mặt trời bắt đầu lên."
        },
        {
          "id": "section_08.block_41",
          "type": "paragraph",
          "text_vi": "Ngoài sông, tiếng những mái chèo đầu tiên của ngày mới vang lên."
        },
        {
          "id": "section_08.block_42",
          "type": "paragraph",
          "text_vi": "Người đàn ông cầm mái chèo của mình và bước xuống thuyền."
        },
        {
          "id": "section_08.block_43",
          "type": "paragraph",
          "text_vi": "Ngày hôm đó anh vẫn đi làm."
        },
        {
          "id": "section_08.block_44",
          "type": "paragraph",
          "text_vi": "Nhưng lần đầu tiên sau rất nhiều năm,"
        },
        {
          "id": "section_08.block_45",
          "type": "paragraph",
          "text_vi": "anh không còn cảm thấy mình đang đi xuống."
        },
        {
          "id": "section_08.block_46",
          "type": "paragraph",
          "text_vi": "Bởi vì anh cuối cùng đã hiểu:"
        },
        {
          "id": "section_08.block_47",
          "type": "pull_quote",
          "text_vi": "Có những giai đoạn của cuộc đời, thứ đang lớn lên nằm dưới mặt đất.",
          "attribution_vi": null
        }
      ]
    }
  ],
