  "sections": [
    {
      "id": "section_00",
      "title_vi": null,
      "blocks": [
        {
          "id": "paragraph_001",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở một thành phố nọ, không ai phải lên dây cót cho đồng hồ."
        },
        {
          "id": "paragraph_002",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Từ chiếc đồng hồ lớn trên quảng trường đến những chiếc đồng hồ nhỏ trong từng ngôi nhà, tất cả đều được nối với một cỗ máy khổng lồ nằm sâu dưới lòng đất."
        },
        {
          "id": "paragraph_003",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hàng triệu bánh răng quay cùng nhau, truyền chuyển động từ chiếc này sang chiếc khác."
        },
        {
          "id": "paragraph_004",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhờ vậy, suốt hàng trăm năm, thành phố chưa từng chậm một phút."
        },
        {
          "id": "paragraph_005",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở tầng sâu nhất của cỗ máy có một bánh răng tên là Vành."
        },
        {
          "id": "paragraph_006",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành được đúc từ thứ hợp kim quý hiếm, có thể chịu lực rất lớn và truyền chuyển động cho hàng trăm trục máy cùng lúc."
        },
        {
          "id": "paragraph_007",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày mới được chế tạo, Vành từng vận hành Cỗ Máy Thiên Văn, nơi tính toán chuyển động của các vì sao và dự đoán thủy triều."
        },
        {
          "id": "paragraph_008",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đó là những năm tháng Vành quay nhanh nhất."
        },
        {
          "id": "paragraph_009",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mỗi vòng quay đều đòi hỏi sự chính xác. Chỉ cần một chiếc răng lệch đi, cả hệ thống có thể mất phương hướng."
        },
        {
          "id": "paragraph_010",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng rồi thành phố xây dựng một cỗ máy thiên văn mới."
        },
        {
          "id": "paragraph_011",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành được chuyển đến tháp đồng hồ phía Tây."
        },
        {
          "id": "paragraph_012",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Công việc của nó rất đơn giản: mỗi ngày quay đúng một vòng, giữ cho chiếc kim giờ không bị lệch."
        },
        {
          "id": "paragraph_013",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ban đầu, Vành thấy nhẹ nhõm."
        },
        {
          "id": "paragraph_014",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không còn những cú va đập dữ dội. Không còn những đêm phải quay hết sức để chống lại áp lực từ hàng trăm trục máy."
        },
        {
          "id": "paragraph_015",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Thời gian trôi qua."
        },
        {
          "id": "paragraph_016",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một năm."
        },
        {
          "id": "paragraph_017",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mười năm."
        },
        {
          "id": "paragraph_018",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi ba mươi năm."
        },
        {
          "id": "paragraph_019",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành vẫn quay đúng một vòng mỗi ngày."
        },
        {
          "id": "paragraph_020",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không nhanh hơn."
        },
        {
          "id": "paragraph_021",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không chậm hơn."
        }
      ]
    },
    {
      "id": "section_01",
      "title_vi": "I. Vết gỉ đầu tiên",
      "blocks": [
        {
          "id": "paragraph_023",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một buổi sáng, Vành nghe tiếng kim loại va vào nhau từ tầng máy bên cạnh."
        },
        {
          "id": "paragraph_024",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một bánh răng mới được đưa đến."
        },
        {
          "id": "paragraph_025",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó nhỏ hơn Vành nhiều, các răng mỏng và sáng bóng."
        },
        {
          "id": "paragraph_026",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi tên là Tia,” bánh răng mới nói. “Tôi vừa được chuyển từ xưởng phía Bắc đến.”"
        },
        {
          "id": "paragraph_027",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Cậu làm gì ở đó?”"
        },
        {
          "id": "paragraph_028",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi vận hành những cỗ máy đo gió. Mỗi giây phải thay đổi tốc độ hàng chục lần.”"
        },
        {
          "id": "paragraph_029",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành im lặng."
        },
        {
          "id": "paragraph_030",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tia nhìn chiếc trục chậm chạp của Vành."
        },
        {
          "id": "paragraph_031",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Còn ông?”"
        },
        {
          "id": "paragraph_032",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi giữ giờ cho tháp phía Tây.”"
        },
        {
          "id": "paragraph_033",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chỉ vậy thôi sao?”"
        },
        {
          "id": "paragraph_034",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chỉ vậy.”"
        },
        {
          "id": "paragraph_035",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tia ngạc nhiên."
        },
        {
          "id": "paragraph_036",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nhưng ông được chế tạo để chịu lực lớn hơn tôi gấp trăm lần.”"
        },
        {
          "id": "paragraph_037",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành không trả lời."
        },
        {
          "id": "paragraph_038",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đêm hôm ấy, khi thành phố chìm vào giấc ngủ, Vành thử quay nhanh hơn một chút."
        },
        {
          "id": "paragraph_039",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tiếng rít vang lên."
        },
        {
          "id": "paragraph_040",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chiếc răng thứ mười bảy bị kẹt."
        },
        {
          "id": "paragraph_041",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành cố thêm lần nữa."
        },
        {
          "id": "paragraph_042",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một mảnh gỉ nhỏ rơi xuống nền đá."
        },
        {
          "id": "paragraph_043",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó dừng lại."
        },
        {
          "id": "paragraph_044",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần đầu tiên sau ba mươi năm, Vành nhận ra mình không còn quay được như trước."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "II. Lời mời từ phía Đông",
      "blocks": [
        {
          "id": "paragraph_046",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vài ngày sau, một người thợ máy đến kiểm tra tháp phía Tây."
        },
        {
          "id": "paragraph_047",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông mang theo bản thiết kế của một cỗ máy mới đang được xây dựng bên kia sông."
        },
        {
          "id": "paragraph_048",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cỗ máy ấy có thể điều khiển những con đập, đưa nước đến các cánh đồng khô hạn."
        },
        {
          "id": "paragraph_049",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng nó cần một bánh răng lớn, đủ sức truyền chuyển động qua nhiều tầng trục."
        },
        {
          "id": "paragraph_050",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ đo đường kính của Vành."
        },
        {
          "id": "paragraph_051",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vừa khít.”"
        },
        {
          "id": "paragraph_052",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nghe thấy tim mình như đập mạnh, dù bánh răng vốn chẳng có trái tim."
        },
        {
          "id": "paragraph_053",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Ông sẽ chuyển tôi đến đó sao?”"
        },
        {
          "id": "paragraph_054",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có thể. Nhưng trước tiên phải kiểm tra độ bền.”"
        },
        {
          "id": "paragraph_055",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ gõ nhẹ vào những chiếc răng đã cũ."
        },
        {
          "id": "paragraph_056",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một âm thanh đục vang lên."
        },
        {
          "id": "paragraph_057",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Ông đã lâu không chịu tải lớn.”"
        },
        {
          "id": "paragraph_058",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi từng vận hành Cỗ Máy Thiên Văn.”"
        },
        {
          "id": "paragraph_059",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi biết.”"
        },
        {
          "id": "paragraph_060",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Không có chiếc bánh răng nào trong thành phố từng chịu lực như tôi.”"
        },
        {
          "id": "paragraph_061",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ nhìn những vết gỉ."
        },
        {
          "id": "paragraph_062",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Đó là chuyện của ba mươi năm trước.”"
        },
        {
          "id": "paragraph_063",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành không nói thêm."
        },
        {
          "id": "paragraph_064",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ tiếp tục:"
        },
        {
          "id": "paragraph_065",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nếu muốn thử, ông phải rời tháp phía Tây. Và nếu không vượt qua được bài kiểm tra, chúng tôi chưa chắc có thể đưa ông trở lại.”"
        },
        {
          "id": "paragraph_066",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn lên những trục máy đang nối với mình."
        },
        {
          "id": "paragraph_067",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phía trên là hàng nghìn chiếc đồng hồ."
        },
        {
          "id": "paragraph_068",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phía dưới là những bánh răng nhỏ đã quay cùng nó suốt nhiều thập kỷ."
        },
        {
          "id": "paragraph_069",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Thế ai sẽ giữ giờ cho tháp?”"
        },
        {
          "id": "paragraph_070",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chúng tôi sẽ tìm bánh răng thay thế.”"
        },
        {
          "id": "paragraph_071",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Đã có chưa?”"
        },
        {
          "id": "paragraph_072",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chưa.”"
        },
        {
          "id": "paragraph_073",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ cuộn bản vẽ lại."
        },
        {
          "id": "paragraph_074",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi sẽ quay lại sau bảy ngày.”"
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": "III. Những bánh răng phụ thuộc",
      "blocks": [
        {
          "id": "paragraph_076",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tin Vành có thể rời đi lan khắp tầng máy."
        },
        {
          "id": "paragraph_077",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một bánh răng nhỏ tên Líp tìm đến."
        },
        {
          "id": "paragraph_078",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Líp đã quay bên cạnh Vành gần hai mươi năm. Mỗi vòng quay của Vành giúp Líp vận hành bộ đếm giờ của bệnh viện phía Tây."
        },
        {
          "id": "paragraph_079",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có thật ông định đi không?”"
        },
        {
          "id": "paragraph_080",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi chưa quyết định.”"
        },
        {
          "id": "paragraph_081",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nếu ông đi, chúng tôi sẽ làm gì?”"
        },
        {
          "id": "paragraph_082",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Họ sẽ tìm người thay thế.”"
        },
        {
          "id": "paragraph_083",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nhưng nếu không tìm được?”"
        },
        {
          "id": "paragraph_084",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành không trả lời."
        },
        {
          "id": "paragraph_085",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Líp nói tiếp:"
        },
        {
          "id": "paragraph_086",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Ông biết không, khi tôi mới được lắp vào đây, tôi thường bị lệch trục. Chính ông đã giữ cho tôi quay ổn định.”"
        },
        {
          "id": "paragraph_087",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Đó là việc của tôi.”"
        },
        {
          "id": "paragraph_088",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vậy tại sao ông muốn bỏ đi?”"
        },
        {
          "id": "paragraph_089",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn những chiếc răng của mình."
        },
        {
          "id": "paragraph_090",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vì tôi không muốn đến một ngày, khi tháp này không còn cần tôi nữa, tôi cũng không thể quay ở bất kỳ nơi nào khác.”"
        },
        {
          "id": "paragraph_091",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Líp im lặng rất lâu."
        },
        {
          "id": "paragraph_092",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi hỏi:"
        },
        {
          "id": "paragraph_093",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nhưng nếu ông đi trước ngày ấy, chẳng phải chúng tôi sẽ gặp nguy hiểm sao?”"
        },
        {
          "id": "paragraph_094",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Câu hỏi ấy khiến Vành không ngủ được suốt đêm."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": "IV. Bảy ngày",
      "blocks": [
        {
          "id": "paragraph_096",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ nhất, Vành nghĩ đến cỗ máy phía Đông."
        },
        {
          "id": "paragraph_097",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó tưởng tượng những con đập mở ra, dòng nước chảy qua những cánh đồng khô hạn."
        },
        {
          "id": "paragraph_098",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ hai, Vành nhìn những chiếc đồng hồ trên tháp phía Tây."
        },
        {
          "id": "paragraph_099",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mỗi tiếng chuông vang lên là một lần nó nhớ rằng cả thành phố vẫn đang cần mình."
        },
        {
          "id": "paragraph_100",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ ba, Vành cố luyện quay nhanh hơn."
        },
        {
          "id": "paragraph_101",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chiếc răng thứ mười bảy lại kẹt."
        },
        {
          "id": "paragraph_102",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ tư, nó nghĩ đến việc từ chối lời mời."
        },
        {
          "id": "paragraph_103",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ năm, nó nghe tin cỗ máy phía Đông đã tìm được hai bánh răng khác."
        },
        {
          "id": "paragraph_104",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cả hai đều trẻ hơn Vành."
        },
        {
          "id": "paragraph_105",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày thứ sáu, người thợ máy gửi đến một thông báo:"
        },
        {
          "id": "paragraph_106",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nếu ông không nhận lời trước bình minh ngày mai, chúng tôi sẽ chọn bánh răng khác."
        },
        {
          "id": "paragraph_107",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đêm ấy, Vành không ngừng quay."
        },
        {
          "id": "paragraph_108",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó nghĩ đến những năm tháng ở Cỗ Máy Thiên Văn."
        },
        {
          "id": "paragraph_109",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó nghĩ đến những chiếc đồng hồ đang phụ thuộc vào mình."
        },
        {
          "id": "paragraph_110",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó nghĩ đến vết gỉ trên chiếc răng thứ mười bảy."
        },
        {
          "id": "paragraph_111",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và lần đầu tiên, nó nhận ra mình sợ cả hai điều:"
        },
        {
          "id": "paragraph_112",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sợ rời đi."
        },
        {
          "id": "paragraph_113",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và sợ phải ở lại."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": "V. Chiếc răng bị gãy",
      "blocks": [
        {
          "id": "paragraph_115",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trước bình minh, Vành đưa ra quyết định."
        },
        {
          "id": "paragraph_116",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó sẽ ở lại."
        },
        {
          "id": "paragraph_117",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không phải vì không muốn đến phía Đông."
        },
        {
          "id": "paragraph_118",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mà vì nó không thể để hàng nghìn chiếc đồng hồ ngừng chạy khi chưa có bánh răng thay thế."
        },
        {
          "id": "paragraph_119",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó gửi lời từ chối."
        },
        {
          "id": "paragraph_120",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cỗ máy phía Đông chọn một bánh răng khác."
        },
        {
          "id": "paragraph_121",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Thành phố tiếp tục hoạt động."
        },
        {
          "id": "paragraph_122",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một năm trôi qua."
        },
        {
          "id": "paragraph_123",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi hai năm."
        },
        {
          "id": "paragraph_124",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một ngày, tháp phía Tây được nâng cấp."
        },
        {
          "id": "paragraph_125",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những chiếc đồng hồ cũ được thay bằng một hệ thống mới, nhỏ hơn, chính xác hơn và không cần đến bánh răng lớn như Vành."
        },
        {
          "id": "paragraph_126",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ máy đến tháo Vành khỏi trục."
        },
        {
          "id": "paragraph_127",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chúng tôi không còn cần ông ở đây nữa.”"
        },
        {
          "id": "paragraph_128",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành hỏi:"
        },
        {
          "id": "paragraph_129",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có cỗ máy nào khác cần tôi không?”"
        },
        {
          "id": "paragraph_130",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ lắc đầu."
        },
        {
          "id": "paragraph_131",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Những cỗ máy mới không còn dùng loại bánh răng này.”"
        },
        {
          "id": "paragraph_132",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Còn cỗ máy phía Đông?”"
        },
        {
          "id": "paragraph_133",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nó đã hoạt động được hai năm.”"
        },
        {
          "id": "paragraph_134",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi có thể thử không?”"
        },
        {
          "id": "paragraph_135",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ nhìn chiếc răng thứ mười bảy."
        },
        {
          "id": "paragraph_136",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có thể. Nhưng trước hết phải sửa chỗ này.”"
        },
        {
          "id": "paragraph_137",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông đặt dụng cụ vào giữa hai chiếc răng."
        },
        {
          "id": "paragraph_138",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành cố giữ thẳng."
        },
        {
          "id": "paragraph_139",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tiếng rắc vang lên."
        },
        {
          "id": "paragraph_140",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chiếc răng thứ mười bảy gãy."
        },
        {
          "id": "paragraph_141",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thợ dừng tay."
        },
        {
          "id": "paragraph_142",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn mảnh kim loại nằm trên nền đá."
        },
        {
          "id": "paragraph_143",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó đã sợ điều này suốt nhiều năm."
        },
        {
          "id": "paragraph_144",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bây giờ điều ấy thực sự xảy ra."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": "VI. Cỗ máy ngừng chạy",
      "blocks": [
        {
          "id": "paragraph_146",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành được đưa đến một kho chứa cũ bên ngoài thành phố."
        },
        {
          "id": "paragraph_147",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở đó có hàng trăm bánh răng từng vận hành những cỗ máy khác nhau."
        },
        {
          "id": "paragraph_148",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một chiếc từng điều khiển cổng thành."
        },
        {
          "id": "paragraph_149",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một chiếc từng vận hành máy bơm nước."
        },
        {
          "id": "paragraph_150",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một chiếc từng là bộ phận quan trọng nhất của chiếc đồng hồ trung tâm."
        },
        {
          "id": "paragraph_151",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tất cả đều nằm im."
        },
        {
          "id": "paragraph_152",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành hỏi một bánh răng bên cạnh:"
        },
        {
          "id": "paragraph_153",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Các ông ở đây bao lâu rồi?”"
        },
        {
          "id": "paragraph_154",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có chiếc mười năm. Có chiếc năm mươi năm.”"
        },
        {
          "id": "paragraph_155",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Không ai đến tìm sao?”"
        },
        {
          "id": "paragraph_156",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Thỉnh thoảng.”"
        },
        {
          "id": "paragraph_157",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Rồi sao?”"
        },
        {
          "id": "paragraph_158",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có chiếc được mang đi. Có chiếc lại quay về.”"
        },
        {
          "id": "paragraph_159",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn ra cửa kho."
        },
        {
          "id": "paragraph_160",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở phía xa, tháp đồng hồ phía Tây vẫn đang chạy."
        },
        {
          "id": "paragraph_161",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có nó."
        },
        {
          "id": "paragraph_162",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành từng nghĩ nếu mình rời đi, cả hệ thống sẽ ngừng hoạt động."
        },
        {
          "id": "paragraph_163",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng hệ thống vẫn tiếp tục."
        },
        {
          "id": "paragraph_164",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một buổi chiều, Tia đến thăm."
        },
        {
          "id": "paragraph_165",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chiếc bánh răng nhỏ giờ đã trở thành một phần của cỗ máy phía Đông."
        },
        {
          "id": "paragraph_166",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Ông có hối hận không?” Tia hỏi."
        },
        {
          "id": "paragraph_167",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn chiếc răng bị gãy."
        },
        {
          "id": "paragraph_168",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có.”"
        },
        {
          "id": "paragraph_169",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vì đã không đi?”"
        },
        {
          "id": "paragraph_170",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có lẽ.”"
        },
        {
          "id": "paragraph_171",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vậy ông đã chọn sai?”"
        },
        {
          "id": "paragraph_172",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành im lặng."
        },
        {
          "id": "paragraph_173",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một lúc sau, nó hỏi:"
        },
        {
          "id": "paragraph_174",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nếu ngày ấy tôi đi, liệu cậu có chắc tôi sẽ không gãy răng ngay trong bài kiểm tra đầu tiên?”"
        },
        {
          "id": "paragraph_175",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tia lắc đầu."
        },
        {
          "id": "paragraph_176",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Không.”"
        },
        {
          "id": "paragraph_177",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vậy làm sao tôi biết mình đã chọn sai?”"
        },
        {
          "id": "paragraph_178",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tia không trả lời."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": "VII. Một vòng quay khác",
      "blocks": [
        {
          "id": "paragraph_180",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều năm sau, một cậu bé học nghề đi ngang qua kho."
        },
        {
          "id": "paragraph_181",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu đang tìm một bánh răng lớn cho cỗ máy tự chế."
        },
        {
          "id": "paragraph_182",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người quản kho chỉ vào Vành."
        },
        {
          "id": "paragraph_183",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chiếc này từng rất tốt, nhưng đã gãy một răng.”"
        },
        {
          "id": "paragraph_184",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu bé quan sát Vành rất lâu."
        },
        {
          "id": "paragraph_185",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Cháu có thể lấy nó không?”"
        },
        {
          "id": "paragraph_186",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Để làm gì?”"
        },
        {
          "id": "paragraph_187",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Cháu đang chế tạo một cỗ máy nâng nước. Nó không cần quay nhanh, nhưng phải chịu lực lớn.”"
        },
        {
          "id": "paragraph_188",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người quản kho cười."
        },
        {
          "id": "paragraph_189",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Chiếc này đã cũ rồi.”"
        },
        {
          "id": "paragraph_190",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Cháu biết.”"
        },
        {
          "id": "paragraph_191",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Nó có thể gãy tiếp.”"
        },
        {
          "id": "paragraph_192",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Cháu cũng biết.”"
        },
        {
          "id": "paragraph_193",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vậy sao không chọn chiếc mới?”"
        },
        {
          "id": "paragraph_194",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu bé nhìn những chiếc bánh răng nhỏ trong giỏ."
        },
        {
          "id": "paragraph_195",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vì những chiếc mới cháu có đều quá yếu.”"
        },
        {
          "id": "paragraph_196",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành được đưa đến một xưởng nhỏ bên bờ sông."
        },
        {
          "id": "paragraph_197",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu bé sửa lại chiếc răng bị gãy, thay trục và lắp Vành vào cỗ máy."
        },
        {
          "id": "paragraph_198",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần thử đầu tiên thất bại."
        },
        {
          "id": "paragraph_199",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần thứ hai, trục máy bị lệch."
        },
        {
          "id": "paragraph_200",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần thứ ba, nước bắt đầu chảy."
        },
        {
          "id": "paragraph_201",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành quay chậm."
        },
        {
          "id": "paragraph_202",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rất chậm."
        },
        {
          "id": "paragraph_203",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng lần này, mỗi vòng quay nâng được một thùng nước từ lòng sông lên khu vườn trên đồi."
        },
        {
          "id": "paragraph_204",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có tiếng chuông lớn."
        },
        {
          "id": "paragraph_205",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có hàng nghìn chiếc đồng hồ phụ thuộc vào nó."
        },
        {
          "id": "paragraph_206",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cũng không có những con tàu hay cỗ máy thiên văn."
        },
        {
          "id": "paragraph_207",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chỉ có một khu vườn nhỏ, một cậu bé và dòng nước chảy đều qua những luống cây."
        },
        {
          "id": "paragraph_208",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một buổi chiều, Tia ghé thăm."
        },
        {
          "id": "paragraph_209",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Ông có vui không?”"
        },
        {
          "id": "paragraph_210",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn dòng nước."
        },
        {
          "id": "paragraph_211",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Tôi không biết.”"
        },
        {
          "id": "paragraph_212",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Ông vẫn muốn quay ở cỗ máy phía Đông chứ?”"
        },
        {
          "id": "paragraph_213",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có những lúc.”"
        },
        {
          "id": "paragraph_214",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vậy ông vẫn chưa hài lòng?”"
        },
        {
          "id": "paragraph_215",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành suy nghĩ."
        },
        {
          "id": "paragraph_216",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi đáp:"
        },
        {
          "id": "paragraph_217",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Có lẽ.”"
        },
        {
          "id": "paragraph_218",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tia ngạc nhiên."
        },
        {
          "id": "paragraph_219",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Thế tại sao ông vẫn quay?”"
        },
        {
          "id": "paragraph_220",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Vành nhìn cậu bé đang cố sửa một chiếc trục bị lệch."
        },
        {
          "id": "paragraph_221",
          "type": "paragraph",
          "style": "dialogue",
          "text_vi": "“Vì hôm nay, cỗ máy này vẫn còn một việc cần tôi làm.”"
        },
        {
          "id": "paragraph_222",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngoài kia, thành phố của những chiếc đồng hồ vẫn tiếp tục chạy."
        },
        {
          "id": "paragraph_223",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có những bánh răng mới được lắp vào."
        },
        {
          "id": "paragraph_224",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có những bánh răng cũ bị tháo ra."
        },
        {
          "id": "paragraph_225",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có những cỗ máy được xây dựng."
        },
        {
          "id": "paragraph_226",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và có những cỗ máy không bao giờ hoàn thành."
        },
        {
          "id": "paragraph_227",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không ai biết chiếc bánh răng nào đã chọn đúng con đường."
        }
      ]
    }
