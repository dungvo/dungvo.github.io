{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_chair_beside_window",
  "revision": 2,
  "status": "draft",
  "language": "vi",
  "title_vi": "Chiếc ghế cạnh cửa sổ — Bản gốc",
  "subtitle_vi": "Công ty chỉ là một phần của ngày sống, không phải toàn bộ cuộc đời mình.",
  "hero_image": null,
  "primary_theme": "rest_wellbeing",
  "metadata": {
    "concept_ids": [
      "concept.psychological_detachment"
    ],
    "emotion_tags": [
      "frustration",
      "exhaustion"
    ],
    "keywords": [
      "tan làm",
      "ranh giới công việc",
      "buổi tối",
      "chiếc ghế cửa sổ"
    ],
    "story_style": "contemporary"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": "Lời dẫn",
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Tôi kể bạn một câu chuyện dài hơn một chút. Nó không phải câu chuyện về một công ty hoàn hảo. Ngược lại, nó là về một nơi có sếp khó chịu, đồng nghiệp không phải lúc nào cũng dễ thương, công việc nhiều lúc vô nghĩa — nhưng một người dần nhận ra rằng công ty chỉ là một phần của ngày sống, không phải toàn bộ cuộc đời mình."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "Câu chuyện",
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Có một người đàn ông tên Nam."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Nam 42 tuổi."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "Anh đã đi làm gần hai mươi năm."
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "Ngày còn trẻ, mỗi lần đổi công ty anh đều có cảm giác rất khác."
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "text_vi": "Ngày đầu tiên mặc áo sơ mi mới."
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "Laptop mới."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "Những khuôn mặt mới."
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "Anh nghĩ:"
        },
        {
          "id": "section_02.block_09",
          "type": "pull_quote",
          "text_vi": "“Có lẽ ở đây mình sẽ làm được những thứ thật hay.”",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "Nhưng nhiều năm trôi qua, cảm giác ấy nhạt dần."
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "Công ty nào rồi cũng xuất hiện những thứ giống nhau."
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "Một người sếp nói chuyện làm anh khó chịu."
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "Một đồng nghiệp thích đẩy trách nhiệm."
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "Một cuộc họp kéo dài một tiếng mà Nam nghĩ chỉ cần một email."
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "text_vi": "Một dự án được gọi là “urgent”, rồi vài tuần sau chẳng ai nhắc tới."
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "text_vi": "Và những yêu cầu kiểu:"
        },
        {
          "id": "section_02.block_17",
          "type": "paragraph",
          "text_vi": "“Nam làm giúp cái này nhé.”"
        },
        {
          "id": "section_02.block_18",
          "type": "paragraph",
          "text_vi": "“Cần khi nào?”"
        },
        {
          "id": "section_02.block_19",
          "type": "paragraph",
          "text_vi": "“Càng sớm càng tốt.”"
        },
        {
          "id": "section_02.block_20",
          "type": "paragraph",
          "text_vi": "“Yêu cầu cụ thể là gì?”"
        },
        {
          "id": "section_02.block_21",
          "type": "paragraph",
          "text_vi": "“Em cứ draft trước đi rồi mình xem.”"
        },
        {
          "id": "section_02.block_22",
          "type": "paragraph",
          "text_vi": "Nam ghét nhất câu đó."
        },
        {
          "id": "section_02.block_23",
          "type": "pull_quote",
          "text_vi": "“Cứ draft trước đi.”",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_24",
          "type": "paragraph",
          "text_vi": "Draft cái gì khi chẳng ai biết mình muốn gì?"
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Một buổi chiều, Nam nhận một yêu cầu như vậy."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Thứ Hai phải trình bày."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "Nhưng người yêu cầu không đưa đủ thông tin."
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Nam nhắn hỏi."
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "text_vi": "Không ai trả lời."
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "Anh ngồi trước màn hình, càng nghĩ càng bực."
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "Anh không chỉ bực vì công việc."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "Anh bắt đầu nghĩ:"
        },
        {
          "id": "section_03.block_09",
          "type": "pull_quote",
          "text_vi": "“Mình đã hơn 40 rồi mà vẫn phải chịu những chuyện thế này sao?”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Rồi từ một cái slide, đầu óc anh đi rất xa."
        },
        {
          "id": "section_03.block_11",
          "type": "pull_quote",
          "text_vi": "“Mình còn phải làm công ty bao nhiêu năm nữa?”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_12",
          "type": "pull_quote",
          "text_vi": "“Nếu nghỉ thì lấy gì sống?”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_13",
          "type": "pull_quote",
          "text_vi": "“Nếu chuyển chỗ khác rồi cũng thế thì sao?”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_14",
          "type": "pull_quote",
          "text_vi": "“Chẳng lẽ cuộc đời cứ sáng đi làm, chiều về, rồi già đi?”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_15",
          "type": "paragraph",
          "text_vi": "Một cái PowerPoint nhỏ bé bỗng biến thành câu hỏi về cả cuộc đời."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "text_vi": "6 giờ tối."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "text_vi": "Văn phòng gần như hết người."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "text_vi": "Nam đóng laptop."
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "text_vi": "Anh không muốn về ngay."
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "text_vi": "Anh đi xuống dưới tòa nhà và ngồi trên một chiếc ghế cạnh cửa sổ của quán cà phê."
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "text_vi": "Ngoài đường, trời vừa mưa."
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "text_vi": "Anh nhìn những chiếc xe chạy qua."
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "text_vi": "Có một cô nhân viên vệ sinh đang lau sàn."
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "text_vi": "Cô khoảng ngoài năm mươi."
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "text_vi": "Nam thường gặp cô nhưng chưa bao giờ nói chuyện."
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "text_vi": "Hôm đó cô nhìn Nam rồi hỏi:"
        },
        {
          "id": "section_04.block_12",
          "type": "paragraph",
          "text_vi": "“Anh chưa về à?”"
        },
        {
          "id": "section_04.block_13",
          "type": "paragraph",
          "text_vi": "Nam cười:"
        },
        {
          "id": "section_04.block_14",
          "type": "paragraph",
          "text_vi": "“Công việc hơi mệt cô ạ.”"
        },
        {
          "id": "section_04.block_15",
          "type": "paragraph",
          "text_vi": "Cô cũng cười."
        },
        {
          "id": "section_04.block_16",
          "type": "paragraph",
          "text_vi": "“Đi làm mà. Có ngày vui, có ngày muốn nghỉ luôn.”"
        },
        {
          "id": "section_04.block_17",
          "type": "paragraph",
          "text_vi": "Nam bật cười."
        },
        {
          "id": "section_04.block_18",
          "type": "paragraph",
          "text_vi": "Không ngờ câu đó lại đến từ cô."
        },
        {
          "id": "section_04.block_19",
          "type": "paragraph",
          "text_vi": "Anh hỏi:"
        },
        {
          "id": "section_04.block_20",
          "type": "paragraph",
          "text_vi": "“Cô làm ở đây lâu chưa?”"
        },
        {
          "id": "section_04.block_21",
          "type": "paragraph",
          "text_vi": "“Mười một năm.”"
        },
        {
          "id": "section_04.block_22",
          "type": "paragraph",
          "text_vi": "Nam ngạc nhiên."
        },
        {
          "id": "section_04.block_23",
          "type": "paragraph",
          "text_vi": "“Cô không chán sao?”"
        },
        {
          "id": "section_04.block_24",
          "type": "paragraph",
          "text_vi": "“Chán chứ.”"
        },
        {
          "id": "section_04.block_25",
          "type": "paragraph",
          "text_vi": "Cô tiếp tục lau sàn."
        },
        {
          "id": "section_04.block_26",
          "type": "paragraph",
          "text_vi": "“Có người dễ thương. Có người coi mình như không tồn tại. Có hôm người ta vừa ăn xong để nguyên một đống cho mình dọn. Có hôm đang lau còn bước thẳng qua.”"
        },
        {
          "id": "section_04.block_27",
          "type": "paragraph",
          "text_vi": "Nam hỏi:"
        },
        {
          "id": "section_04.block_28",
          "type": "paragraph",
          "text_vi": "“Vậy sao cô chịu được mười một năm?”"
        },
        {
          "id": "section_04.block_29",
          "type": "paragraph",
          "text_vi": "Cô dừng cây lau nhà."
        },
        {
          "id": "section_04.block_30",
          "type": "paragraph",
          "text_vi": "Cô suy nghĩ một lúc."
        },
        {
          "id": "section_04.block_31",
          "type": "paragraph",
          "text_vi": "Rồi nói:"
        },
        {
          "id": "section_04.block_32",
          "type": "pull_quote",
          "text_vi": "“Vì tôi đâu có làm ở đây cả ngày.”",
          "attribution_vi": null
        },
        {
          "id": "section_04.block_33",
          "type": "paragraph",
          "text_vi": "Nam nhìn đồng hồ."
        },
        {
          "id": "section_04.block_34",
          "type": "paragraph",
          "text_vi": "“Cô làm tám tiếng mà?”"
        },
        {
          "id": "section_04.block_35",
          "type": "paragraph",
          "text_vi": "Cô cười."
        },
        {
          "id": "section_04.block_36",
          "type": "pull_quote",
          "text_vi": "“Ý tôi không phải vậy.”",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "text_vi": "Cô chỉ ra ngoài cửa kính."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "text_vi": "“Buổi sáng trước khi đến đây, tôi mua bánh mì cho chồng.”"
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "text_vi": "“Trưa tôi gọi điện hỏi cháu ngoại ăn cơm chưa.”"
        },
        {
          "id": "section_05.block_04",
          "type": "paragraph",
          "text_vi": "“Chiều làm xong tôi về tưới mấy chậu cây.”"
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "text_vi": "“Tối thứ Tư tôi đi tập thể dục với mấy bà trong xóm.”"
        },
        {
          "id": "section_05.block_06",
          "type": "paragraph",
          "text_vi": "“Chủ nhật tôi nấu bún riêu.”"
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "text_vi": "Rồi cô nói một câu Nam nhớ rất lâu:"
        },
        {
          "id": "section_05.block_08",
          "type": "pull_quote",
          "text_vi": "“Nếu tôi để một người làm tôi khó chịu lúc 2 giờ chiều lấy luôn cả buổi tối của tôi, vậy là tôi cho người đó nhiều quá.”",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "text_vi": "Nam im lặng."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "text_vi": "Cô tiếp tục lau."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "text_vi": "Nam vẫn ngồi đó."
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "text_vi": "Anh chợt nhận ra một điều hơi buồn cười."
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "text_vi": "Người requester đã gửi cho anh một tin nhắn lúc 3 giờ 17 phút."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "text_vi": "Người đó có lẽ đã về nhà."
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "text_vi": "Có thể đang ăn tối."
        },
        {
          "id": "section_06.block_07",
          "type": "paragraph",
          "text_vi": "Có thể đang xem điện thoại."
        },
        {
          "id": "section_06.block_08",
          "type": "paragraph",
          "text_vi": "Có thể đã quên luôn cái slide."
        },
        {
          "id": "section_06.block_09",
          "type": "paragraph",
          "text_vi": "Nhưng 6 giờ 30, Nam vẫn đang tiếp tục cuộc họp với người đó trong đầu mình."
        },
        {
          "id": "section_06.block_10",
          "type": "paragraph",
          "text_vi": "Không cần người kia có mặt."
        },
        {
          "id": "section_06.block_11",
          "type": "paragraph",
          "text_vi": "Nam tự đóng cả hai vai."
        },
        {
          "id": "section_06.block_12",
          "type": "paragraph",
          "text_vi": "“Tại sao yêu cầu không rõ?”"
        },
        {
          "id": "section_06.block_13",
          "type": "paragraph",
          "text_vi": "“Deadline thế này sao làm?”"
        },
        {
          "id": "section_06.block_14",
          "type": "paragraph",
          "text_vi": "“Nếu thứ Hai họ lại thay đổi thì sao?”"
        },
        {
          "id": "section_06.block_15",
          "type": "paragraph",
          "text_vi": "Anh tự hỏi."
        },
        {
          "id": "section_06.block_16",
          "type": "paragraph",
          "text_vi": "Rồi tự trả lời."
        },
        {
          "id": "section_06.block_17",
          "type": "paragraph",
          "text_vi": "Rồi tự tức."
        },
        {
          "id": "section_06.block_18",
          "type": "paragraph",
          "text_vi": "Một cuộc họp không có thật."
        },
        {
          "id": "section_06.block_19",
          "type": "paragraph",
          "text_vi": "Và kỳ lạ nhất là chỉ có Nam tham dự."
        },
        {
          "id": "section_06.block_20",
          "type": "paragraph",
          "text_vi": "Anh bật cười."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "text_vi": "Trước khi cô lao công đi, Nam hỏi:"
        },
        {
          "id": "section_07.block_02",
          "type": "paragraph",
          "text_vi": "“Nhưng nếu ngày mai lại gặp chuyện khó chịu thì sao cô?”"
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "text_vi": "Cô nói:"
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "text_vi": "“Thì ngày mai khó chịu tiếp.”"
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "text_vi": "Nam cười."
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "text_vi": "Cô cũng cười."
        },
        {
          "id": "section_07.block_07",
          "type": "paragraph",
          "text_vi": "Rồi cô nói thêm:"
        },
        {
          "id": "section_07.block_08",
          "type": "pull_quote",
          "text_vi": "“Nhưng hôm nay hết giờ rồi.”",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_08",
      "title_vi": "Sáng hôm sau",
      "blocks": [
        {
          "id": "section_08.block_01",
          "type": "paragraph",
          "text_vi": "Nam đến công ty."
        },
        {
          "id": "section_08.block_02",
          "type": "paragraph",
          "text_vi": "Requester vẫn chưa trả lời."
        },
        {
          "id": "section_08.block_03",
          "type": "paragraph",
          "text_vi": "Nhưng lần này Nam không ngồi nhìn màn hình và tức."
        },
        {
          "id": "section_08.block_04",
          "type": "paragraph",
          "text_vi": "Anh mở slide."
        },
        {
          "id": "section_08.block_05",
          "type": "paragraph",
          "text_vi": "Trang đầu tiên anh viết:"
        },
        {
          "id": "section_08.block_06",
          "type": "pull_quote",
          "text_vi": "Draft — Based on current understanding",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_07",
          "type": "paragraph",
          "text_vi": "Anh làm những gì mình biết."
        },
        {
          "id": "section_08.block_08",
          "type": "paragraph",
          "text_vi": "Những chỗ không biết, anh viết:"
        },
        {
          "id": "section_08.block_09",
          "type": "pull_quote",
          "text_vi": "Assumption",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_10",
          "type": "paragraph",
          "text_vi": "Những chỗ cần xác nhận:"
        },
        {
          "id": "section_08.block_11",
          "type": "pull_quote",
          "text_vi": "To be confirmed",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_12",
          "type": "paragraph",
          "text_vi": "11 giờ, sếp đi ngang qua."
        },
        {
          "id": "section_08.block_13",
          "type": "paragraph",
          "text_vi": "“Nam, cái deck hôm qua sao rồi?”"
        },
        {
          "id": "section_08.block_14",
          "type": "paragraph",
          "text_vi": "Ngày trước Nam có thể nghĩ:"
        },
        {
          "id": "section_08.block_15",
          "type": "paragraph",
          "text_vi": "Lại nữa."
        },
        {
          "id": "section_08.block_16",
          "type": "paragraph",
          "text_vi": "Nhưng hôm đó anh chỉ nói:"
        },
        {
          "id": "section_08.block_17",
          "type": "paragraph",
          "text_vi": "“Em có skeleton rồi. Có ba assumptions em cần confirm trước khi hoàn thiện.”"
        },
        {
          "id": "section_08.block_18",
          "type": "paragraph",
          "text_vi": "Sếp nhìn qua."
        },
        {
          "id": "section_08.block_19",
          "type": "paragraph",
          "text_vi": "“OK, chiều trao đổi.”"
        },
        {
          "id": "section_08.block_20",
          "type": "paragraph",
          "text_vi": "Hết."
        },
        {
          "id": "section_08.block_21",
          "type": "paragraph",
          "text_vi": "Cuộc nói chuyện mà Nam đã diễn tập hàng chục lần trong đầu tối hôm trước..."
        },
        {
          "id": "section_08.block_22",
          "type": "paragraph",
          "text_vi": "...thực tế kéo dài chưa đến một phút."
        }
      ]
    },
    {
      "id": "section_09",
      "title_vi": "Rồi một chuyện khác xảy ra",
      "blocks": [
        {
          "id": "section_09.block_01",
          "type": "paragraph",
          "text_vi": "Vài tháng sau, Nam mắc một lỗi."
        },
        {
          "id": "section_09.block_02",
          "type": "paragraph",
          "text_vi": "Không nghiêm trọng, nhưng trong cuộc họp, một đồng nghiệp nói:"
        },
        {
          "id": "section_09.block_03",
          "type": "paragraph",
          "text_vi": "“Cái này hôm trước tôi đã nói với Nam rồi.”"
        },
        {
          "id": "section_09.block_04",
          "type": "paragraph",
          "text_vi": "Nam biết câu đó không hoàn toàn đúng."
        },
        {
          "id": "section_09.block_05",
          "type": "paragraph",
          "text_vi": "Anh nóng mặt."
        },
        {
          "id": "section_09.block_06",
          "type": "paragraph",
          "text_vi": "Anh rất muốn phản bác ngay."
        },
        {
          "id": "section_09.block_07",
          "type": "paragraph",
          "text_vi": "Nhưng đúng lúc đó, anh nhớ đến cô lao công."
        },
        {
          "id": "section_09.block_08",
          "type": "pull_quote",
          "text_vi": "Đừng mang quá nhiều thứ không thuộc về mình.",
          "attribution_vi": null
        },
        {
          "id": "section_09.block_09",
          "type": "paragraph",
          "text_vi": "Nam lấy giấy viết:"
        },
        {
          "id": "section_09.block_10",
          "type": "paragraph",
          "text_vi": "Fact: Có issue."
        },
        {
          "id": "section_09.block_11",
          "type": "paragraph",
          "text_vi": "My part: Tôi có một phần trách nhiệm."
        },
        {
          "id": "section_09.block_12",
          "type": "paragraph",
          "text_vi": "Not my part: Cách người kia cố bảo vệ mình trước mọi người."
        },
        {
          "id": "section_09.block_13",
          "type": "paragraph",
          "text_vi": "Anh giải quyết phần đầu."
        },
        {
          "id": "section_09.block_14",
          "type": "paragraph",
          "text_vi": "Phần thứ hai, anh để lại."
        },
        {
          "id": "section_09.block_15",
          "type": "paragraph",
          "text_vi": "Buổi tối hôm ấy Nam vẫn ăn cơm bình thường."
        }
      ]
    },
    {
      "id": "section_10",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_10.block_01",
          "type": "paragraph",
          "text_vi": "Một thời gian sau nữa, Nam bị sếp phê bình."
        },
        {
          "id": "section_10.block_02",
          "type": "paragraph",
          "text_vi": "Lần này sếp đúng."
        },
        {
          "id": "section_10.block_03",
          "type": "paragraph",
          "text_vi": "Nam buồn."
        },
        {
          "id": "section_10.block_04",
          "type": "paragraph",
          "text_vi": "Anh đi xuống quán cà phê tìm cô lao công."
        },
        {
          "id": "section_10.block_05",
          "type": "paragraph",
          "text_vi": "Nhưng hôm đó không thấy cô."
        },
        {
          "id": "section_10.block_06",
          "type": "paragraph",
          "text_vi": "Ngày hôm sau cũng không."
        },
        {
          "id": "section_10.block_07",
          "type": "paragraph",
          "text_vi": "Nam hỏi nhân viên quán."
        },
        {
          "id": "section_10.block_08",
          "type": "paragraph",
          "text_vi": "“Cô nghỉ rồi anh. Về quê chăm cháu.”"
        },
        {
          "id": "section_10.block_09",
          "type": "paragraph",
          "text_vi": "Nam hơi hụt hẫng."
        },
        {
          "id": "section_10.block_10",
          "type": "paragraph",
          "text_vi": "Anh thậm chí còn không biết tên cô."
        }
      ]
    },
    {
      "id": "section_11",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_11.block_01",
          "type": "paragraph",
          "text_vi": "Vài tuần sau, Nam lại ngồi chiếc ghế cạnh cửa sổ."
        },
        {
          "id": "section_11.block_02",
          "type": "paragraph",
          "text_vi": "Ngoài kia rất nhiều người đang về nhà."
        },
        {
          "id": "section_11.block_03",
          "type": "paragraph",
          "text_vi": "Một anh shipper."
        },
        {
          "id": "section_11.block_04",
          "type": "paragraph",
          "text_vi": "Một cô nhân viên ngân hàng."
        },
        {
          "id": "section_11.block_05",
          "type": "paragraph",
          "text_vi": "Một người bán vé số."
        },
        {
          "id": "section_11.block_06",
          "type": "paragraph",
          "text_vi": "Một cậu sinh viên."
        },
        {
          "id": "section_11.block_07",
          "type": "paragraph",
          "text_vi": "Một người đàn ông mặc vest đang gọi điện với vẻ rất căng thẳng."
        },
        {
          "id": "section_11.block_08",
          "type": "paragraph",
          "text_vi": "Nam chợt nghĩ:"
        },
        {
          "id": "section_11.block_09",
          "type": "pull_quote",
          "text_vi": "Mỗi người trên con đường này có lẽ đều đang mang một thứ gì đó.",
          "attribution_vi": null
        },
        {
          "id": "section_11.block_10",
          "type": "paragraph",
          "text_vi": "Một deadline."
        },
        {
          "id": "section_11.block_11",
          "type": "paragraph",
          "text_vi": "Một khoản vay."
        },
        {
          "id": "section_11.block_12",
          "type": "paragraph",
          "text_vi": "Một người sếp."
        },
        {
          "id": "section_11.block_13",
          "type": "paragraph",
          "text_vi": "Một cuộc cãi nhau."
        },
        {
          "id": "section_11.block_14",
          "type": "paragraph",
          "text_vi": "Một đứa con đang bệnh."
        },
        {
          "id": "section_11.block_15",
          "type": "paragraph",
          "text_vi": "Một cuộc phỏng vấn thất bại."
        },
        {
          "id": "section_11.block_16",
          "type": "paragraph",
          "text_vi": "Một giấc mơ chưa làm được."
        },
        {
          "id": "section_11.block_17",
          "type": "paragraph",
          "text_vi": "Có lẽ người requester khiến Nam khó chịu hôm trước cũng đang mang một thứ gì đó."
        },
        {
          "id": "section_11.block_18",
          "type": "paragraph",
          "text_vi": "Điều đó không có nghĩa Nam phải chấp nhận mọi cách cư xử."
        },
        {
          "id": "section_11.block_19",
          "type": "paragraph",
          "text_vi": "Nhưng tự nhiên anh thấy người đó bớt đáng ghét hơn một chút."
        },
        {
          "id": "section_11.block_20",
          "type": "paragraph",
          "text_vi": "Chỉ là một con người đang xoay xở với cuộc đời của họ."
        },
        {
          "id": "section_11.block_21",
          "type": "paragraph",
          "text_vi": "Giống anh."
        }
      ]
    },
    {
      "id": "section_12",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_12.block_01",
          "type": "paragraph",
          "text_vi": "Nam nhìn đồng hồ."
        },
        {
          "id": "section_12.block_02",
          "type": "paragraph",
          "text_vi": "17:42."
        },
        {
          "id": "section_12.block_03",
          "type": "paragraph",
          "text_vi": "Anh đóng laptop."
        },
        {
          "id": "section_12.block_04",
          "type": "paragraph",
          "text_vi": "Ngày hôm đó vẫn còn một issue chưa giải quyết."
        },
        {
          "id": "section_12.block_05",
          "type": "paragraph",
          "text_vi": "Một email chưa trả lời."
        },
        {
          "id": "section_12.block_06",
          "type": "paragraph",
          "text_vi": "Một architecture chưa hoàn chỉnh."
        },
        {
          "id": "section_12.block_07",
          "type": "paragraph",
          "text_vi": "Một cuộc họp ngày mai anh không thích."
        },
        {
          "id": "section_12.block_08",
          "type": "paragraph",
          "text_vi": "Không sao."
        },
        {
          "id": "section_12.block_09",
          "type": "pull_quote",
          "text_vi": "Ngày mai Nam sẽ quay lại làm tiếp.",
          "attribution_vi": null
        },
        {
          "id": "section_12.block_10",
          "type": "paragraph",
          "text_vi": "Bởi vì một điều chưa hoàn thành ở công ty không có nghĩa là một ngày sống chưa hoàn thành."
        },
        {
          "id": "section_12.block_11",
          "type": "paragraph",
          "text_vi": "Anh bước ra khỏi tòa nhà."
        },
        {
          "id": "section_12.block_12",
          "type": "paragraph",
          "text_vi": "Điện thoại rung."
        },
        {
          "id": "section_12.block_13",
          "type": "paragraph",
          "text_vi": "Nam lấy ra xem."
        },
        {
          "id": "section_12.block_14",
          "type": "paragraph",
          "text_vi": "Con gái nhắn:"
        },
        {
          "id": "section_12.block_15",
          "type": "pull_quote",
          "text_vi": "“Ba về chưa?”",
          "attribution_vi": null
        },
        {
          "id": "section_12.block_16",
          "type": "paragraph",
          "text_vi": "Nam gõ:"
        },
        {
          "id": "section_12.block_17",
          "type": "pull_quote",
          "text_vi": "“Ba đang về.”",
          "attribution_vi": null
        },
        {
          "id": "section_12.block_18",
          "type": "paragraph",
          "text_vi": "Rồi cất điện thoại vào túi."
        },
        {
          "id": "section_12.block_19",
          "type": "paragraph",
          "text_vi": "Trên đường về anh mua một ổ bánh mì."
        },
        {
          "id": "section_12.block_20",
          "type": "paragraph",
          "text_vi": "Trời Sài Gòn sau cơn mưa khá mát."
        },
        {
          "id": "section_12.block_21",
          "type": "paragraph",
          "text_vi": "Anh chợt nhớ câu nói năm nào:"
        },
        {
          "id": "section_12.block_22",
          "type": "pull_quote",
          "text_vi": "“Nếu tôi để một người làm tôi khó chịu lúc 2 giờ chiều lấy luôn cả buổi tối của tôi, vậy là tôi cho người đó nhiều quá.”",
          "attribution_vi": null
        },
        {
          "id": "section_12.block_23",
          "type": "paragraph",
          "text_vi": "Nam mỉm cười."
        },
        {
          "id": "section_12.block_24",
          "type": "paragraph",
          "text_vi": "Công việc ngày hôm đó không tốt hơn."
        },
        {
          "id": "section_12.block_25",
          "type": "paragraph",
          "text_vi": "Sếp cũng chưa thay đổi."
        },
        {
          "id": "section_12.block_26",
          "type": "paragraph",
          "text_vi": "Đồng nghiệp cũng vậy."
        },
        {
          "id": "section_12.block_27",
          "type": "paragraph",
          "text_vi": "Ngày mai có lẽ vẫn có những request mơ hồ."
        },
        {
          "id": "section_12.block_28",
          "type": "paragraph",
          "text_vi": "Nhưng có một thứ đã thay đổi:"
        },
        {
          "id": "section_12.block_29",
          "type": "pull_quote",
          "text_vi": "Nam lấy lại được buổi tối của mình.",
          "attribution_vi": null
        },
        {
          "id": "section_12.block_30",
          "type": "paragraph",
          "text_vi": "Và đôi khi, vượt qua một môi trường không vui không bắt đầu bằng việc thay đổi cả công ty."
        },
        {
          "id": "section_12.block_31",
          "type": "paragraph",
          "text_vi": "Nó bắt đầu bằng một việc nhỏ hơn rất nhiều:"
        },
        {
          "id": "section_12.block_32",
          "type": "pull_quote",
          "text_vi": "Không cho công ty thuê miễn phí căn phòng trong đầu mình sau giờ làm.",
          "attribution_vi": null
        }
      ]
    }
  ],
  "takeaway": {
    "title_vi": "Điều còn lại",
    "text_vi": "Không cho công ty thuê miễn phí căn phòng trong đầu mình sau giờ làm."
  },
