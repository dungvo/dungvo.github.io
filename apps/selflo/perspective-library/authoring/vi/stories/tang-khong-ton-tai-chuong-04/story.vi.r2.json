  "sections": [
    {
      "id": "chapter_04",
      "marker_vi": "4",
      "marker_unit_vi": "chương",
      "title_vi": "Chương 4 - Những Thứ Không Xuất Hiện Trong Dữ Liệu",
      "subtitle_vi": null,
      "blocks": [
        {
          "id": "source_001",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đêm đó, Minh bắt đầu kiểm tra lại mọi thứ."
        },
        {
          "id": "source_002",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không phải bằng cảm giác.\nMà bằng dữ liệu.\nNếu có điều gì thật sự tồn tại trong thành phố này, nó phải để lại dấu vết ở đâu đó."
        },
        {
          "id": "source_003",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Camera giao thông.\nVệ tinh dân sự.\nDữ liệu drone.\nLog hệ thống quảng cáo ngoài trời."
        },
        {
          "id": "source_004",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một thứ lớn như vậy không thể xuất hiện mà không để lại dấu vết."
        },
        {
          "id": "source_005",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh tin điều đó.\nAnh cần tin điều đó."
        },
        {
          "id": "source_006",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Căn hộ của Minh nằm ở tầng 27, trong một khu chung cư nhìn thẳng ra trung tâm thành phố. \nBan đêm, ánh sáng từ các bản điện tử phản chiếu lên trần nhà như những cơn sóng màu không bao giờ ngủ."
        },
        {
          "id": "source_007",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Màn hình laptop phủ kín những ô dữ liệu đang liên tục cập nhật."
        },
        {
          "id": "source_008",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh dùng account nội bộ để truy cập vào hệ thống dữ liệu thời gian thực của thành phố mà công ty từng tích hợp cho dự án phân tích hành vi giao thông."
        },
        {
          "id": "source_009",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một phần dữ liệu đến từ camera thành phố.\nMột phần đến từ hệ thống drone giao hàng.\nMột phần từ hệ thống quảng cáo thông minh."
        },
        {
          "id": "source_010",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mọi thứ đều được ghi lại.\nMọi thứ đều được phân loại.\nThành phố này có thể quên con người, nhưng nó không bao giờ quên dữ liệu."
        },
        {
          "id": "source_011",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nhập thời điểm khuôn mặt xuất hiện.\nKhung hình hiện ra."
        },
        {
          "id": "source_012",
          "type": "list",
          "style": "unordered",
          "items": [
            {
              "text_vi": "Ngã tư."
            },
            {
              "text_vi": "Dòng người."
            },
            {
              "text_vi": "Xe cộ."
            }
          ]
        },
        {
          "id": "source_013",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có khuôn mặt khổng lồ."
        },
        {
          "id": "source_014",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh chuyển sang nguồn drone.\nKhông có gì."
        },
        {
          "id": "source_015",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ảnh chụp vệ tinh.\nKhông có gì."
        },
        {
          "id": "source_016",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh ngồi im vài giây.\nRồi anh bắt đầu tìm kiếm bằng từ khoá."
        },
        {
          "id": "source_017",
          "type": "list",
          "style": "unordered",
          "items": [
            {
              "text_vi": "“sai lệch hình ảnh”"
            },
            {
              "text_vi": "“lỗi bảng quảng cáo điện tử”"
            },
            {
              "text_vi": "“nhiễu dữ liệu camera”"
            },
            {
              "text_vi": "“tín hiệu trình chiếu trái phép”"
            }
          ]
        },
        {
          "id": "source_018",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có kết quả."
        },
        {
          "id": "source_019",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đổi hướng.\nTìm các dấu hiệu bất thường trong luồng dữ liệu của thành phố."
        },
        {
          "id": "source_020",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần này, hệ thống trả về một khoảng nhiễu dữ liệu kéo dài đúng 1.3 giây vào thời điểm khuôn mặt khổng lồ xuất hiện.\nMinh nhíu mày."
        },
        {
          "id": "source_021",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trong đúng một giây, toàn bộ camera quanh khu vực trung tâm cùng lúc mất rồi khôi phục hình ảnh.\nĐiều đó gần như không thể."
        },
        {
          "id": "source_022",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Các camera trong thành phố không bao giờ được cập nhật cùng lúc tuyệt đối."
        },
        {
          "id": "source_023",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trừ khi…\nCó thứ gì đó đã ép toàn hệ thống đồng bộ."
        },
        {
          "id": "source_024",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh mở phần dữ liệu chi tiết.\nMàn hình đứng yên vài giây."
        },
        {
          "id": "source_025",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi hiện lên:\n“ACCESS DENIED!\nCitizen-Level Clearance Required”"
        },
        {
          "id": "source_026",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh khựng lại.\n“QUYỀN CÔNG DÂN CẤP CAO?”"
        },
        {
          "id": "source_027",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh chưa từng thấy cấp truy cập nào như vậy.\nTrong hệ thống của thành phố chỉ tồn tại vài mức quyền cơ bản:"
        },
        {
          "id": "source_028",
          "type": "list",
          "style": "unordered",
          "items": [
            {
              "text_vi": "PUBLIC"
            },
            {
              "text_vi": "INTERNAL"
            },
            {
              "text_vi": "GOVERNMENT"
            },
            {
              "text_vi": "RESTRICTED"
            }
          ]
        },
        {
          "id": "source_029",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không có “Citizen-Level”."
        },
        {
          "id": "source_030",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh mở thông tin hệ thống."
        },
        {
          "id": "source_031",
          "type": "list",
          "style": "unordered",
          "items": [
            {
              "text_vi": "Không có ngày tạo."
            },
            {
              "text_vi": "Không có người tạo."
            },
            {
              "text_vi": "Không có lịch sử chỉnh sửa."
            }
          ]
        },
        {
          "id": "source_032",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Giống như quyền truy cập này chưa từng được tạo ra bởi con người."
        },
        {
          "id": "source_033",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cảm giác lạnh chạy dọc sống lưng anh."
        },
        {
          "id": "source_034",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đúng lúc đó, tất cả đèn trong căn hộ tắt phụt.\nMàn hình laptop chuyển sang nguồn pin dự phòng."
        },
        {
          "id": "source_035",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngoài cửa kính, toàn bộ thành phố vẫn sáng.\nChỉ căn hộ của Minh mất điện."
        },
        {
          "id": "source_036",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đứng bật dậy.\nMột giây sau, điện thoại rung.\nMàn hình sáng lên giữa bóng tối.\nKhông có số gửi.\nChỉ một dòng text trắng trên nền đen:"
        },
        {
          "id": "source_037",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“ĐỪNG NHÌN LÊN QUÁ LÂU.”"
        },
        {
          "id": "source_038",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh chết lặng.\nAnh nhìn chằm chằm vào màn hình vài giây.\nRồi ngay trước mắt anh, tin nhắn tự biến mất."
        },
        {
          "id": "source_039",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không phải bị thu hồi.\nKhông phải lỗi hệ thống.\nMà giống như nó chưa từng tồn tại."
        },
        {
          "id": "source_040",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh mở lại lịch sử tin nhắn.\nTrống rỗng."
        },
        {
          "id": "source_041",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một tiếng “ting” vang lên ngoài hành lang.\nÂm thanh thang máy mở cửa."
        },
        {
          "id": "source_042",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh ngẩng đầu nhìn ra cửa căn hộ.\nHành lang bên ngoài im lặng bất thường.\nRồi anh nghe thấy tiếng bước chân."
        },
        {
          "id": "source_043",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chậm.\nĐều.\nKim loại.\nKeng.\n…Keng.\n…Keng."
        },
        {
          "id": "source_044",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không giống tiếng giày.\nMà giống thứ gì đó rất nặng đang kéo lê trên nền gạch."
        },
        {
          "id": "source_045",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tiếng bước chân dừng lại ngay trước cửa nhà anh."
        },
        {
          "id": "source_046",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh nín thở."
        },
        {
          "id": "source_047",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một khoảng im lặng kéo dài."
        },
        {
          "id": "source_048",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi bóng dưới khe cửa biến mất."
        },
        {
          "id": "source_049",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Thang máy ngoài hành lang khép lại."
        },
        {
          "id": "source_050",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tiếng động xa dần."
        },
        {
          "id": "source_051",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Keng.\n…Keng.\n…Keng."
        },
        {
          "id": "source_052",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Minh đứng bất động giữa căn hộ tối om."
        },
        {
          "id": "source_053",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trong đầu anh bỗng hiện lên một ý nghĩ đáng sợ:"
        },
        {
          "id": "source_054",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có thể thứ đang theo dõi anh… không phải con người."
        },
        {
          "id": "source_055",
          "type": "pull_quote",
          "presentation": "inset",
          "text_vi": "“Thành phố cuối cùng cũng bắt đầu nhìn lại anh.”",
          "attribution_vi": null,
          "shareable": false
        }
      ]
    }
