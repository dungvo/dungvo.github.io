{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_thanh_and_one_more_meter",
  "revision": 2,
  "status": "draft",
  "language": "vi",
  "title_vi": "Thành và một mét tiếp theo — Bản gốc",
  "subtitle_vi": "Ngày mai không cần giải quyết cả cuộc đời; ngày mai chỉ cần đi thêm một mét.",
  "hero_image": null,
  "primary_theme": "adversity_resilience",
  "metadata": {
    "concept_ids": [
      "concept.resilience"
    ],
    "emotion_tags": [
      "anxiety",
      "overwhelm"
    ],
    "keywords": [
      "báo cáo sếp",
      "bước nhỏ",
      "một mét",
      "âm dương đời thường"
    ],
    "story_style": "contemporary"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Có một người đàn ông tên Thành, 42 tuổi."
        },
        {
          "id": "section_01.block_02",
          "type": "paragraph",
          "text_vi": "Thành làm việc cho một công ty lớn trong một tòa nhà giữa thành phố."
        },
        {
          "id": "section_01.block_03",
          "type": "paragraph",
          "text_vi": "Mỗi sáng anh gửi xe dưới tầng hầm, mua một ly cà phê 25 nghìn ở cửa hàng tiện lợi rồi đi thang máy lên tầng 17."
        },
        {
          "id": "section_01.block_04",
          "type": "paragraph",
          "text_vi": "Cuộc sống của anh không có gì đặc biệt."
        },
        {
          "id": "section_01.block_05",
          "type": "paragraph",
          "text_vi": "Vợ."
        },
        {
          "id": "section_01.block_06",
          "type": "paragraph",
          "text_vi": "Hai đứa con."
        },
        {
          "id": "section_01.block_07",
          "type": "paragraph",
          "text_vi": "Một căn hộ đang trả góp."
        },
        {
          "id": "section_01.block_08",
          "type": "paragraph",
          "text_vi": "Một chiếc xe máy đã sáu năm."
        },
        {
          "id": "section_01.block_09",
          "type": "paragraph",
          "text_vi": "Một người mẹ ngoài quê thỉnh thoảng lại gọi lên:"
        },
        {
          "id": "section_01.block_10",
          "type": "paragraph",
          "text_vi": "“Má vẫn khỏe. Con đừng lo.”"
        },
        {
          "id": "section_01.block_11",
          "type": "paragraph",
          "text_vi": "Mặc dù cả hai đều biết câu ấy không phải lúc nào cũng đúng."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Một tối Chủ nhật, Thành không ngủ được."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau anh phải báo cáo với giám đốc."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "Dự án anh phụ trách đang chậm."
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "Một số câu hỏi anh vẫn chưa có câu trả lời."
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "text_vi": "Có một tài liệu anh đáng lẽ phải hoàn thành từ thứ Sáu nhưng vẫn còn vài chỗ trống."
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "11 giờ đêm."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "Thành vẫn mở laptop."
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "Anh sửa một dòng."
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "text_vi": "Rồi xóa."
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "Viết lại."
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "Rồi lại xóa."
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "Cuối cùng anh đóng máy."
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "Nhưng chiếc laptop đóng rồi, cái đầu vẫn chưa đóng."
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "“Nếu ngày mai ông ấy hỏi tại sao chưa xong thì sao?”"
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "text_vi": "“Nếu mình trả lời không được?”"
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "text_vi": "“Nếu ông ấy nghĩ mình không đủ năng lực?”"
        },
        {
          "id": "section_02.block_17",
          "type": "paragraph",
          "text_vi": "“Hay mình đã chọn sai công việc?”"
        },
        {
          "id": "section_02.block_18",
          "type": "paragraph",
          "text_vi": "“Hay mấy năm nữa mình không còn theo nổi ngành này?”"
        },
        {
          "id": "section_02.block_19",
          "type": "paragraph",
          "text_vi": "Từ một cuộc họp sáng thứ Hai, đầu Thành đi luôn đến năm 50 tuổi."
        },
        {
          "id": "section_02.block_20",
          "type": "paragraph",
          "text_vi": "Anh nằm nhìn trần nhà."
        },
        {
          "id": "section_02.block_21",
          "type": "paragraph",
          "text_vi": "Bên cạnh, vợ và hai đứa nhỏ đã ngủ."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Khoảng nửa đêm, Thành khát nước nên bước ra ban công."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Thành phố vẫn còn sáng."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "Anh sống ở tầng 17."
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Từ đó nhìn xuống, những chiếc xe dưới đường chỉ nhỏ bằng đầu ngón tay."
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "text_vi": "Phía xa là hàng nghìn ô cửa sổ."
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "Có ô đã tắt."
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "Có ô vẫn sáng."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "Anh tự nhiên nghĩ:"
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "text_vi": "“Không biết trong những ô cửa đang sáng kia, có bao nhiêu người cũng đang lo giống mình?”"
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Một người đang lo tiền."
        },
        {
          "id": "section_03.block_11",
          "type": "paragraph",
          "text_vi": "Một người đang chăm con bệnh."
        },
        {
          "id": "section_03.block_12",
          "type": "paragraph",
          "text_vi": "Một người vừa mất việc."
        },
        {
          "id": "section_03.block_13",
          "type": "paragraph",
          "text_vi": "Một người ngày mai phỏng vấn."
        },
        {
          "id": "section_03.block_14",
          "type": "paragraph",
          "text_vi": "Một người sợ kết quả xét nghiệm của cha."
        },
        {
          "id": "section_03.block_15",
          "type": "paragraph",
          "text_vi": "Một người vừa cãi nhau với vợ."
        },
        {
          "id": "section_03.block_16",
          "type": "paragraph",
          "text_vi": "Một người đang làm bản thuyết trình mà sáng mai phải trình bày."
        },
        {
          "id": "section_03.block_17",
          "type": "paragraph",
          "text_vi": "Thành bỗng thấy mình không còn cô độc như vài phút trước."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau anh dậy sớm."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "text_vi": "Trời mưa."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "text_vi": "Đường kẹt xe."
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "text_vi": "Thành nhìn đồng hồ."
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "text_vi": "7:43."
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "text_vi": "Cuộc họp lúc 8 giờ."
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "text_vi": "Anh bắt đầu sốt ruột."
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "text_vi": "Chiếc xe phía trước nhích lên khoảng hai mét."
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "text_vi": "Rồi dừng."
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "text_vi": "Một lúc sau lại nhích hai mét."
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "text_vi": "Thành bực mình."
        },
        {
          "id": "section_04.block_12",
          "type": "paragraph",
          "text_vi": "“Đi kiểu này bao giờ mới tới?”"
        },
        {
          "id": "section_04.block_13",
          "type": "paragraph",
          "text_vi": "Bên cạnh anh là một ông chú giao hàng."
        },
        {
          "id": "section_04.block_14",
          "type": "paragraph",
          "text_vi": "Áo mưa cũ."
        },
        {
          "id": "section_04.block_15",
          "type": "paragraph",
          "text_vi": "Phía sau xe chất đầy những thùng nhỏ."
        },
        {
          "id": "section_04.block_16",
          "type": "paragraph",
          "text_vi": "Ông chú nhìn dòng xe rồi nói một mình:"
        },
        {
          "id": "section_04.block_17",
          "type": "paragraph",
          "text_vi": "“Nhích được mét nào hay mét đó.”"
        },
        {
          "id": "section_04.block_18",
          "type": "paragraph",
          "text_vi": "Thành nghe thấy."
        },
        {
          "id": "section_04.block_19",
          "type": "paragraph",
          "text_vi": "Một câu chẳng có gì đặc biệt."
        },
        {
          "id": "section_04.block_20",
          "type": "paragraph",
          "text_vi": "Nhưng không hiểu sao anh nhớ nó."
        },
        {
          "id": "section_04.block_21",
          "type": "pull_quote",
          "text_vi": "Nhích được mét nào hay mét đó.",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "text_vi": "7:47."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "text_vi": "Dòng xe nhích thêm."
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "text_vi": "7:51."
        },
        {
          "id": "section_05.block_04",
          "type": "paragraph",
          "text_vi": "Qua được một ngã tư."
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "text_vi": "7:56."
        },
        {
          "id": "section_05.block_06",
          "type": "paragraph",
          "text_vi": "Thành xuống hầm."
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "text_vi": "8:01."
        },
        {
          "id": "section_05.block_08",
          "type": "paragraph",
          "text_vi": "Anh bước vào thang máy."
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "text_vi": "Anh trễ một phút."
        },
        {
          "id": "section_05.block_10",
          "type": "paragraph",
          "text_vi": "Thế giới vẫn bình thường."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "text_vi": "Cuộc họp bắt đầu."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "text_vi": "Giám đốc xem slide."
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "text_vi": "Đến trang thứ sáu, ông dừng lại."
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "text_vi": "Đúng chỗ Thành sợ nhất."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "text_vi": "“Tại sao phần này chưa có kết luận?”"
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "text_vi": "Tim Thành đập nhanh."
        },
        {
          "id": "section_06.block_07",
          "type": "paragraph",
          "text_vi": "Đây chính là khoảnh khắc tối qua anh đã diễn đi diễn lại hàng chục lần."
        },
        {
          "id": "section_06.block_08",
          "type": "paragraph",
          "text_vi": "Anh hít vào."
        },
        {
          "id": "section_06.block_09",
          "type": "paragraph",
          "text_vi": "“Tôi chưa đủ thông tin để kết luận phần này.”"
        },
        {
          "id": "section_06.block_10",
          "type": "paragraph",
          "text_vi": "Giám đốc nhìn anh."
        },
        {
          "id": "section_06.block_11",
          "type": "paragraph",
          "text_vi": "“Vậy bao giờ có?”"
        },
        {
          "id": "section_06.block_12",
          "type": "paragraph",
          "text_vi": "Thành suy nghĩ."
        },
        {
          "id": "section_06.block_13",
          "type": "paragraph",
          "text_vi": "“Chiều nay tôi xác nhận lại với team. Ngày mai tôi cập nhật.”"
        },
        {
          "id": "section_06.block_14",
          "type": "paragraph",
          "text_vi": "Ông giám đốc im lặng vài giây."
        },
        {
          "id": "section_06.block_15",
          "type": "paragraph",
          "text_vi": "“Được. Tiếp tục đi.”"
        },
        {
          "id": "section_06.block_16",
          "type": "paragraph",
          "text_vi": "Chỉ vậy thôi."
        },
        {
          "id": "section_06.block_17",
          "type": "paragraph",
          "text_vi": "Không có thảm họa."
        },
        {
          "id": "section_06.block_18",
          "type": "paragraph",
          "text_vi": "Không ai đuổi việc."
        },
        {
          "id": "section_06.block_19",
          "type": "paragraph",
          "text_vi": "Không có cuộc đời nào sụp xuống."
        },
        {
          "id": "section_06.block_20",
          "type": "paragraph",
          "text_vi": "Một nỗi sợ mà Thành đã dành gần ba tiếng tối qua để sống cùng..."
        },
        {
          "id": "section_06.block_21",
          "type": "paragraph",
          "text_vi": "...thực tế chỉ kéo dài khoảng hai mươi giây."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "text_vi": "Nhưng vài tuần sau, một chuyện khó hơn xảy ra."
        },
        {
          "id": "section_07.block_02",
          "type": "paragraph",
          "text_vi": "Dự án gặp vấn đề."
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "text_vi": "Lần này Thành thực sự bị giám đốc phê bình."
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "text_vi": "Anh bước ra khỏi phòng họp với khuôn mặt nóng ran."
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "text_vi": "Anh rất buồn."
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "text_vi": "Buổi trưa anh không muốn ăn cùng mọi người."
        },
        {
          "id": "section_07.block_07",
          "type": "paragraph",
          "text_vi": "Anh xuống tầng trệt, mua một ổ bánh mì rồi ngồi một mình bên ngoài tòa nhà."
        },
        {
          "id": "section_07.block_08",
          "type": "paragraph",
          "text_vi": "Đúng lúc đó điện thoại rung."
        },
        {
          "id": "section_07.block_09",
          "type": "paragraph",
          "text_vi": "Tin nhắn của vợ."
        },
        {
          "id": "section_07.block_10",
          "type": "paragraph",
          "text_vi": "“Chiều nhớ chuyển tiền học cho con nhé anh.”"
        },
        {
          "id": "section_07.block_11",
          "type": "paragraph",
          "text_vi": "4.800.000 đồng."
        },
        {
          "id": "section_07.block_12",
          "type": "paragraph",
          "text_vi": "Thành mở tài khoản."
        },
        {
          "id": "section_07.block_13",
          "type": "paragraph",
          "text_vi": "Anh nhìn số dư."
        },
        {
          "id": "section_07.block_14",
          "type": "paragraph",
          "text_vi": "Rồi nhìn tòa nhà phía sau mình."
        },
        {
          "id": "section_07.block_15",
          "type": "paragraph",
          "text_vi": "Một cảm giác rất kỳ lạ xuất hiện."
        },
        {
          "id": "section_07.block_16",
          "type": "paragraph",
          "text_vi": "Sáng nay anh còn nghĩ:"
        },
        {
          "id": "section_07.block_17",
          "type": "paragraph",
          "text_vi": "“Mình không muốn vào đây nữa.”"
        },
        {
          "id": "section_07.block_18",
          "type": "paragraph",
          "text_vi": "Bây giờ anh lại nghĩ:"
        },
        {
          "id": "section_07.block_19",
          "type": "paragraph",
          "text_vi": "“Ngày mai vẫn phải vào.”"
        },
        {
          "id": "section_07.block_20",
          "type": "paragraph",
          "text_vi": "Không phải vì anh yêu công ty."
        },
        {
          "id": "section_07.block_21",
          "type": "paragraph",
          "text_vi": "Không phải vì ông giám đốc đúng."
        },
        {
          "id": "section_07.block_22",
          "type": "paragraph",
          "text_vi": "Cũng không phải vì Thành yếu đuối."
        },
        {
          "id": "section_07.block_23",
          "type": "paragraph",
          "text_vi": "Anh chỉ nhận ra rằng cuộc đời mình lớn hơn một cuộc họp."
        },
        {
          "id": "section_07.block_24",
          "type": "paragraph",
          "text_vi": "Trong đó có tiền học của con."
        },
        {
          "id": "section_07.block_25",
          "type": "paragraph",
          "text_vi": "Có căn nhà."
        },
        {
          "id": "section_07.block_26",
          "type": "paragraph",
          "text_vi": "Có mẹ."
        },
        {
          "id": "section_07.block_27",
          "type": "paragraph",
          "text_vi": "Có những bữa tối."
        },
        {
          "id": "section_07.block_28",
          "type": "paragraph",
          "text_vi": "Có những kế hoạch mà chẳng ai trong công ty biết."
        },
        {
          "id": "section_07.block_29",
          "type": "paragraph",
          "text_vi": "Anh cắn một miếng bánh mì."
        },
        {
          "id": "section_07.block_30",
          "type": "paragraph",
          "text_vi": "“Thôi.”"
        },
        {
          "id": "section_07.block_31",
          "type": "paragraph",
          "text_vi": "“Mai làm tiếp.”"
        }
      ]
    },
    {
      "id": "section_08",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_08.block_01",
          "type": "paragraph",
          "text_vi": "Nhiều tháng trôi qua."
        },
        {
          "id": "section_08.block_02",
          "type": "paragraph",
          "text_vi": "Thành bắt đầu có một thói quen."
        },
        {
          "id": "section_08.block_03",
          "type": "paragraph",
          "text_vi": "Mỗi khi gặp một việc rất lớn, anh không hỏi:"
        },
        {
          "id": "section_08.block_04",
          "type": "pull_quote",
          "text_vi": "“Làm sao giải quyết hết chuyện này?”",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_05",
          "type": "paragraph",
          "text_vi": "Anh hỏi:"
        },
        {
          "id": "section_08.block_06",
          "type": "pull_quote",
          "text_vi": "“Việc nhỏ nhất mình có thể làm tiếp theo là gì?”",
          "attribution_vi": null
        },
        {
          "id": "section_08.block_07",
          "type": "paragraph",
          "text_vi": "Không hiểu hệ thống?"
        },
        {
          "id": "section_08.block_08",
          "type": "paragraph",
          "text_vi": "Đọc một tài liệu."
        },
        {
          "id": "section_08.block_09",
          "type": "paragraph",
          "text_vi": "Tài liệu dài?"
        },
        {
          "id": "section_08.block_10",
          "type": "paragraph",
          "text_vi": "Đọc ba trang."
        },
        {
          "id": "section_08.block_11",
          "type": "paragraph",
          "text_vi": "Không biết báo cáo gì?"
        },
        {
          "id": "section_08.block_12",
          "type": "paragraph",
          "text_vi": "Viết ba dòng:"
        },
        {
          "id": "section_08.block_13",
          "type": "paragraph",
          "text_vi": "Đã biết gì."
        },
        {
          "id": "section_08.block_14",
          "type": "paragraph",
          "text_vi": "Chưa biết gì."
        },
        {
          "id": "section_08.block_15",
          "type": "paragraph",
          "text_vi": "Tiếp theo làm gì."
        },
        {
          "id": "section_08.block_16",
          "type": "paragraph",
          "text_vi": "Dự án rối?"
        },
        {
          "id": "section_08.block_17",
          "type": "paragraph",
          "text_vi": "Vẽ một ô đầu tiên."
        },
        {
          "id": "section_08.block_18",
          "type": "paragraph",
          "text_vi": "Không biết nói chuyện với ai?"
        },
        {
          "id": "section_08.block_19",
          "type": "paragraph",
          "text_vi": "Gửi một tin nhắn."
        },
        {
          "id": "section_08.block_20",
          "type": "paragraph",
          "text_vi": "Lo ngày mai?"
        },
        {
          "id": "section_08.block_21",
          "type": "paragraph",
          "text_vi": "Chuẩn bị việc đầu tiên của ngày mai."
        },
        {
          "id": "section_08.block_22",
          "type": "paragraph",
          "text_vi": "Rồi dừng."
        }
      ]
    },
    {
      "id": "section_09",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_09.block_01",
          "type": "paragraph",
          "text_vi": "Một năm sau, Thành dọn bàn làm việc."
        },
        {
          "id": "section_09.block_02",
          "type": "paragraph",
          "text_vi": "Anh chuyển sang một công việc khác."
        },
        {
          "id": "section_09.block_03",
          "type": "paragraph",
          "text_vi": "Trong ngăn kéo có một cuốn sổ nhỏ."
        },
        {
          "id": "section_09.block_04",
          "type": "paragraph",
          "text_vi": "Anh mở ra."
        },
        {
          "id": "section_09.block_05",
          "type": "paragraph",
          "text_vi": "Trang đầu tiên viết:"
        },
        {
          "id": "section_09.block_06",
          "type": "paragraph",
          "text_vi": "“Ngày 24 tháng 8."
        },
        {
          "id": "section_09.block_07",
          "type": "paragraph",
          "text_vi": "Không hiểu dự án."
        },
        {
          "id": "section_09.block_08",
          "type": "paragraph",
          "text_vi": "Sợ họp với sếp."
        },
        {
          "id": "section_09.block_09",
          "type": "paragraph",
          "text_vi": "Ngày mai hỏi Tuấn về luồng dữ liệu.”"
        },
        {
          "id": "section_09.block_10",
          "type": "paragraph",
          "text_vi": "Thành bật cười."
        },
        {
          "id": "section_09.block_11",
          "type": "paragraph",
          "text_vi": "Anh hoàn toàn quên mất ngày hôm đó."
        },
        {
          "id": "section_09.block_12",
          "type": "paragraph",
          "text_vi": "Nhưng lật những trang tiếp theo, anh thấy:"
        },
        {
          "id": "section_09.block_13",
          "type": "paragraph",
          "text_vi": "“Hỏi Tuấn.”"
        },
        {
          "id": "section_09.block_14",
          "type": "paragraph",
          "text_vi": "“Hiểu source.”"
        },
        {
          "id": "section_09.block_15",
          "type": "paragraph",
          "text_vi": "“Vẽ lại flow.”"
        },
        {
          "id": "section_09.block_16",
          "type": "paragraph",
          "text_vi": "“Phát hiện một vấn đề.”"
        },
        {
          "id": "section_09.block_17",
          "type": "paragraph",
          "text_vi": "“Hỏi thêm.”"
        },
        {
          "id": "section_09.block_18",
          "type": "paragraph",
          "text_vi": "“Update slide.”"
        },
        {
          "id": "section_09.block_19",
          "type": "paragraph",
          "text_vi": "“Review.”"
        },
        {
          "id": "section_09.block_20",
          "type": "paragraph",
          "text_vi": "“Fix.”"
        },
        {
          "id": "section_09.block_21",
          "type": "paragraph",
          "text_vi": "“Done.”"
        },
        {
          "id": "section_09.block_22",
          "type": "paragraph",
          "text_vi": "Mỗi dòng chẳng có gì đáng kể."
        },
        {
          "id": "section_09.block_23",
          "type": "paragraph",
          "text_vi": "Nhưng hàng trăm dòng nhỏ ghép lại thành một năm."
        },
        {
          "id": "section_09.block_24",
          "type": "paragraph",
          "text_vi": "Thành ngồi rất lâu nhìn cuốn sổ."
        },
        {
          "id": "section_09.block_25",
          "type": "paragraph",
          "text_vi": "Và anh hiểu ra một điều mà hồi trẻ mình không biết."
        }
      ]
    },
    {
      "id": "section_10",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_10.block_01",
          "type": "paragraph",
          "text_vi": "Người ta nhìn một cái cây lớn và tưởng rằng thiên nhiên đã làm một việc rất lớn."
        },
        {
          "id": "section_10.block_02",
          "type": "paragraph",
          "text_vi": "Nhưng thiên nhiên chưa từng “làm một cái cây”."
        },
        {
          "id": "section_10.block_03",
          "type": "paragraph",
          "text_vi": "Nó chỉ làm một chiếc lá."
        },
        {
          "id": "section_10.block_04",
          "type": "paragraph",
          "text_vi": "Rồi một chiếc lá nữa."
        },
        {
          "id": "section_10.block_05",
          "type": "paragraph",
          "text_vi": "Một milimét rễ."
        },
        {
          "id": "section_10.block_06",
          "type": "paragraph",
          "text_vi": "Một cơn mưa."
        },
        {
          "id": "section_10.block_07",
          "type": "paragraph",
          "text_vi": "Một buổi sáng có nắng."
        },
        {
          "id": "section_10.block_08",
          "type": "paragraph",
          "text_vi": "Một đêm tối."
        },
        {
          "id": "section_10.block_09",
          "type": "paragraph",
          "text_vi": "Rồi lại một buổi sáng."
        },
        {
          "id": "section_10.block_10",
          "type": "paragraph",
          "text_vi": "Không ngày nào cái cây cố gắng trở thành cây lớn."
        },
        {
          "id": "section_10.block_11",
          "type": "pull_quote",
          "text_vi": "Nó chỉ lớn phần của ngày hôm đó.",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_11",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_11.block_01",
          "type": "paragraph",
          "text_vi": "Thành nhìn ra cửa sổ tầng 17."
        },
        {
          "id": "section_11.block_02",
          "type": "paragraph",
          "text_vi": "Mặt trời đang xuống."
        },
        {
          "id": "section_11.block_03",
          "type": "paragraph",
          "text_vi": "Một nửa thành phố còn sáng."
        },
        {
          "id": "section_11.block_04",
          "type": "paragraph",
          "text_vi": "Một nửa bắt đầu chìm vào bóng tối."
        },
        {
          "id": "section_11.block_05",
          "type": "paragraph",
          "text_vi": "Anh chợt nghĩ đến một điều."
        },
        {
          "id": "section_11.block_06",
          "type": "paragraph",
          "text_vi": "Con người thường thích ánh sáng và ghét bóng tối."
        },
        {
          "id": "section_11.block_07",
          "type": "paragraph",
          "text_vi": "Thích thành công và ghét thất bại."
        },
        {
          "id": "section_11.block_08",
          "type": "paragraph",
          "text_vi": "Thích được khen và ghét bị trách."
        },
        {
          "id": "section_11.block_09",
          "type": "paragraph",
          "text_vi": "Thích biết chắc và ghét mơ hồ."
        },
        {
          "id": "section_11.block_10",
          "type": "paragraph",
          "text_vi": "Nhưng cái cây ngoài kia không như vậy."
        },
        {
          "id": "section_11.block_11",
          "type": "paragraph",
          "text_vi": "Ban ngày nó nhận ánh sáng."
        },
        {
          "id": "section_11.block_12",
          "type": "paragraph",
          "text_vi": "Ban đêm nó nghỉ trong bóng tối."
        },
        {
          "id": "section_11.block_13",
          "type": "paragraph",
          "text_vi": "Mưa đến, nó nhận nước."
        },
        {
          "id": "section_11.block_14",
          "type": "paragraph",
          "text_vi": "Gió đến, rễ của nó bám sâu hơn."
        },
        {
          "id": "section_11.block_15",
          "type": "paragraph",
          "text_vi": "Thiên nhiên không gọi một ngày nắng là “ngày tốt” và một ngày mưa là “ngày xấu”."
        },
        {
          "id": "section_11.block_16",
          "type": "pull_quote",
          "text_vi": "Nó dùng cả hai.",
          "attribution_vi": null
        },
        {
          "id": "section_11.block_17",
          "type": "paragraph",
          "text_vi": "Có lẽ đời người cũng vậy."
        },
        {
          "id": "section_11.block_18",
          "type": "paragraph",
          "text_vi": "Một lần được khen cho ta tự tin."
        },
        {
          "id": "section_11.block_19",
          "type": "paragraph",
          "text_vi": "Một lần bị phê bình cho ta biết giới hạn."
        },
        {
          "id": "section_11.block_20",
          "type": "paragraph",
          "text_vi": "Một công việc thuận lợi cho ta thành quả."
        },
        {
          "id": "section_11.block_21",
          "type": "paragraph",
          "text_vi": "Một giai đoạn hỗn loạn dạy ta cách đứng vững."
        },
        {
          "id": "section_11.block_22",
          "type": "paragraph",
          "text_vi": "Một ngày biết mình đang đi đâu cho ta tốc độ."
        },
        {
          "id": "section_11.block_23",
          "type": "paragraph",
          "text_vi": "Một ngày chẳng biết phải làm gì dạy ta cách tìm bước đầu tiên."
        },
        {
          "id": "section_11.block_24",
          "type": "paragraph",
          "text_vi": "Âm không chống lại dương."
        },
        {
          "id": "section_11.block_25",
          "type": "paragraph",
          "text_vi": "Đêm không đánh bại ngày."
        },
        {
          "id": "section_11.block_26",
          "type": "paragraph",
          "text_vi": "Chúng thay phiên nhau làm công việc của mình."
        }
      ]
    },
    {
      "id": "section_12",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_12.block_01",
          "type": "paragraph",
          "text_vi": "Tối hôm ấy Thành về nhà."
        },
        {
          "id": "section_12.block_02",
          "type": "paragraph",
          "text_vi": "Con gái đang ngồi làm bài toán."
        },
        {
          "id": "section_12.block_03",
          "type": "paragraph",
          "text_vi": "Nó chạy ra hỏi:"
        },
        {
          "id": "section_12.block_04",
          "type": "paragraph",
          "text_vi": "“Ba ơi, bài này khó quá. Con làm không được.”"
        },
        {
          "id": "section_12.block_05",
          "type": "paragraph",
          "text_vi": "Thành nhìn bài toán."
        },
        {
          "id": "section_12.block_06",
          "type": "paragraph",
          "text_vi": "Có mười câu."
        },
        {
          "id": "section_12.block_07",
          "type": "paragraph",
          "text_vi": "Anh lấy một tờ giấy che chín câu lại."
        },
        {
          "id": "section_12.block_08",
          "type": "paragraph",
          "text_vi": "Chỉ để lộ câu đầu tiên."
        },
        {
          "id": "section_12.block_09",
          "type": "paragraph",
          "text_vi": "“Bây giờ còn khó không?”"
        },
        {
          "id": "section_12.block_10",
          "type": "paragraph",
          "text_vi": "Con bé nhìn."
        },
        {
          "id": "section_12.block_11",
          "type": "paragraph",
          "text_vi": "“Câu này thì con làm được.”"
        },
        {
          "id": "section_12.block_12",
          "type": "paragraph",
          "text_vi": "“Vậy làm đi.”"
        },
        {
          "id": "section_12.block_13",
          "type": "paragraph",
          "text_vi": "Nó làm xong."
        },
        {
          "id": "section_12.block_14",
          "type": "paragraph",
          "text_vi": "Thành kéo tờ giấy xuống một chút."
        },
        {
          "id": "section_12.block_15",
          "type": "paragraph",
          "text_vi": "Câu thứ hai xuất hiện."
        },
        {
          "id": "section_12.block_16",
          "type": "paragraph",
          "text_vi": "“Còn cái này?”"
        },
        {
          "id": "section_12.block_17",
          "type": "paragraph",
          "text_vi": "“Chắc được.”"
        },
        {
          "id": "section_12.block_18",
          "type": "paragraph",
          "text_vi": "Một lúc sau, cả mười câu đều xong."
        },
        {
          "id": "section_12.block_19",
          "type": "paragraph",
          "text_vi": "Con gái vui vẻ chạy đi."
        },
        {
          "id": "section_12.block_20",
          "type": "paragraph",
          "text_vi": "Thành vẫn ngồi đó."
        },
        {
          "id": "section_12.block_21",
          "type": "paragraph",
          "text_vi": "Anh nhìn tờ giấy rất lâu."
        },
        {
          "id": "section_12.block_22",
          "type": "paragraph",
          "text_vi": "Rồi anh cười."
        },
        {
          "id": "section_12.block_23",
          "type": "paragraph",
          "text_vi": "Hóa ra bao nhiêu năm nay cuộc đời cũng đang dạy anh đúng bài học ấy."
        },
        {
          "id": "section_12.block_24",
          "type": "paragraph",
          "text_vi": "Chỉ có điều nó không dùng một tờ giấy để che phần còn lại."
        },
        {
          "id": "section_12.block_25",
          "type": "pull_quote",
          "text_vi": "Anh phải tự học cách che nó.",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_13",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_13.block_01",
          "type": "paragraph",
          "text_vi": "Tối Chủ nhật sau đó, Thành lại nghĩ đến công việc."
        },
        {
          "id": "section_13.block_02",
          "type": "paragraph",
          "text_vi": "Ngày mai vẫn có cuộc họp."
        },
        {
          "id": "section_13.block_03",
          "type": "paragraph",
          "text_vi": "Vẫn có những câu hỏi anh chưa biết trả lời."
        },
        {
          "id": "section_13.block_04",
          "type": "paragraph",
          "text_vi": "Một chút bất an lại xuất hiện."
        },
        {
          "id": "section_13.block_05",
          "type": "paragraph",
          "text_vi": "Thành không cố đuổi nó đi."
        },
        {
          "id": "section_13.block_06",
          "type": "paragraph",
          "text_vi": "Anh biết đêm phải có bóng tối."
        },
        {
          "id": "section_13.block_07",
          "type": "paragraph",
          "text_vi": "Anh mở cuốn sổ và viết:"
        },
        {
          "id": "section_13.block_08",
          "type": "paragraph",
          "text_vi": "“Ngày mai:"
        },
        {
          "id": "section_13.block_09",
          "type": "paragraph",
          "text_vi": "1. Đi làm.\n2. Nói những gì mình biết.\n3. Không biết thì nói chưa biết.\n4. Làm bước tiếp theo.”"
        },
        {
          "id": "section_13.block_10",
          "type": "paragraph",
          "text_vi": "Anh đóng sổ."
        },
        {
          "id": "section_13.block_11",
          "type": "paragraph",
          "text_vi": "Ngoài cửa sổ, hàng nghìn ngọn đèn thành phố vẫn sáng."
        },
        {
          "id": "section_13.block_12",
          "type": "paragraph",
          "text_vi": "Ở đâu đó chắc chắn vẫn có một người đang lo tiền học."
        },
        {
          "id": "section_13.block_13",
          "type": "paragraph",
          "text_vi": "Một người đang chăm mẹ trong bệnh viện."
        },
        {
          "id": "section_13.block_14",
          "type": "paragraph",
          "text_vi": "Một người sợ mất việc."
        },
        {
          "id": "section_13.block_15",
          "type": "paragraph",
          "text_vi": "Một người đang sợ cuộc họp sáng mai."
        },
        {
          "id": "section_13.block_16",
          "type": "paragraph",
          "text_vi": "Và hàng triệu người khác chẳng biết ngày mai sẽ mang tới điều gì."
        },
        {
          "id": "section_13.block_17",
          "type": "paragraph",
          "text_vi": "Nhưng sáng mai mặt trời vẫn mọc."
        },
        {
          "id": "section_13.block_18",
          "type": "paragraph",
          "text_vi": "Xe vẫn chạy."
        },
        {
          "id": "section_13.block_19",
          "type": "paragraph",
          "text_vi": "Quán cà phê vẫn mở."
        },
        {
          "id": "section_13.block_20",
          "type": "paragraph",
          "text_vi": "Thang máy vẫn đi lên."
        },
        {
          "id": "section_13.block_21",
          "type": "paragraph",
          "text_vi": "Người ta vẫn bước vào công ty."
        },
        {
          "id": "section_13.block_22",
          "type": "paragraph",
          "text_vi": "Không phải vì tất cả đều mạnh mẽ."
        },
        {
          "id": "section_13.block_23",
          "type": "paragraph",
          "text_vi": "Không phải vì tất cả đều biết mình đang làm gì."
        },
        {
          "id": "section_13.block_24",
          "type": "pull_quote",
          "text_vi": "Chỉ vì từng bước nhỏ đã đưa con người đi qua phần lớn cuộc đời.",
          "attribution_vi": null
        },
        {
          "id": "section_13.block_25",
          "type": "paragraph",
          "text_vi": "Thành tắt đèn."
        },
        {
          "id": "section_13.block_26",
          "type": "paragraph",
          "text_vi": "Trước khi ngủ, anh nhớ lại ông chú giao hàng trong buổi sáng mưa năm ấy:"
        },
        {
          "id": "section_13.block_27",
          "type": "paragraph",
          "text_vi": "“Nhích được mét nào hay mét đó.”"
        },
        {
          "id": "section_13.block_28",
          "type": "paragraph",
          "text_vi": "Anh mỉm cười."
        },
        {
          "id": "section_13.block_29",
          "type": "paragraph",
          "text_vi": "Ngày mai không cần phải giải quyết cả cuộc đời."
        },
        {
          "id": "section_13.block_30",
          "type": "paragraph",
          "text_vi": "Ngày mai cũng chẳng cần chứng minh mình là một người giỏi."
        },
        {
          "id": "section_13.block_31",
          "type": "paragraph",
          "text_vi": "Ngày mai chỉ cần đi thêm một mét."
        },
        {
          "id": "section_13.block_32",
          "type": "paragraph",
          "text_vi": "Rồi một mét nữa."
        },
        {
          "id": "section_13.block_33",
          "type": "pull_quote",
          "text_vi": "Một mét là rất nhỏ.",
          "attribution_vi": null
        },
        {
          "id": "section_13.block_34",
          "type": "pull_quote",
          "text_vi": "Nhưng mọi con đường trên đời đều được đi hết bằng những đoạn nhỏ như thế.",
          "attribution_vi": null
        }
      ]
    }
  ],
