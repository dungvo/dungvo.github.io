          "attribution_vi": null,
          "shareable": false
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ta định giá một khoảnh khắc theo một cách."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "style": "lead_in",
          "text_vi": "Khi biết:"
        },
        {
          "id": "section_03.block_09",
          "type": "pull_quote",
          "presentation": "rail",
          "text_vi": "“Đây là lần cuối.”",
          "runs": [
            {
              "text_vi": "“Đây là lần cuối.”",
              "marks": [
                "emphasis"
              ]
            }
          ],
          "attribution_vi": null,
          "shareable": false
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ta định giá nó theo một cách khác."
        },
        {
          "id": "section_03.block_11",
          "type": "flow",
          "items": [
            {
              "text_vi": "Nhận thức ấy tạo ra cảm xúc."
            },
            {
              "text_vi": "Cảm xúc khiến ta nhìn lại điều gì thực sự quan trọng."
            },
            {
              "text_vi": "Và đôi khi, nó thay đổi cả hành vi của chúng ta."
            }
          ]
        },
        {
          "id": "section_03.block_12",
          "type": "list",
          "style": "plain",
          "items": [
            {
              "text_vi": "Một người sẵn sàng mua tấm vé mà hôm qua họ thấy quá đắt."
            },
            {
              "text_vi": "Một người ở lại bàn ăn lâu hơn một chút."
            },
            {
              "text_vi": "Một người cất điện thoại xuống."
            },
            {
              "text_vi": "Một người quyết định về thăm cha mẹ thay vì nói:"
            }
          ]
        },
        {
          "id": "section_03.block_13",
          "type": "pull_quote",
          "presentation": "inset",
          "text_vi": "“Tuần sau con về.”",
          "runs": [
            {
              "text_vi": "“Tuần sau con về.”",
              "marks": [
                "emphasis"
              ]
            }
          ],
          "attribution_vi": null,
          "shareable": false
        }
      ]
    },
    {
      "id": "section_04",
      "marker_vi": null,
      "marker_unit_vi": null,
      "title_vi": "Khi vẫn còn thời gian",
      "subtitle_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chúng ta không thể biết đâu là lần cuối."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và có lẽ cũng không nên sống mỗi ngày trong nỗi sợ rằng mọi thứ sắp biến mất."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "style": "lead_in",
          "text_vi": "Nhưng ta có thể nhận thức được một điều đơn giản:"
        },
        {
          "id": "section_04.block_04",
          "type": "statement",
          "presentation": "centered",
          "text_vi": "Những thứ mình đang có không có số lần vô hạn.",
          "runs": [
            {
              "text_vi": "Những thứ mình đang có không có số lần vô hạn.",
              "marks": [
                "strong"
              ]
            }
          ],
          "shareable": true
        },
        {
          "id": "section_04.block_05",
          "type": "sequence",
          "progression": "neutral",
          "items": [
            {
              "text_vi": "Con rồi sẽ lớn."
            },
            {
              "text_vi": "Cha mẹ rồi sẽ già."
            },
            {
              "text_vi": "Bạn bè rồi mỗi người sẽ có một cuộc sống."
            },
            {
              "text_vi": "Và chính mình cũng chỉ có một khoảng thời gian hữu hạn để sống cuộc đời này."
            }
          ]
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhận ra điều đó không phải để sợ mất."
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Mà có thể để nhìn lại cách mình đang lựa chọn."
        },
        {
          "id": "section_04.block_08",
          "type": "list",
          "style": "plain",
          "items": [
            {
              "text_vi": "Thứ gì đang chiếm phần lớn thời gian của mình?",
              "runs": [
                {
                  "text_vi": "Thứ gì đang chiếm phần lớn thời gian của mình?",
                  "marks": [
                    "strong"
                  ]
                }
              ]
            },
            {
              "text_vi": "Thứ gì thực sự quan trọng nhưng luôn được để lại cho “ngày mai”?",
              "runs": [
                {
                  "text_vi": "Thứ gì thực sự quan trọng nhưng luôn được để lại cho “ngày mai”?",
                  "marks": [
                    "strong"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và nếu biết một điều mình yêu quý không tồn tại mãi, liệu hôm nay mình có đối xử với nó khác đi một chút không?"
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "style": "lead_in",
          "text_vi": "Có lẽ ta không cần:"
