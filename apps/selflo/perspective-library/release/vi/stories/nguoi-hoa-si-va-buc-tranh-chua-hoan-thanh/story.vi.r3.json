  "title_vi": "NGƯỜI HỌA SĨ VÀ BỨC TRANH CHƯA HOÀN THÀNH",
  "subtitle_vi": "Một điều đáng theo đuổi có nhất thiết đáng để đánh đổi mọi thứ?",
  "hero_image": null,
  "primary_theme": "meaning_values",
  "metadata": {
    "concept_ids": [

    ],
