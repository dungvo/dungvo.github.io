    ]
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "paragraph_001",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày xưa, ở một thị trấn nhỏ có một người họa sĩ chuyên vẽ tranh cho người khác."
        },
        {
          "id": "paragraph_002",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông có một tài năng kỳ lạ. Dù được đưa cho những màu sắc xấu xí đến đâu, ông vẫn có thể biến chúng thành một bức tranh đẹp."
        },
        {
          "id": "paragraph_003",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người ta thường nói:"
        },
        {
          "id": "paragraph_004",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_004_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Chỉ cần có màu trong tay ông ấy, chẳng có bức tranh nào là không thể cứu vãn.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_005",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người họa sĩ cũng tin như vậy."
        },
        {
          "id": "paragraph_006",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cho đến một ngày, ông quyết định vẽ bức tranh quan trọng nhất đời mình."
        },
        {
          "id": "paragraph_007",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bức tranh của chính ông."
        },
        {
          "id": "paragraph_008",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_009",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chuẩn bị một tấm toan thật lớn, những cây cọ tốt nhất và hàng chục lọ màu."
        },
        {
          "id": "paragraph_010",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông bắt đầu bằng màu xanh của những ước mơ, màu vàng của tuổi trẻ, màu đỏ của tình yêu."
        },
        {
          "id": "paragraph_011",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bức tranh dần hiện lên đẹp đẽ."
        },
        {
          "id": "paragraph_012",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng khi ông đang vẽ, một cơn mưa bất ngờ tràn qua cửa sổ. Nước cuốn theo lọ mực đen, đổ lên chính giữa tấm toan."
        },
        {
          "id": "paragraph_013",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một vệt đen lớn phá hỏng phần đẹp nhất của bức tranh."
        },
        {
          "id": "paragraph_014",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông giận dữ, định xé bỏ nó."
        },
        {
          "id": "paragraph_015",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng rồi ông nhớ đến những bức tranh mình từng cứu."
        },
        {
          "id": "paragraph_016",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông lấy cọ, biến vệt đen thành một ngọn núi. Những đường mực loang trở thành bóng cây. Phần tối nhất trở thành bầu trời đêm."
        },
        {
          "id": "paragraph_017",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bức tranh đẹp trở lại."
        },
        {
          "id": "paragraph_018",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông mỉm cười."
        },
        {
          "id": "paragraph_019",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hóa ra, ngay cả điều tồi tệ cũng có thể trở thành một phần của cái đẹp."
        },
        {
          "id": "paragraph_020",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_021",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều năm trôi qua."
        },
        {
          "id": "paragraph_022",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bức tranh ngày càng lớn, nhưng những lọ màu của ông ngày càng ít."
        },
        {
          "id": "paragraph_023",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một hôm, người con gái đến gặp ông."
        },
        {
          "id": "paragraph_024",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_024_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cha có thể bán bức tranh này không? Chúng ta cần tiền sửa lại mái nhà trước mùa mưa.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_025",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông lắc đầu."
        },
        {
          "id": "paragraph_026",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_026_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Đây là bức tranh cả đời cha. Cha không thể bán.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_027",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô con gái im lặng."
        },
        {
          "id": "paragraph_028",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đêm đó, mưa rơi xuống chiếc giường của cô."
        },
        {
          "id": "paragraph_029",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người họa sĩ ngồi trước bức tranh, nhìn phần bầu trời đêm mà mình từng rất tự hào."
        },
        {
          "id": "paragraph_030",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần đầu tiên, ông nhận ra có những thứ không thể giải quyết chỉ bằng cách vẽ chúng đẹp hơn."
        },
        {
          "id": "paragraph_031",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông có thể biến vết mực đen thành ngọn núi."
        },
        {
          "id": "paragraph_032",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng không thể biến mái nhà dột thành một mái nhà lành lặn bằng trí tưởng tượng."
        },
        {
          "id": "paragraph_033",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_034",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sáng hôm sau, một thương nhân đến mua bức tranh với giá rất cao."
        },
        {
          "id": "paragraph_035",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Số tiền ấy đủ để sửa mái nhà, trả những khoản nợ và giúp gia đình sống yên ổn nhiều năm."
        },
        {
          "id": "paragraph_036",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng thương nhân có một điều kiện."
        },
        {
          "id": "paragraph_037",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông ta muốn người họa sĩ vẽ phủ lên phần bức tranh còn dang dở một khung cảnh thật rực rỡ, rồi ký tên và tuyên bố nó đã hoàn thành."
        },
        {
          "id": "paragraph_038",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người họa sĩ nhìn tấm toan."
        },
        {
          "id": "paragraph_039",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông biết nếu làm vậy, bức tranh sẽ đẹp trong mắt người mua."
        },
        {
          "id": "paragraph_040",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng đó không còn là bức tranh ông muốn vẽ."
        },
        {
          "id": "paragraph_041",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông có ba lựa chọn."
        },
        {
          "id": "paragraph_042",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Giữ bức tranh và để gia đình tiếp tục chịu khổ."
        },
        {
          "id": "paragraph_043",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bán nó và từ bỏ điều mình đã theo đuổi cả đời."
        },
        {
          "id": "paragraph_044",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hoặc tìm một cách khác, dù chẳng biết có thành công hay không."
        },
        {
          "id": "paragraph_045",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Suốt đêm, ông không ngủ."
        },
        {
          "id": "paragraph_046",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông từng nghĩ mình là người quyết định số phận bức tranh."
        },
        {
          "id": "paragraph_047",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Giờ đây, ông nhận ra mỗi nét cọ của mình còn ảnh hưởng đến những người đứng ngoài tấm toan ấy."
        },
        {
          "id": "paragraph_048",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_049",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sáng hôm sau, ông từ chối điều kiện của thương nhân."
        },
        {
          "id": "paragraph_050",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng ông cũng không giữ nguyên mọi thứ."
        },
        {
          "id": "paragraph_051",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông cắt bức tranh thành hai phần."
        },
        {
          "id": "paragraph_052",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phần đã hoàn thành, ông đem bán."
        },
        {
          "id": "paragraph_053",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Phần còn dang dở, ông giữ lại."
        },
        {
          "id": "paragraph_054",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người thương nhân trả ít tiền hơn. Chỉ đủ sửa mái nhà, không đủ trả hết nợ."
        },
        {
          "id": "paragraph_055",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người họa sĩ phải nhận thêm việc. Có những tháng ông không còn thời gian cầm cọ vẽ cho mình."
        },
        {
          "id": "paragraph_056",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Đôi khi ông hối tiếc."
        },
        {
          "id": "paragraph_057",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nếu bán cả bức tranh, có lẽ cuộc sống đã dễ dàng hơn."
        },
        {
          "id": "paragraph_058",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nếu giữ nguyên nó, có lẽ một ngày nào đó ông sẽ tạo ra kiệt tác."
        },
        {
          "id": "paragraph_059",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông không biết mình đã chọn đúng hay sai."
        },
        {
          "id": "paragraph_060",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_061",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều năm sau, khi người họa sĩ đã già, cô con gái tìm thấy phần tranh còn dang dở trong căn phòng cũ."
        },
        {
          "id": "paragraph_062",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trên đó có những cánh đồng xanh, một ngọn núi đen, vài ngôi nhà và một con đường chưa được vẽ đến cuối."
        },
        {
          "id": "paragraph_063",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô hỏi:"
        },
        {
          "id": "paragraph_064",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_064_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cha đã dành cả đời cho bức tranh này. Cha có tiếc vì không hoàn thành nó không?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_065",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông nhìn bức tranh rất lâu."
        },
        {
          "id": "paragraph_066",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_066_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Có chứ.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_067",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô ngạc nhiên."
        },
        {
          "id": "paragraph_068",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_068_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Vậy cha nghĩ mình đã lựa chọn sai?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_069",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông lắc đầu."
        },
        {
          "id": "paragraph_070",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_070_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cha không biết. Đến tận bây giờ, cha vẫn không biết.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_071",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chỉ vào ngọn núi đen."
        },
        {
          "id": "paragraph_072",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_072_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Ngày xưa, cha tưởng mình giỏi vì có thể biến một vết mực hỏng thành thứ đẹp đẽ.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_073",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi ông chỉ vào khoảng trống cuối con đường."
        },
        {
          "id": "paragraph_074",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_074_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Sau này, cha mới hiểu rằng không phải vết mực nào cũng cần biến thành hoa, không phải khoảng trống nào cũng cần lấp đầy.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_075",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_075_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Vậy điều quan trọng nhất khi vẽ một bức tranh là gì hả cha?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_076",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông đưa cây cọ cũ cho con gái."
        },
        {
          "id": "paragraph_077",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_077_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Là biết mình đang vẽ điều gì, vì ai, và mình sẵn sàng đánh đổi điều gì cho nó.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_078",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô con gái nhìn phần tranh chưa hoàn thành."
        },
        {
          "id": "paragraph_079",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_079_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Con có thể vẽ tiếp không?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_080",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người họa sĩ mỉm cười."
        },
        {
          "id": "paragraph_081",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_081_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Được. Nhưng đừng cố vẽ tiếp con đường của cha. Hãy vẽ con đường mà con muốn đi.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_082",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_083",
          "type": "paragraph",
