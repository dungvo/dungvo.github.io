{
  "schema_version": "1.1",
  "entity": "perspective_story",
  "id": "story.original_chair_beside_window",
  "revision": 1,
  "status": "active",
  "language": "vi",
  "title_vi": "Chiếc ghế cạnh cửa sổ",
  "subtitle_vi": "Công ty chỉ là một phần của ngày sống, không phải toàn bộ cuộc đời mình.",
  "hero_image": null,
  "primary_theme": "rest_wellbeing",
  "metadata": {
    "concept_ids": [
      "concept.psychological_detachment"
    ],
    "emotion_tags": [
      "frustration",
      "exhaustion"
    ],
    "keywords": [
      "tan làm",
      "ranh giới công việc",
      "buổi tối",
      "chiếc ghế cửa sổ"
    ],
    "story_style": "contemporary"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": "Lời dẫn",
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Tôi kể bạn một câu chuyện dài hơn một chút. Nó không phải câu chuyện về một công ty hoàn hảo. Ngược lại, nó là về một nơi có sếp khó chịu, đồng nghiệp không phải lúc nào cũng dễ thương, công việc nhiều lúc vô nghĩa — nhưng một người dần nhận ra rằng công ty chỉ là một phần của ngày sống, không phải toàn bộ cuộc đời mình."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "Câu chuyện",
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Có một người đã làm việc ở các công ty trong nhiều năm.\n\nAnh đã đi làm gần hai mươi năm.\n\nNgày còn trẻ, mỗi lần đổi công ty anh đều có cảm giác rất khác."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ngày đầu tiên mặc áo sơ mi mới.\n\nLaptop mới.\n\nNhững khuôn mặt mới."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Anh nghĩ:"
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Có lẽ ở đây mình sẽ làm được những thứ thật hay.”"
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng nhiều năm trôi qua, cảm giác ấy nhạt dần.\n\nCông ty nào rồi cũng xuất hiện những thứ giống nhau.\n\nMột người sếp nói chuyện làm anh khó chịu."
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một đồng nghiệp thích đẩy trách nhiệm.\n\nMột cuộc họp kéo dài một tiếng mà anh nghĩ chỉ cần một email."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một dự án được gọi là “urgent”, rồi vài tuần sau chẳng ai nhắc tới."
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Và những yêu cầu kiểu:"
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“anh làm giúp cái này nhé.”"
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cần khi nào?”"
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Càng sớm càng tốt.”"
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Yêu cầu cụ thể là gì?”"
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Em cứ draft trước đi rồi mình xem.”"
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh ghét nhất câu đó."
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cứ draft trước đi.”"
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Draft cái gì khi chẳng ai biết mình muốn gì?"
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Một buổi chiều, anh nhận một yêu cầu như vậy.\n\nThứ Hai phải trình bày.\n\nNhưng người yêu cầu không đưa đủ thông tin."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh nhắn hỏi.\n\nKhông ai trả lời.\n\nAnh ngồi trước màn hình, càng nghĩ càng bực."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Anh không chỉ bực vì công việc.\n\nAnh bắt đầu nghĩ:"
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Mình đã hơn 40 rồi mà vẫn phải chịu những chuyện thế này sao?”"
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi từ một cái slide, đầu óc anh đi rất xa."
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Mình còn phải làm công ty bao nhiêu năm nữa?”"
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nếu nghỉ thì lấy gì sống?”"
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nếu chuyển chỗ khác rồi cũng thế thì sao?”"
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Chẳng lẽ cuộc đời cứ sáng đi làm, chiều về, rồi già đi?”"
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cái PowerPoint nhỏ bé bỗng biến thành câu hỏi về cả cuộc đời."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "6 giờ tối.\n\nVăn phòng gần như hết người.\n\nanh đóng laptop."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh không muốn về ngay.\n\nAnh đi xuống dưới tòa nhà và ngồi trên một chiếc ghế cạnh cửa sổ của quán cà phê.\n\nNgoài đường, trời vừa mưa."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh nhìn những chiếc xe chạy qua.\n\nCó một cô nhân viên vệ sinh đang lau sàn.\n\nCô khoảng ngoài năm mươi."
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh thường gặp cô nhưng chưa bao giờ nói chuyện.\n\nHôm đó cô nhìn anh rồi hỏi:"
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Anh chưa về à?”"
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh cười:"
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Công việc hơi mệt cô ạ.”"
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô cũng cười."
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Đi làm mà. Có ngày vui, có ngày muốn nghỉ luôn.”"
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh bật cười.\n\nKhông ngờ câu đó lại đến từ cô.\n\nAnh hỏi:"
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cô làm ở đây lâu chưa?”"
        },
        {
          "id": "section_04.block_12",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Mười một năm.”"
        },
        {
          "id": "section_04.block_13",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh ngạc nhiên."
        },
        {
          "id": "section_04.block_14",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cô không chán sao?”"
        },
        {
          "id": "section_04.block_15",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Chán chứ.”"
        },
        {
          "id": "section_04.block_16",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô tiếp tục lau sàn."
        },
        {
          "id": "section_04.block_17",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Có người dễ thương. Có người coi mình như không tồn tại. Có hôm người ta vừa ăn xong để nguyên một đống cho mình dọn. Có hôm đang lau còn bước thẳng qua.”"
        },
        {
          "id": "section_04.block_18",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh hỏi:"
        },
        {
          "id": "section_04.block_19",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Vậy sao cô chịu được mười một năm?”"
        },
        {
          "id": "section_04.block_20",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Cô dừng cây lau nhà.\n\nCô suy nghĩ một lúc.\n\nRồi nói:"
        },
        {
          "id": "section_04.block_21",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Vì tôi đâu có làm ở đây cả ngày.”"
        },
        {
          "id": "section_04.block_22",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh nhìn đồng hồ."
        },
        {
          "id": "section_04.block_23",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cô làm tám tiếng mà?”"
        },
        {
          "id": "section_04.block_24",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cô cười."
        },
        {
          "id": "section_04.block_25",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Ý tôi không phải vậy.”"
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Cô chỉ ra ngoài cửa kính."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Buổi sáng trước khi đến đây, tôi mua bánh mì cho chồng.”"
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Trưa tôi gọi điện hỏi cháu ngoại ăn cơm chưa.”"
        },
        {
          "id": "section_05.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Chiều làm xong tôi về tưới mấy chậu cây.”"
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Tối thứ Tư tôi đi tập thể dục với mấy bà trong xóm.”"
        },
        {
          "id": "section_05.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Chủ nhật tôi nấu bún riêu.”"
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Rồi cô nói một câu anh nhớ rất lâu:"
        },
        {
          "id": "section_05.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nếu tôi để một người làm tôi khó chịu lúc 2 giờ chiều lấy luôn cả buổi tối của tôi, vậy là tôi cho người đó nhiều quá.”"
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh im lặng."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Cô tiếp tục lau.\n\nanh vẫn ngồi đó.\n\nAnh chợt nhận ra một điều hơi buồn cười."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người requester đã gửi cho anh một tin nhắn lúc 3 giờ 17 phút.\n\nNgười đó có lẽ đã về nhà.\n\nCó thể đang ăn tối."
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có thể đang xem điện thoại.\n\nCó thể đã quên luôn cái slide.\n\nNhưng 6 giờ 30, anh vẫn đang tiếp tục cuộc họp với người đó trong đầu mình."
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Không cần người kia có mặt.\n\nanh tự đóng cả hai vai."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Tại sao yêu cầu không rõ?”"
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Deadline thế này sao làm?”"
        },
        {
          "id": "section_06.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nếu thứ Hai họ lại thay đổi thì sao?”"
        },
        {
          "id": "section_06.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh tự hỏi.\n\nRồi tự trả lời.\n\nRồi tự tức."
        },
        {
          "id": "section_06.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cuộc họp không có thật.\n\nVà kỳ lạ nhất là chỉ có anh tham dự.\n\nAnh bật cười."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Trước khi cô lao công đi, anh hỏi:"
        },
        {
          "id": "section_07.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nhưng nếu ngày mai lại gặp chuyện khó chịu thì sao cô?”"
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Cô nói:"
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Thì ngày mai khó chịu tiếp.”"
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh cười.\n\nCô cũng cười.\n\nRồi cô nói thêm:"
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nhưng hôm nay hết giờ rồi.”"
        }
      ]
    },
    {
      "id": "section_08",
      "title_vi": "Sáng hôm sau",
      "blocks": [
        {
          "id": "section_08.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "anh đến công ty.\n\nRequester vẫn chưa trả lời.\n\nNhưng lần này anh không ngồi nhìn màn hình và tức."
        },
        {
          "id": "section_08.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh mở slide.\n\nTrang đầu tiên anh viết:\n\nDraft — Based on current understanding"
        },
        {
          "id": "section_08.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh làm những gì mình biết.\n\nNhững chỗ không biết, anh viết:\n\nAssumption"
        },
        {
          "id": "section_08.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những chỗ cần xác nhận:\n\nTo be confirmed\n\n11 giờ, sếp đi ngang qua."
        },
        {
          "id": "section_08.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“anh, cái deck hôm qua sao rồi?”"
        },
        {
          "id": "section_08.block_06",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Ngày trước anh có thể nghĩ:\n\nLại nữa.\n\nNhưng hôm đó anh chỉ nói:"
        },
        {
          "id": "section_08.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Em có skeleton rồi. Có ba assumptions em cần confirm trước khi hoàn thiện.”"
        },
        {
          "id": "section_08.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Sếp nhìn qua."
        },
        {
          "id": "section_08.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“OK, chiều trao đổi.”"
        },
        {
          "id": "section_08.block_10",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Hết.\n\nCuộc nói chuyện mà anh đã diễn tập hàng chục lần trong đầu tối hôm trước...\n\n...thực tế kéo dài chưa đến một phút."
        }
      ]
    },
    {
      "id": "section_09",
      "title_vi": "Rồi một chuyện khác xảy ra",
      "blocks": [
        {
          "id": "section_09.block_01",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Vài tháng sau, anh mắc một lỗi.\n\nKhông nghiêm trọng, nhưng trong cuộc họp, một đồng nghiệp nói:"
        },
        {
          "id": "section_09.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cái này hôm trước tôi đã nói với anh rồi.”"
        },
        {
          "id": "section_09.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh biết câu đó không hoàn toàn đúng.\n\nAnh nóng mặt.\n\nAnh rất muốn phản bác ngay."
        },
        {
          "id": "section_09.block_04",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Nhưng đúng lúc đó, anh nhớ đến cô lao công.\n\nĐừng mang quá nhiều thứ không thuộc về mình.\n\nanh lấy giấy viết:"
        },
        {
          "id": "section_09.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Fact: Có issue.\n\nMy part: Tôi có một phần trách nhiệm.\n\nNot my part: Cách người kia cố bảo vệ mình trước mọi người."
        },
        {
          "id": "section_09.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh giải quyết phần đầu.\n\nPhần thứ hai, anh để lại.\n\nBuổi tối hôm ấy anh vẫn ăn cơm bình thường."
        }
      ]
    },
    {
      "id": "section_10",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_10.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Một thời gian sau nữa, anh bị sếp phê bình.\n\nLần này sếp đúng.\n\nanh buồn."
        },
        {
          "id": "section_10.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh đi xuống quán cà phê tìm cô lao công.\n\nNhưng hôm đó không thấy cô.\n\nNgày hôm sau cũng không."
        },
        {
          "id": "section_10.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh hỏi nhân viên quán."
        },
        {
          "id": "section_10.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Cô nghỉ rồi anh. Về quê chăm cháu.”"
        },
        {
          "id": "section_10.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh hơi hụt hẫng.\n\nAnh thậm chí còn không biết tên cô."
        }
      ]
    },
    {
      "id": "section_11",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_11.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Vài tuần sau, anh lại ngồi chiếc ghế cạnh cửa sổ.\n\nNgoài kia rất nhiều người đang về nhà.\n\nMột anh shipper."
        },
        {
          "id": "section_11.block_02",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cô nhân viên ngân hàng.\n\nMột người bán vé số.\n\nMột cậu sinh viên."
        },
        {
          "id": "section_11.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một người đàn ông mặc vest đang gọi điện với vẻ rất căng thẳng.\n\nanh chợt nghĩ:\n\nMỗi người trên con đường này có lẽ đều đang mang một thứ gì đó."
        },
        {
          "id": "section_11.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một deadline.\n\nMột khoản vay.\n\nMột người sếp."
        },
        {
          "id": "section_11.block_05",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cuộc cãi nhau.\n\nMột đứa con đang bệnh.\n\nMột cuộc phỏng vấn thất bại."
        },
        {
          "id": "section_11.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một giấc mơ chưa làm được.\n\nCó lẽ người requester khiến anh khó chịu hôm trước cũng đang mang một thứ gì đó.\n\nĐiều đó không có nghĩa anh phải chấp nhận mọi cách cư xử."
        },
        {
          "id": "section_11.block_07",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng tự nhiên anh thấy người đó bớt đáng ghét hơn một chút.\n\nChỉ là một con người đang xoay xở với cuộc đời của họ.\n\nGiống anh."
        }
      ]
    },
    {
      "id": "section_12",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_12.block_01",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "anh nhìn đồng hồ.\n\n17:42.\n\nAnh đóng laptop."
        },
        {
          "id": "section_12.block_02",
          "type": "paragraph",
          "style": "transition",
          "text_vi": "Ngày hôm đó vẫn còn một issue chưa giải quyết.\n\nMột email chưa trả lời.\n\nMột architecture chưa hoàn chỉnh."
        },
        {
          "id": "section_12.block_03",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một cuộc họp ngày mai anh không thích.\n\nKhông sao.\n\nNgày mai anh sẽ quay lại làm tiếp."
        },
        {
          "id": "section_12.block_04",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bởi vì một điều chưa hoàn thành ở công ty không có nghĩa là một ngày sống chưa hoàn thành.\n\nAnh bước ra khỏi tòa nhà.\n\nĐiện thoại rung."
        },
        {
          "id": "section_12.block_05",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh lấy ra xem.\n\nCon gái nhắn:"
        },
        {
          "id": "section_12.block_06",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Ba về chưa?”"
        },
        {
          "id": "section_12.block_07",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh gõ:"
        },
        {
          "id": "section_12.block_08",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Ba đang về.”"
        },
        {
          "id": "section_12.block_09",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Rồi cất điện thoại vào túi.\n\nTrên đường về anh mua một ổ bánh mì.\n\nTrời Sài Gòn sau cơn mưa khá mát."
        },
        {
          "id": "section_12.block_10",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Anh chợt nhớ câu nói năm nào:"
        },
        {
          "id": "section_12.block_11",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Nếu tôi để một người làm tôi khó chịu lúc 2 giờ chiều lấy luôn cả buổi tối của tôi, vậy là tôi cho người đó nhiều quá.”"
        },
        {
          "id": "section_12.block_12",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "anh mỉm cười.\n\nCông việc ngày hôm đó không tốt hơn.\n\nSếp cũng chưa thay đổi."
        },
        {
          "id": "section_12.block_13",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "Đồng nghiệp cũng vậy.\n\nNgày mai có lẽ vẫn có những request mơ hồ.\n\nNhưng có một thứ đã thay đổi:"
        },
        {
          "id": "section_12.block_14",
          "type": "paragraph",
          "style": "dialogue_lead",
          "text_vi": "anh lấy lại được buổi tối của mình.\n\nVà đôi khi, vượt qua một môi trường không vui không bắt đầu bằng việc thay đổi cả công ty.\n\nNó bắt đầu bằng một việc nhỏ hơn rất nhiều:"
        },
        {
          "id": "section_12.block_15",
          "type": "pull_quote",
          "text_vi": "Không cho công ty thuê miễn phí căn phòng trong đầu mình sau giờ làm.",
          "attribution_vi": null
        }
      ]
    }
  ],
