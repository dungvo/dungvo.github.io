    ]
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "paragraph_001",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ở một thị trấn nhỏ, có một cửa tiệm kỳ lạ."
        },
        {
          "id": "paragraph_002",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tiệm không bán thức ăn, quần áo hay những món đồ quý giá."
        },
        {
          "id": "paragraph_003",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Tiệm chỉ bán màu."
        },
        {
          "id": "paragraph_004",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người ta đồn rằng những màu sắc ở đây có thể thay đổi cuộc đời một con người."
        },
        {
          "id": "paragraph_005",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai muốn hạnh phúc thì mua màu hồng."
        },
        {
          "id": "paragraph_006",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai muốn thành công thì mua màu vàng."
        },
        {
          "id": "paragraph_007",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ai muốn bình yên thì mua màu xanh."
        },
        {
          "id": "paragraph_008",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Còn màu đen, chẳng ai muốn mua cả."
        },
        {
          "id": "paragraph_009",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một ngày nọ, có một chàng trai trẻ bước vào tiệm."
        },
        {
          "id": "paragraph_010",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh hỏi ông chủ:"
        },
        {
          "id": "paragraph_011",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_011_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cháu muốn mua màu đẹp nhất để vẽ cuộc đời mình.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_012",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ nhìn anh rồi đặt lên bàn một chiếc hộp."
        },
        {
          "id": "paragraph_013",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bên trong có đủ mọi màu sắc."
        },
        {
          "id": "paragraph_014",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chàng trai ngạc nhiên:"
        },
        {
          "id": "paragraph_015",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_015_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cháu chỉ muốn những màu đẹp thôi.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_016",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ đáp:"
        },
        {
          "id": "paragraph_017",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_017_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Vậy cháu cứ chọn.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_018",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh lấy màu hồng, màu vàng, màu xanh và màu trắng."
        },
        {
          "id": "paragraph_019",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh để lại màu xám và màu đen."
        },
        {
          "id": "paragraph_020",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_021",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những năm đầu, bức tranh của chàng trai thật rực rỡ."
        },
        {
          "id": "paragraph_022",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh có những người bạn tốt, một công việc yêu thích và một người con gái anh muốn cùng đi đến cuối cuộc đời."
        },
        {
          "id": "paragraph_023",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh vẽ bầu trời xanh, những cánh đồng vàng và một ngôi nhà nhỏ ngập nắng."
        },
        {
          "id": "paragraph_024",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng rồi mọi chuyện bắt đầu thay đổi."
        },
        {
          "id": "paragraph_025",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Công việc anh yêu thích không còn như trước."
        },
        {
          "id": "paragraph_026",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người anh tin tưởng rời bỏ anh."
        },
        {
          "id": "paragraph_027",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Những dự định từng rất rõ ràng bỗng trở nên xa vời."
        },
        {
          "id": "paragraph_028",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh trở lại cửa tiệm."
        },
        {
          "id": "paragraph_029",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_029_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Ông đã bán cho cháu những màu đẹp nhất. Tại sao bức tranh của cháu vẫn trở nên xấu xí?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_030",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ hỏi:"
        },
        {
          "id": "paragraph_031",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_031_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cháu đã dùng hết màu chưa?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_032",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_032_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Chưa. Cháu vẫn còn rất nhiều màu hồng và màu vàng. Nhưng cháu không biết phải vẽ chúng vào đâu nữa.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_033",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ lấy từ ngăn tủ ra một lọ mực đen."
        },
        {
          "id": "paragraph_034",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_034_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Thử màu này xem.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_035",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chàng trai tức giận:"
        },
        {
          "id": "paragraph_036",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_036_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cuộc đời cháu đã đủ tối rồi. Tại sao ông còn đưa thêm màu đen?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_037",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ không trả lời."
        },
        {
          "id": "paragraph_038",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chỉ dẫn anh đến một căn phòng phía sau cửa tiệm."
        },
        {
          "id": "paragraph_039",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_040",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Trong căn phòng ấy treo rất nhiều bức tranh."
        },
        {
          "id": "paragraph_041",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có bức tranh gần như toàn màu vàng, nhưng người đứng trước nó lại khóc."
        },
        {
          "id": "paragraph_042",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có bức tranh phủ đầy màu xám, nhưng người ngắm lại mỉm cười."
        },
        {
          "id": "paragraph_043",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Có bức tranh rực rỡ đến chói mắt, nhưng không ai muốn nhìn lâu."
        },
        {
          "id": "paragraph_044",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và có một bức tranh rất đơn giản: một căn nhà nhỏ giữa đêm tối, với ánh đèn vàng bên cửa sổ."
        },
        {
          "id": "paragraph_045",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chàng trai đứng trước bức tranh cuối cùng rất lâu."
        },
        {
          "id": "paragraph_046",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_046_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Bức tranh này đẹp thật.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_047",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông chủ hỏi:"
        },
        {
          "id": "paragraph_048",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_048_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Nếu không có bóng đêm, cháu có nhận ra ánh đèn ấy không?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_049",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chàng trai im lặng."
        },
        {
          "id": "paragraph_050",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông nói tiếp:"
        },
        {
          "id": "paragraph_051",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_051_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cháu luôn nghĩ màu hồng là hạnh phúc, màu đen là đau khổ. Nhưng màu sắc tự nó không kể hết câu chuyện.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_052",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_052_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Vậy chỉ cần biết phối màu là cuộc đời sẽ đẹp sao?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_053",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_053_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Không. Có những vết mực cháu không thể xóa. Có những khoảng trời cháu không thể làm sáng lên. Và cũng có những điều đẹp đẽ mất đi mà không có màu nào thay thế được.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_054",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_055",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Chàng trai trở về nhà."
        },
        {
          "id": "paragraph_056",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Lần đầu tiên, anh không cố phủ màu hồng lên những chỗ mình không thích."
        },
        {
          "id": "paragraph_057",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh giữ lại một góc trời xám."
        },
        {
          "id": "paragraph_058",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh vẽ thêm những con đường gập ghềnh."
        },
        {
          "id": "paragraph_059",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Anh dùng màu đen để vẽ bóng của những người đã rời xa mình."
        },
        {
          "id": "paragraph_060",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng bên cạnh đó, anh cũng vẽ một cánh cửa đang mở."
        },
        {
          "id": "paragraph_061",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một buổi sáng mới."
        },
        {
          "id": "paragraph_062",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một người bạn vẫn còn ở lại."
        },
        {
          "id": "paragraph_063",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một hạt mầm vừa nhú lên từ mặt đất."
        },
        {
          "id": "paragraph_064",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bức tranh không trở lại như trước."
        },
        {
          "id": "paragraph_065",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nó có những khoảng tối mà anh không muốn nhìn."
        },
        {
          "id": "paragraph_066",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhưng cũng có những chi tiết mà trước đây anh chưa từng nhận ra."
        },
        {
          "id": "paragraph_067",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_068",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều năm sau, chàng trai trở thành một người đàn ông lớn tuổi."
        },
        {
          "id": "paragraph_069",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Một ngày nọ, con trai ông hỏi:"
        },
        {
          "id": "paragraph_070",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_070_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Cha ơi, nếu được vẽ lại cuộc đời, cha sẽ chọn màu gì?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_071",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông nhìn bức tranh đã theo mình suốt bao năm."
        },
        {
          "id": "paragraph_072",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_072_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Ngày trẻ, cha chỉ muốn màu sáng. Khi gặp khó khăn, cha lại nghĩ cuộc đời mình chỉ toàn màu tối.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_073",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_073_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Bây giờ thì sao?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_074",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_074_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Bây giờ cha biết rằng có những ngày rất đẹp, có những ngày rất buồn. Có những chuyện cha làm được, có những chuyện cha bất lực. Và có những lựa chọn đến giờ cha vẫn chưa biết đúng hay sai.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_075",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu bé suy nghĩ rồi hỏi:"
        },
        {
          "id": "paragraph_076",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_076_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Vậy ai quyết định bức tranh của cha đẹp hay xấu?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_077",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người cha im lặng một lúc."
        },
        {
          "id": "paragraph_078",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_078_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Có lẽ không ai có thể quyết định hoàn toàn điều đó.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_079",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_079_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Ngay cả cha sao?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_080",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_080_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Ngay cả cha.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_081",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Ông đặt vào tay con trai một chiếc hộp màu."
        },
        {
          "id": "paragraph_082",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_082_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Nhưng cha có thể chọn mình sẽ vẽ gì tiếp theo, khi vẫn còn màu và còn chỗ để vẽ.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_083",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Cậu bé mở hộp."
        },
        {
          "id": "paragraph_084",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Bên trong có cả màu đen."
        },
        {
          "id": "paragraph_085",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_085_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Con có cần dùng màu này không?”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_086",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người cha mỉm cười:"
        },
        {
          "id": "paragraph_087",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_087_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Có thể có, có thể không. Nhưng đừng vội vứt nó đi chỉ vì con chưa biết dùng nó vào đâu.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_088",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        },
        {
          "id": "paragraph_089",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Nhiều năm sau nữa, cửa tiệm bán màu đóng cửa."
        },
        {
          "id": "paragraph_090",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Người ta tìm thấy trên cánh cửa một dòng chữ do ông chủ già để lại:"
        },
        {
          "id": "paragraph_091",
          "type": "dialogue",
          "style": "monologue",
          "turns": [
            {
              "id": "paragraph_091_turn",
              "speaker": null,
              "delivery": "spoken",
              "paragraphs": [
                {
                  "text_vi": "“Không ai được chọn tất cả những màu sắc đến với cuộc đời mình. Nhưng mỗi người đều có phần trong cách bức tranh ấy được vẽ nên.”"
                }
              ]
            }
          ]
        },
        {
          "id": "paragraph_092",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "Và bên dưới là một dòng chữ nhỏ hơn:"
        },
        {
          "id": "original_ending_1",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "“Đừng vội gọi một bức tranh là xấu, khi câu chuyện của nó vẫn còn đang tiếp diễn.”"
        },
        {
          "id": "original_ending_2",
          "type": "paragraph",
          "style": "narrative",
          "text_vi": "⸻"
        }
      ]
    }
  ],
