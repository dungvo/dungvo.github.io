  "language": "vi",
  "reader_format": "editorial_v3",
  "title_vi": "TIỆM BÁN MÀU CỦA CUỘC ĐỜI",
  "subtitle_vi": "Ta không chọn được mọi điều xảy đến, nhưng vẫn có phần trong điều sẽ xảy ra tiếp theo.",
  "hero_image": null,
  "primary_theme": "meaning_values",
  "metadata": {
    "concept_ids": [

    ],
    "emotion_tags": [

    ],
    "keywords": [
      "góc nhìn",
      "màu sắc cuộc sống",
      "thay đổi",
      "lựa chọn",
      "chấp nhận"
    ],
    "story_style": "parable",
