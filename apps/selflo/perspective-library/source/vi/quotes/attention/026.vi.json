    {
      "id": "attributed.ralph_waldo_emerson.emerson_past_into_present_hour",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Hiện tại ngàn mắt",
      "text_vi": "Có lẽ một nguyên tắc của sự sáng suốt là đừng chỉ dựa vào ký ức, mà hãy đưa quá khứ về trước hiện tại ngàn mắt để được soi xét, rồi sống trong một ngày mới.",
      "subtitle_vi": null,
      "primary_theme": "attention",
      "authorship": {
        "author_id": "ralph_waldo_emerson",
        "author_name": "Ralph Waldo Emerson",
        "work": "Essays — First Series",
        "source_url": "https://www.gutenberg.org/ebooks/2944",
        "source_language": "en",
        "source_label": "Ralph Waldo Emerson",
        "source_detail": "Self-Reliance. Original: It seems to be a rule of wisdom never to rely on your memory alone, scarcely even in acts of pure memory, but to bring the past for judgment into the thousand-eyed present, and live ever in a new day."
      },
