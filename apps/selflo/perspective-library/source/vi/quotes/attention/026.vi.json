    {
      "id": "attributed.henry_david_thoreau.thoreau_stand_aloof_from_actions",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Lùi lại để nhìn",
      "text_vi": "Bằng một nỗ lực có ý thức, ta có thể lùi lại khỏi hành động và hệ quả của chúng, để mọi điều tốt xấu trôi qua như một dòng nước xiết.",
      "subtitle_vi": null,
      "primary_theme": "attention",
      "authorship": {
        "author_id": "henry_david_thoreau",
        "author_name": "Henry David Thoreau",
        "work": "Walden; Civil Disobedience",
        "source_url": "https://www.gutenberg.org/ebooks/205",
        "source_language": "en",
        "source_label": "Henry David Thoreau",
        "source_detail": "Walden. Original: By a conscious effort of the mind we can stand aloof from actions and their consequences; and all things, good and bad, go by us like a torrent."
