    {
      "id": "attributed.laozi.chapter_02.mutual_arising",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Có và không sinh ra nhau",
      "text_vi": "Có và không sinh ra nhau; khó và dễ thành tựu lẫn nhau; dài và ngắn làm rõ nhau; cao và thấp dựa vào nhau.",
      "subtitle_vi": null,
      "primary_theme": "self_understanding",
      "authorship": {
        "author_id": "laozi",
        "author_name": "Lão Tử",
        "work": "Đạo Đức Kinh",
        "source_url": "https://zh.wikisource.org/zh-hant/%E9%81%93%E5%BE%B7%E7%B6%93_(%E7%8E%8B%E5%BC%BC%E6%9C%AC)#%E4%BA%8C%E7%AB%A0",
        "source_language": "zh",
        "source_label": "Lão Tử · Đạo Đức Kinh",
        "source_detail": "Trích ý bốn cặp đầu chương 2; bản tiếng Việt do owner cung cấp, chưa xác định dịch giả. Đã đối chiếu bản Vương Bật: 有無相生，難易相成，長短相較，高下相傾. Có dị bản 長短相形; không phải toàn bộ chương. Truyện liên kết là bản diễn giải do owner cung cấp, không phải truyện trích từ kinh."
      },
