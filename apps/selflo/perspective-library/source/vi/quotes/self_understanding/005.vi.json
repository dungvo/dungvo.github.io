    {
      "id": "attributed.zhuangzi.chapter_01.rest_beneath_tree",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": null,
      "text_vi": "Có cây lớn mà lo nó vô dụng, sao không trồng nơi đồng rộng, thong dong bên cạnh, thảnh thơi nằm nghỉ dưới tán cây?",
      "subtitle_vi": null,
      "primary_theme": "self_understanding",
      "authorship": {
        "author_id": "zhuangzi",
        "author_name": "Trang Tử",
        "work": "Trang Tử · Tiêu dao du (chương 1)",
        "source_url": "https://ctext.org/zhuangzi/enjoyment-in-untroubled-ease/zh",
        "source_language": "zh",
        "source_label": "Trang Tử · Trang Tử · Tiêu dao du (chương 1)",
        "source_detail": "Bản Việt dịch/diễn ý Selflo từ đoạn cổ: 今子有大樹，患其無用，何不樹之於無何有之鄉，廣莫之野，彷徨乎無為其側，逍遙乎寢臥其下？ Không phải trích một bản dịch Việt đã xuất bản. Ghi tên tác giả theo quy ước thư mục của tác phẩm."
      },
      "metadata": {
        "concepts": [],
        "theories": [],
