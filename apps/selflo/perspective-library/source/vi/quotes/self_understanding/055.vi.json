        "author_name": "Ralph Waldo Emerson",
        "work": "Essays — First Series",
        "source_url": "https://www.gutenberg.org/ebooks/2944",
        "source_language": "en",
        "source_label": "Ralph Waldo Emerson",
        "source_detail": "History. Original: A mind might ponder its thought for ages and not gain so much self-knowledge as the passion of love shall teach it in a day."
      },
