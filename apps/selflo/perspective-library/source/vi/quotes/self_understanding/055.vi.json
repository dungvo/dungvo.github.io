    {
      "id": "attributed.ralph_waldo_emerson.emerson_common_wisdom_silenced",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Minh triết chung của con người",
      "text_vi": "Có một thứ minh triết chung của con người, hiện diện ở cả người cao sang lẫn thấp kém nhất, nhưng nền giáo dục thông thường nhiều khi lại cố làm nó im tiếng.",
