    {
      "id": "attributed.henry_david_thoreau.thoreau_change_convulses_body",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Thay đổi làm ta chấn động",
      "text_vi": "Mọi thay đổi theo hướng tốt hơn cũng giống như sinh và tử: nó làm toàn thân ta chấn động.",
      "subtitle_vi": null,
      "primary_theme": "change_growth",
      "authorship": {
        "author_id": "henry_david_thoreau",
        "author_name": "Henry David Thoreau",
        "work": "Walden; Civil Disobedience",
        "source_url": "https://www.gutenberg.org/ebooks/205",
        "source_language": "en",
        "source_label": "Henry David Thoreau",
        "source_detail": "Walden. Original: So is all change for the better, like birth and death which convulse the body."
      },
