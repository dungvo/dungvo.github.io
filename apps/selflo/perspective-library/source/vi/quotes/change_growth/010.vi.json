    {
      "id": "attributed.william_james.james_habits_can_be_courage",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Thói quen cũng có thể là can đảm",
      "text_vi": "Người ta nói về thói quen hút thuốc, chửi thề hay uống rượu, nhưng ít nói về thói quen tiết chế, chừng mực hay can đảm.",
      "subtitle_vi": null,
      "primary_theme": "change_growth",
      "authorship": {
        "author_id": "william_james",
        "author_name": "William James",
        "work": "Talks to Teachers on Psychology",
        "source_url": "https://www.gutenberg.org/ebooks/16287",
        "source_language": "en",
        "source_label": "William James",
        "source_detail": "Habit. Original: They talk of the smoking-habit and the swearing-habit and the drinking-habit, but not of the abstention-habit or the moderation-habit or the courage-habit."
      },
