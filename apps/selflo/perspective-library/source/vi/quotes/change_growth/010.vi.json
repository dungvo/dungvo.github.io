    {
      "id": "attributed.william_james.james_bundles_of_habit",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Sao chép mình của ngày trước",
      "text_vi": "Khi chỉ còn là một bó thói quen, ta trở thành những sinh thể rập khuôn, cứ bắt chước và sao chép chính mình của ngày trước.",
      "subtitle_vi": null,
      "primary_theme": "change_growth",
      "authorship": {
        "author_id": "william_james",
        "author_name": "William James",
        "work": "Talks to Teachers on Psychology",
        "source_url": "https://www.gutenberg.org/ebooks/16287",
        "source_language": "en",
        "source_label": "William James",
        "source_detail": "Habit. Original: So far as we are thus mere bundles of habit, we are stereotyped creatures, imitators and copiers of our past selves."
      },
