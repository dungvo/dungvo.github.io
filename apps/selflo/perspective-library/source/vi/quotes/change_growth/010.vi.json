    {
      "id": "attributed.henry_david_thoreau.thoreau_return_with_new_experience",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Mỗi ngày trở về khác đi",
      "text_vi": "Mỗi ngày, ta nên trở về nhà từ một nơi xa, từ những cuộc phiêu lưu, hiểm nguy và khám phá, mang theo một trải nghiệm và một phần tính cách mới.",
      "subtitle_vi": null,
      "primary_theme": "change_growth",
      "authorship": {
        "author_id": "henry_david_thoreau",
        "author_name": "Henry David Thoreau",
        "work": "Walden; Civil Disobedience",
        "source_url": "https://www.gutenberg.org/ebooks/205",
        "source_language": "en",
        "source_label": "Henry David Thoreau",
        "source_detail": "Walden. Original: We should come home from far, from adventures, and perils, and discoveries every day, with new experience and character."
      },
