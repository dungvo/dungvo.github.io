    {
      "id": "attributed.ralph_waldo_emerson.emerson_voice_tenderness_truth_courage",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Giọng người đang sống",
      "text_vi": "Âm nhạc ngọt ngào nhất không nằm trong những bản đại hợp xướng, mà trong giọng người khi nó cất lên từ một khoảnh khắc sống động của dịu dàng, chân thật hoặc can đảm.",
      "subtitle_vi": null,
      "primary_theme": "relationships",
      "authorship": {
        "author_id": "ralph_waldo_emerson",
        "author_name": "Ralph Waldo Emerson",
        "work": "Essays — First Series",
        "source_url": "https://www.gutenberg.org/ebooks/2944",
        "source_language": "en",
        "source_label": "Ralph Waldo Emerson",
        "source_detail": "Art. Original: The sweetest music is not in the oratorio, but in the human voice when it speaks from its instant life tones of tenderness, truth, or courage."
      },
