    {
      "id": "attributed.francis_bacon.bacon_power_over_others_lose_self",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Quyền lực và tự do",
      "text_vi": "Thật là một ham muốn kỳ lạ: tìm kiếm quyền lực rồi đánh mất tự do; muốn có quyền trên người khác nhưng lại mất quyền làm chủ chính mình.",
      "subtitle_vi": null,
      "primary_theme": "work_achievement",
      "authorship": {
        "author_id": "francis_bacon",
        "author_name": "Francis Bacon",
        "work": "The Essays of Francis Bacon",
        "source_url": "https://www.gutenberg.org/ebooks/575",
        "source_language": "en",
        "source_label": "Francis Bacon",
        "source_detail": "Of Great Place. Original: It is a strange desire, to seek power and to lose liberty: or to seek power over others, and to lose power over a man's self."
