      "id": "attributed.henry_david_thoreau.thoreau_corporation_with_conscience",
      "revision": 1,
      "kind": "adapted_wisdom",
      "title_vi": "Lương tâm của một tổ chức",
      "text_vi": "Một tổ chức tự nó không có lương tâm; nhưng một tổ chức gồm những con người có lương tâm thì có.",
      "subtitle_vi": null,
      "primary_theme": "work_achievement",
      "authorship": {
