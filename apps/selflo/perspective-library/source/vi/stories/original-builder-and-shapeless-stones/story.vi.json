{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_builder_and_shapeless_stones",
  "revision": 1,
  "status": "draft",
  "language": "vi",
  "title_vi": "Người thợ xây và những viên đá không có hình — Bản gốc",
  "subtitle_vi": "Một người học cách không mang sự hỗn loạn của người khác về nhà trong đầu mình.",
  "hero_image": null,
  "primary_theme": "work_achievement",
  "metadata": {
    "concept_ids": [
      "concept.overthinking"
    ],
    "emotion_tags": [
      "frustration",
      "uncertainty"
    ],
    "keywords": [
      "yêu cầu mơ hồ",
      "ranh giới trách nhiệm",
      "công việc trong đầu",
      "viên đá"
    ],
    "story_style": "parable"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": "Lời dẫn",
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Tôi kể bạn một câu chuyện. Không phải câu chuyện về cách làm slide, mà về một người học cách không mang sự hỗn loạn của người khác về nhà trong đầu mình."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "Câu chuyện",
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Có một người thợ xây tên Minh."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Minh đã làm nghề nhiều năm. Anh rất giỏi xây những bức tường chắc chắn, miễn là người ta nói cho anh biết bức tường ở đâu, cao bao nhiêu và dùng để làm gì."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "Một ngày, ông chủ làng đến gặp anh."
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "“Ba ngày nữa tôi cần một bức tường ở quảng trường.”"
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "text_vi": "Minh hỏi:"
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "“Dài bao nhiêu?”"
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "“Anh xem rồi quyết định.”"
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "“Cao bao nhiêu?”"
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "text_vi": "“Đủ cao.”"
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "“Để chắn gió, bảo vệ người hay trang trí?”"
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "“Cái nào cũng quan trọng.”"
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "“Có bản vẽ không?”"
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "“Chưa có. Nhưng việc này gấp.”"
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "Rồi ông chủ đi."
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "text_vi": "Minh đứng nhìn đống đá và bắt đầu tức giận."
        },
        {
          "id": "section_02.block_16",
          "type": "pull_quote",
          "text_vi": "“Người gì mà kỳ vậy? Muốn người khác làm nhưng chính mình còn chẳng biết mình muốn gì.”",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_17",
          "type": "paragraph",
          "text_vi": "Anh nhặt một viên đá lên, đặt xuống."
        },
        {
          "id": "section_02.block_18",
          "type": "paragraph",
          "text_vi": "Lại nghĩ:"
        },
        {
          "id": "section_02.block_19",
          "type": "pull_quote",
          "text_vi": "“Ba ngày nữa mà bây giờ còn như thế này.”",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_20",
          "type": "paragraph",
          "text_vi": "Anh đi ăn cơm."
        },
        {
          "id": "section_02.block_21",
          "type": "paragraph",
          "text_vi": "Nhưng trong đầu vẫn xây tường."
        },
        {
          "id": "section_02.block_22",
          "type": "paragraph",
          "text_vi": "Anh chơi với con."
        },
        {
          "id": "section_02.block_23",
          "type": "paragraph",
          "text_vi": "Trong đầu vẫn cãi nhau với ông chủ làng."
        },
        {
          "id": "section_02.block_24",
          "type": "paragraph",
          "text_vi": "Anh nằm xuống ngủ."
        },
        {
          "id": "section_02.block_25",
          "type": "paragraph",
          "text_vi": "Trong đầu vẫn có một phiên bản khác của cuộc nói chuyện:"
        },
        {
          "id": "section_02.block_26",
          "type": "paragraph",
          "text_vi": "“Lúc đó đáng lẽ mình phải hỏi ông ấy câu này.”"
        },
        {
          "id": "section_02.block_27",
          "type": "paragraph",
          "text_vi": "“Tại sao trách nhiệm lại đẩy sang mình?”"
        },
        {
          "id": "section_02.block_28",
          "type": "paragraph",
          "text_vi": "“Nếu ba ngày nữa không xong thì sao?”"
        },
        {
          "id": "section_02.block_29",
          "type": "paragraph",
          "text_vi": "Bức tường ngoài quảng trường chưa được xây."
        },
        {
          "id": "section_02.block_30",
          "type": "paragraph",
          "text_vi": "Nhưng Minh đã xây hàng trăm bức tường trong đầu mình."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau, một người thợ già đi ngang qua."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Ông thấy Minh ngồi trước đống đá."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "“Con đang xây gì vậy?”"
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Minh kể lại mọi chuyện."
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "text_vi": "Người thợ già cười:"
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "“Ta thấy ông chủ chỉ đưa cho con một đống đá. Nhưng tối qua con đã tự mang cả đống đá đó về nhà.”"
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "Minh không hiểu."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "Ông già lấy một viên đá lên."
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "text_vi": "“Viên này là việc của con.”"
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Ông đặt nó sang bên phải."
        },
        {
          "id": "section_03.block_11",
          "type": "paragraph",
          "text_vi": "Rồi lấy viên khác."
        },
        {
          "id": "section_03.block_12",
          "type": "paragraph",
          "text_vi": "“Viên này là việc của ông chủ.”"
        },
        {
          "id": "section_03.block_13",
          "type": "paragraph",
          "text_vi": "Ông đặt sang bên trái."
        },
        {
          "id": "section_03.block_14",
          "type": "paragraph",
          "text_vi": "“Con không biết bức tường dùng để làm gì — đó là một câu hỏi.”"
        },
        {
          "id": "section_03.block_15",
          "type": "paragraph",
          "text_vi": "Một viên sang phải."
        },
        {
          "id": "section_03.block_16",
          "type": "paragraph",
          "text_vi": "“Ông chủ không nói rõ mình muốn gì — đó không phải lỗi con cần sửa trong đầu.”"
        },
        {
          "id": "section_03.block_17",
          "type": "paragraph",
          "text_vi": "Một viên sang trái."
        },
        {
          "id": "section_03.block_18",
          "type": "paragraph",
          "text_vi": "“Deadline ba ngày — đó là constraint.”"
        },
        {
          "id": "section_03.block_19",
          "type": "paragraph",
          "text_vi": "Sang phải."
        },
        {
          "id": "section_03.block_20",
          "type": "paragraph",
          "text_vi": "“Ông ấy làm con khó chịu — đó là cảm xúc. Nó có thật, nhưng nó không phải viên đá để xây tường.”"
        },
        {
          "id": "section_03.block_21",
          "type": "paragraph",
          "text_vi": "Ông đặt viên đó xuống đất."
        },
        {
          "id": "section_03.block_22",
          "type": "paragraph",
          "text_vi": "Cuối cùng, trước mặt Minh chỉ còn ba viên đá."
        },
        {
          "id": "section_03.block_23",
          "type": "paragraph",
          "text_vi": "Người thợ già nói:"
        },
        {
          "id": "section_03.block_24",
          "type": "paragraph",
          "text_vi": "“Con thấy không? Công việc thực sự của con nhỏ hơn rất nhiều so với công việc con đã làm trong đầu tối qua.”"
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "text_vi": "Minh hỏi:"
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "text_vi": "“Nhưng nếu ông ấy vẫn không trả lời thì sao?”"
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "text_vi": "Người thợ già nói:"
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "text_vi": "“Thì con xây phần có thể xây và để trống phần chưa có thông tin.”"
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "text_vi": "“Nhưng nếu ông ấy không hài lòng?”"
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "text_vi": "“Thì ông ấy sẽ cho con thêm một thông tin mà hôm nay con chưa có.”"
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "text_vi": "Minh lại hỏi:"
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "text_vi": "“Còn nếu ông ấy trách tôi?”"
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "text_vi": "Ông già nhìn Minh:"
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "text_vi": "“Con đang nhặt viên đá của ngày mai rồi.”"
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "text_vi": "Minh im lặng."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "text_vi": "Ngày hôm đó Minh không cố xây cả bức tường."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "text_vi": "Anh đóng ba cây cọc xuống đất."
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "text_vi": "Trên cây thứ nhất anh viết:"
        },
        {
          "id": "section_05.block_04",
          "type": "pull_quote",
          "text_vi": "ĐIỀU ĐÃ BIẾT.",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "text_vi": "Cây thứ hai:"
        },
        {
          "id": "section_05.block_06",
          "type": "pull_quote",
          "text_vi": "ĐIỀU ĐANG GIẢ ĐỊNH.",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "text_vi": "Cây thứ ba:"
        },
        {
          "id": "section_05.block_08",
          "type": "pull_quote",
          "text_vi": "ĐIỀU CẦN NGƯỜI KHÁC XÁC NHẬN.",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "text_vi": "Rồi anh bắt đầu xây."
        },
        {
          "id": "section_05.block_10",
          "type": "paragraph",
          "text_vi": "Đến chiều, bức tường chỉ cao đến đầu gối."
        },
        {
          "id": "section_05.block_11",
          "type": "paragraph",
          "text_vi": "Ông chủ làng đến và nói:"
        },
        {
          "id": "section_05.block_12",
          "type": "paragraph",
          "text_vi": "“Không, không. Tôi muốn lối đi nằm bên kia.”"
        },
        {
          "id": "section_05.block_13",
          "type": "paragraph",
          "text_vi": "Ngày hôm trước, có lẽ Minh sẽ nổi giận."
        },
        {
          "id": "section_05.block_14",
          "type": "paragraph",
          "text_vi": "Nhưng lần này anh chỉ nhìn cây cọc thứ hai."
        },
        {
          "id": "section_05.block_15",
          "type": "paragraph",
          "text_vi": "Anh gạch đi một dòng trong phần GIẢ ĐỊNH, rồi viết thông tin mới vào phần ĐÃ BIẾT."
        },
        {
          "id": "section_05.block_16",
          "type": "paragraph",
          "text_vi": "Và tiếp tục xây."
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "text_vi": "Nhiều năm sau Minh trở thành người thợ giỏi nhất vùng."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "text_vi": "Không phải vì anh không còn gặp những ông chủ mơ hồ."
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "text_vi": "Anh vẫn gặp."
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "text_vi": "Không phải vì anh không bao giờ tức."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "text_vi": "Anh vẫn tức."
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "text_vi": "Mà bởi anh học được một kỹ năng kỳ lạ:"
        },
        {
          "id": "section_06.block_07",
          "type": "pull_quote",
          "text_vi": "Anh biết viên đá nào cần mang, và viên đá nào phải để lại nơi người khác đặt nó xuống.",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "text_vi": "Tôi nghĩ có một ý trong câu chuyện này đáng giữ lại."
        },
        {
          "id": "section_07.block_02",
          "type": "paragraph",
          "text_vi": "Khi requester đưa cho bạn một yêu cầu mơ hồ, rất dễ để trong đầu xuất hiện hai bài toán cùng lúc:"
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "text_vi": "Bài toán 1: Làm thế nào để giải quyết công việc này?"
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "text_vi": "Bài toán 2: Tại sao người ta lại giao cho mình một thứ mơ hồ như thế này? Tại sao họ không suy nghĩ cho rõ trước? Tại sao mình phải chịu?"
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "text_vi": "Bài toán 1 có thể khó."
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "text_vi": "Nhưng bài toán 2 mới là thứ có thể ăn cả buổi tối của mình."
        },
        {
          "id": "section_07.block_07",
          "type": "paragraph",
          "text_vi": "Và có một sự thông cảm cho cả hai phía mà tôi thấy khá hữu ích:"
        },
        {
          "id": "section_07.block_08",
          "type": "paragraph",
          "text_vi": "Requester đôi khi cũng chỉ đang chuyển tiếp một sự mơ hồ mà chính họ đang phải chịu. Họ có deadline từ cấp trên, BU gây áp lực, chưa hiểu technical, hoặc đơn giản họ cũng chưa biết solution là gì."
        },
        {
          "id": "section_07.block_09",
          "type": "paragraph",
          "text_vi": "Điều đó không làm yêu cầu mơ hồ trở thành yêu cầu tốt."
        },
        {
          "id": "section_07.block_10",
          "type": "paragraph",
          "text_vi": "Nhưng nó giúp mình chuyển từ:"
        },
        {
          "id": "section_07.block_11",
          "type": "pull_quote",
          "text_vi": "“Tại sao người này lại làm khó mình?”",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_12",
          "type": "paragraph",
          "text_vi": "thành:"
        },
        {
          "id": "section_07.block_13",
          "type": "pull_quote",
          "text_vi": "“À, hệ thống đang có một cục mơ hồ. Bây giờ nó đi đến chỗ mình. Phần của mình là làm cho nó rõ thêm một chút.”",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_14",
          "type": "paragraph",
          "text_vi": "Và cũng nên thông cảm cho chính mình."
        },
        {
          "id": "section_07.block_15",
          "type": "paragraph",
          "text_vi": "Một Data Architect không phải là người mà khi người khác ném một câu hỏi vào, trong 30 phút phải xuất hiện một architecture hoàn chỉnh."
        },
        {
          "id": "section_07.block_16",
          "type": "paragraph",
          "text_vi": "Có những ngày công việc tốt nhất bạn làm được chỉ là:"
        },
        {
          "id": "section_07.block_17",
          "type": "pull_quote",
          "text_vi": "Hôm qua có 20 điều chưa biết.  \nHôm nay còn 12.",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_18",
          "type": "paragraph",
          "text_vi": "Đó vẫn là tiến bộ."
        },
        {
          "id": "section_07.block_19",
          "type": "paragraph",
