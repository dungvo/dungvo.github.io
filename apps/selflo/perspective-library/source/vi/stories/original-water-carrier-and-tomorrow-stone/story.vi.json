{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_water_carrier_and_tomorrow_stone",
  "revision": 1,
  "status": "draft",
  "language": "vi",
  "title_vi": "Người gánh nước và hòn đá của ngày mai — Bản gốc",
  "subtitle_vi": "Có những thứ không nặng vì bản thân nó lớn; nó nặng vì ta giữ nó quá lâu.",
  "hero_image": null,
  "primary_theme": "attention",
  "metadata": {
    "concept_ids": [
      "concept.overthinking"
    ],
    "emotion_tags": [
      "anxiety",
      "uncertainty"
    ],
    "keywords": [
      "lo ngày mai",
      "hòn đá",
      "gánh nước",
      "đặt xuống"
    ],
    "story_style": "parable"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Có một ngôi làng nhỏ nằm giữa hai ngọn núi."
        },
        {
          "id": "section_01.block_02",
          "type": "paragraph",
          "text_vi": "Trong làng có một người đàn ông tên An."
        },
        {
          "id": "section_01.block_03",
          "type": "paragraph",
          "text_vi": "Mỗi sáng trước khi mặt trời mọc, An đặt hai chiếc thùng lên một cây đòn gỗ rồi đi xuống thung lũng lấy nước."
        },
        {
          "id": "section_01.block_04",
          "type": "paragraph",
          "text_vi": "Một thùng bên trái."
        },
        {
          "id": "section_01.block_05",
          "type": "paragraph",
          "text_vi": "Một thùng bên phải."
        },
        {
          "id": "section_01.block_06",
          "type": "paragraph",
          "text_vi": "Anh làm công việc ấy đã gần hai mươi năm."
        },
        {
          "id": "section_01.block_07",
          "type": "paragraph",
          "text_vi": "Ngày còn trẻ, An thường vừa đi vừa hát."
        },
        {
          "id": "section_01.block_08",
          "type": "paragraph",
          "text_vi": "Nhưng càng lớn tuổi, con đường dường như càng dốc."
        },
        {
          "id": "section_01.block_09",
          "type": "paragraph",
          "text_vi": "Không phải ngọn núi cao thêm."
        },
        {
          "id": "section_01.block_10",
          "type": "paragraph",
          "text_vi": "Chỉ là trên vai anh có thêm nhiều thứ."
        },
        {
          "id": "section_01.block_11",
          "type": "paragraph",
          "text_vi": "Tiền học của con."
        },
        {
          "id": "section_01.block_12",
          "type": "paragraph",
          "text_vi": "Thuốc của cha."
        },
        {
          "id": "section_01.block_13",
          "type": "paragraph",
          "text_vi": "Mái nhà bắt đầu dột."
        },
        {
          "id": "section_01.block_14",
          "type": "paragraph",
          "text_vi": "Một khoản nợ chưa trả."
        },
        {
          "id": "section_01.block_15",
          "type": "paragraph",
          "text_vi": "Và một người chủ thỉnh thoảng nổi nóng chẳng vì lý do gì."
        },
        {
          "id": "section_01.block_16",
          "type": "paragraph",
          "text_vi": "Có những sáng An chưa bước xuống giường mà trong đầu đã đi hết cả ngày."
        },
        {
          "id": "section_01.block_17",
          "type": "paragraph",
          "text_vi": "“Hôm nay ông chủ hỏi chuyện hôm qua thì sao?”"
        },
        {
          "id": "section_01.block_18",
          "type": "paragraph",
          "text_vi": "“Nếu tháng này thiếu tiền thì sao?”"
        },
        {
          "id": "section_01.block_19",
          "type": "paragraph",
          "text_vi": "“Nếu cha lại phải vào viện thì sao?”"
        },
        {
          "id": "section_01.block_20",
          "type": "paragraph",
          "text_vi": "“Nếu con cần thêm tiền học thì sao?”"
        },
        {
          "id": "section_01.block_21",
          "type": "paragraph",
          "text_vi": "Một sáng nọ, An mệt đến mức ngồi rất lâu bên đường."
        },
        {
          "id": "section_01.block_22",
          "type": "paragraph",
          "text_vi": "Một ông lão chăn dê đi ngang qua."
        },
        {
          "id": "section_01.block_23",
          "type": "paragraph",
          "text_vi": "Ông hỏi:"
        },
        {
          "id": "section_01.block_24",
          "type": "paragraph",
          "text_vi": "“Anh đang mang gì mà nặng vậy?”"
        },
        {
          "id": "section_01.block_25",
          "type": "paragraph",
          "text_vi": "An hơi khó chịu."
        },
        {
          "id": "section_01.block_26",
          "type": "paragraph",
          "text_vi": "“Ông không thấy sao? Hai thùng nước.”"
        },
        {
          "id": "section_01.block_27",
          "type": "paragraph",
          "text_vi": "Ông lão nhìn hai chiếc thùng rồi nói:"
        },
        {
          "id": "section_01.block_28",
          "type": "paragraph",
          "text_vi": "“Ta thấy hai thùng nước. Nhưng hình như anh đang mang cả ngày mai nữa.”"
        },
        {
          "id": "section_01.block_29",
          "type": "paragraph",
          "text_vi": "An không hiểu."
        },
        {
          "id": "section_01.block_30",
          "type": "paragraph",
          "text_vi": "Ông lão ngồi xuống bên cạnh."
        },
        {
          "id": "section_01.block_31",
          "type": "paragraph",
          "text_vi": "Ông nhặt một hòn đá lên."
        },
        {
          "id": "section_01.block_32",
          "type": "paragraph",
          "text_vi": "“Anh cầm thử.”"
        },
        {
          "id": "section_01.block_33",
          "type": "paragraph",
          "text_vi": "An cầm."
        },
        {
          "id": "section_01.block_34",
          "type": "paragraph",
          "text_vi": "“Có nặng không?”"
        },
        {
          "id": "section_01.block_35",
          "type": "paragraph",
          "text_vi": "“Không.”"
        },
        {
          "id": "section_01.block_36",
          "type": "paragraph",
          "text_vi": "“Vậy giữ nó đến chiều.”"
        },
        {
          "id": "section_01.block_37",
          "type": "paragraph",
          "text_vi": "An cười."
        },
        {
          "id": "section_01.block_38",
          "type": "paragraph",
          "text_vi": "“Một hòn đá nhỏ thế này thì có gì đâu.”"
        },
        {
          "id": "section_01.block_39",
          "type": "paragraph",
          "text_vi": "Ông lão lắc đầu."
        },
        {
          "id": "section_01.block_40",
          "type": "paragraph",
          "text_vi": "“Đến chiều tay anh sẽ hiểu điều đầu anh chưa hiểu.”"
        },
        {
          "id": "section_01.block_41",
          "type": "paragraph",
          "text_vi": "Rồi ông bỏ đi."
        },
        {
          "id": "section_01.block_42",
          "type": "paragraph",
          "text_vi": "An tiếp tục xuống núi."
        },
        {
          "id": "section_01.block_43",
          "type": "paragraph",
          "text_vi": "Ban đầu hòn đá chẳng đáng kể."
        },
        {
          "id": "section_01.block_44",
          "type": "paragraph",
          "text_vi": "Một giờ sau, bàn tay bắt đầu mỏi."
        },
        {
          "id": "section_01.block_45",
          "type": "paragraph",
          "text_vi": "Hai giờ sau, anh chuyển sang tay kia."
        },
        {
          "id": "section_01.block_46",
          "type": "paragraph",
          "text_vi": "Đến trưa, An bực mình ném hòn đá xuống đất."
        },
        {
          "id": "section_01.block_47",
          "type": "paragraph",
          "text_vi": "Ngay lúc ấy anh hiểu."
        },
        {
          "id": "section_01.block_48",
          "type": "pull_quote",
          "text_vi": "Có những thứ không nặng vì bản thân nó lớn.",
          "attribution_vi": null
        },
        {
          "id": "section_01.block_49",
          "type": "pull_quote",
          "text_vi": "Nó nặng vì ta giữ nó quá lâu.",
          "attribution_vi": null
        },
        {
          "id": "section_01.block_50",
          "type": "paragraph",
          "text_vi": "Tối hôm đó An lại lo chuyện ngày mai."
        },
        {
          "id": "section_01.block_51",
          "type": "paragraph",
          "text_vi": "Anh nhớ tới hòn đá."
        },
        {
          "id": "section_01.block_52",
          "type": "paragraph",
          "text_vi": "Anh tự hỏi:"
        },
        {
          "id": "section_01.block_53",
          "type": "paragraph",
          "text_vi": "“Ông chủ ngày mai có hỏi mình không?”"
        },
        {
          "id": "section_01.block_54",
          "type": "paragraph",
          "text_vi": "Có thể."
        },
        {
          "id": "section_01.block_55",
          "type": "paragraph",
          "text_vi": "“Ông ấy có nổi giận không?”"
        },
        {
          "id": "section_01.block_56",
          "type": "paragraph",
          "text_vi": "Có thể."
        },
        {
          "id": "section_01.block_57",
          "type": "paragraph",
          "text_vi": "“Mình có giải quyết được hết không?”"
        },
        {
          "id": "section_01.block_58",
          "type": "paragraph",
          "text_vi": "Không biết."
        },
        {
          "id": "section_01.block_59",
          "type": "paragraph",
          "text_vi": "An ngồi suy nghĩ rất lâu."
        },
        {
          "id": "section_01.block_60",
          "type": "paragraph",
          "text_vi": "Rồi lần đầu tiên anh hỏi một câu khác:"
        },
        {
          "id": "section_01.block_61",
          "type": "pull_quote",
          "text_vi": "“Nhưng chuyện đó đang xảy ra chưa?”",
          "attribution_vi": null
        },
        {
          "id": "section_01.block_62",
          "type": "paragraph",
          "text_vi": "Chưa."
        },
        {
          "id": "section_01.block_63",
          "type": "paragraph",
          "text_vi": "Anh đặt nó xuống."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau, An lại gánh nước xuống núi."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Ông chủ quả nhiên gọi anh lại."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "“An! Việc hôm qua tại sao chưa xong?”"
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "Tim An đập nhanh."
        },
        {
          "id": "section_02.block_05",
          "type": "paragraph",
          "text_vi": "Nỗi sợ tối qua quay trở lại."
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "Nhưng lần này anh không chạy trước nó."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "Anh nói:"
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "“Phần tôi làm được đã xong. Còn một phần tôi chưa biết phải xử lý thế nào. Hôm nay tôi sẽ tiếp tục.”"
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "text_vi": "Ông chủ không hài lòng."
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "Ông nói khá nặng lời."
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "An đứng nghe."
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "Lạ thay, bầu trời không sập xuống."
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "Mặt trời vẫn ở đó."
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "Mấy con chim vẫn bay qua mái nhà."
        },
        {
          "id": "section_02.block_15",
          "type": "paragraph",
          "text_vi": "Nói xong, ông chủ bỏ đi."
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "text_vi": "An cúi xuống, đặt hai thùng nước lên vai và tiếp tục công việc."
        },
        {
          "id": "section_02.block_17",
          "type": "paragraph",
          "text_vi": "Buổi trưa anh vẫn ăn."
        },
        {
          "id": "section_02.block_18",
          "type": "paragraph",
          "text_vi": "Buổi chiều anh vẫn về nhà."
        },
        {
          "id": "section_02.block_19",
          "type": "paragraph",
          "text_vi": "Tối đó con gái chạy ra ôm chân anh."
        },
        {
          "id": "section_02.block_20",
          "type": "paragraph",
          "text_vi": "Không ai trong nhà hỏi:"
        },
        {
          "id": "section_02.block_21",
          "type": "paragraph",
          "text_vi": "“Hôm nay ông chủ đánh giá cha thế nào?”"
        },
        {
          "id": "section_02.block_22",
          "type": "paragraph",
          "text_vi": "Con bé chỉ hỏi:"
        },
        {
          "id": "section_02.block_23",
          "type": "paragraph",
          "text_vi": "“Cha về rồi hả?”"
        },
        {
          "id": "section_02.block_24",
          "type": "paragraph",
          "text_vi": "An nhìn nó thật lâu."
        },
        {
          "id": "section_02.block_25",
          "type": "paragraph",
          "text_vi": "Anh chợt nhận ra một điều rất đơn giản."
        },
        {
          "id": "section_02.block_26",
          "type": "paragraph",
          "text_vi": "Suốt nhiều năm anh tưởng mình đi làm để chứng minh rằng mình đủ giỏi."
        },
        {
          "id": "section_02.block_27",
          "type": "paragraph",
          "text_vi": "Nhưng thật ra phần lớn những buổi sáng anh bước xuống núi chỉ vì có vài người đang đợi anh trở về."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Nhiều năm sau, cha của An mất."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Các con anh lớn lên."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "Người chủ năm xưa cũng nghỉ việc."
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Một hôm An đã già, ngồi trước cửa nhà nhìn ngọn núi."
        },
        {
          "id": "section_03.block_05",
          "type": "paragraph",
          "text_vi": "Con trai hỏi:"
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "“Cha đã đi con đường ấy mấy chục năm. Ngày nào khó nhất?”"
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "An suy nghĩ."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "Anh nhớ những ngày thiếu tiền."
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "text_vi": "Những lần bị trách."
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Những đêm cha nằm viện."
        },
        {
          "id": "section_03.block_11",
          "type": "paragraph",
          "text_vi": "Những buổi sáng anh chỉ muốn nằm lại trên giường."
        },
        {
          "id": "section_03.block_12",
          "type": "paragraph",
          "text_vi": "Nhưng cuối cùng anh nói:"
        },
        {
          "id": "section_03.block_13",
          "type": "paragraph",
          "text_vi": "“Cha không nhớ.”"
        },
        {
          "id": "section_03.block_14",
          "type": "paragraph",
          "text_vi": "Người con ngạc nhiên."
        },
        {
          "id": "section_03.block_15",
          "type": "paragraph",
          "text_vi": "“Những chuyện lớn như vậy mà cha không nhớ sao?”"
        },
        {
          "id": "section_03.block_16",
          "type": "paragraph",
          "text_vi": "An cười."
        },
        {
          "id": "section_03.block_17",
          "type": "paragraph",
          "text_vi": "“Lúc đang ở trong nó, cha tưởng nó sẽ theo cha cả đời.”"
        },
        {
          "id": "section_03.block_18",
          "type": "paragraph",
          "text_vi": "“Nhưng rồi sao?”"
        },
        {
          "id": "section_03.block_19",
          "type": "paragraph",
          "text_vi": "“Rồi ngày hôm sau đến.”"
        },
        {
          "id": "section_03.block_20",
          "type": "paragraph",
          "text_vi": "Anh chỉ lên con đường xuống núi."
        },
        {
          "id": "section_03.block_21",
          "type": "paragraph",
          "text_vi": "“Có ngày trời nắng.”"
        },
        {
          "id": "section_03.block_22",
          "type": "paragraph",
          "text_vi": "“Có ngày trời mưa.”"
        },
        {
          "id": "section_03.block_23",
          "type": "paragraph",
          "text_vi": "“Có ngày cha đi rất khỏe.”"
        },
        {
          "id": "section_03.block_24",
          "type": "paragraph",
          "text_vi": "“Có ngày mỗi bước đều nặng.”"
        },
        {
          "id": "section_03.block_25",
          "type": "paragraph",
          "text_vi": "“Ngày trước cha cứ mong tìm được một con đường chỉ có nắng.”"
        },
        {
          "id": "section_03.block_26",
          "type": "paragraph",
          "text_vi": "“Sau này cha mới hiểu…”"
        },
        {
          "id": "section_03.block_27",
          "type": "paragraph",
          "text_vi": "An nhìn về phía hai sườn núi, nơi một bên đang sáng lên trong ánh chiều còn một bên đã chìm vào bóng tối."
        },
        {
          "id": "section_03.block_28",
          "type": "pull_quote",
          "text_vi": "“Nếu chỉ có ánh sáng, ta sẽ chẳng biết ánh sáng là gì.”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_29",
          "type": "paragraph",
          "text_vi": "Người con im lặng."
        },
        {
          "id": "section_03.block_30",
          "type": "paragraph",
          "text_vi": "An nói tiếp:"
        },
        {
          "id": "section_03.block_31",
          "type": "paragraph",
          "text_vi": "“Người ta thường nghĩ mạnh mẽ là không sợ.”"
        },
        {
          "id": "section_03.block_32",
          "type": "paragraph",
          "text_vi": "“Không phải.”"
        },
        {
          "id": "section_03.block_33",
          "type": "pull_quote",
          "text_vi": "“Mạnh mẽ là biết mình đang sợ mà vẫn xỏ giày.”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_34",
          "type": "paragraph",
          "text_vi": "“Không phải vì chắc chắn ngày hôm nay sẽ tốt đẹp.”"
        },
        {
          "id": "section_03.block_35",
          "type": "paragraph",
          "text_vi": "“Chỉ vì hôm nay là con đường duy nhất mình có thể đi.”"
        },
        {
          "id": "section_03.block_36",
          "type": "paragraph",
          "text_vi": "Người con hỏi:"
        },
        {
          "id": "section_03.block_37",
          "type": "paragraph",
          "text_vi": "“Vậy nếu ngày mai con gặp chuyện rất khó thì sao?”"
        },
        {
          "id": "section_03.block_38",
          "type": "paragraph",
          "text_vi": "An nhặt một hòn đá nhỏ dưới chân, đặt vào tay con."
        },
        {
          "id": "section_03.block_39",
          "type": "paragraph",
          "text_vi": "“Con giải quyết chuyện của ngày mai vào ngày mai.”"
        },
        {
          "id": "section_03.block_40",
          "type": "paragraph",
          "text_vi": "“Còn tối nay?”"
        },
        {
          "id": "section_03.block_41",
          "type": "paragraph",
          "text_vi": "An khép những ngón tay của con lại quanh hòn đá."
        },
        {
          "id": "section_03.block_42",
          "type": "paragraph",
          "text_vi": "Rồi ông lại mở chúng ra."
        },
        {
          "id": "section_03.block_43",
          "type": "paragraph",
          "text_vi": "Hòn đá rơi xuống đất."
        },
        {
          "id": "section_03.block_44",
          "type": "pull_quote",
          "text_vi": "“Tối nay, đặt nó xuống.”",
          "attribution_vi": null
        }
      ]
    }
