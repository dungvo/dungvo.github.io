{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.original_stone_that_loved_stormy_days",
  "revision": 1,
  "status": "draft",
  "language": "vi",
  "title_vi": "Tảng đá thích những ngày giông — Bản gốc",
  "subtitle_vi": "Mình không cần yêu cơn bão để vẫn yêu cuộc hành trình của mình.",
  "hero_image": null,
  "primary_theme": "adversity_resilience",
  "metadata": {
    "concept_ids": [
      "concept.acceptance"
    ],
    "emotion_tags": [
      "fear",
      "uncertainty"
    ],
    "keywords": [
      "giông bão",
      "thảm họa",
      "chấp nhận",
      "bình an",
      "thay đổi",
      "khả năng thích nghi",
      "biến cố",
      "kế hoạch đổ vỡ",
      "chuyện chưa kết thúc"
    ],
    "story_style": "parable"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_01.block_01",
          "type": "paragraph",
          "text_vi": "Được. Tôi kể bạn một câu chuyện không có con người. Chỉ có đá, nước, gió và một cái cây. Nó lấy chính ý trong giấc mơ của bạn: “This is a disaster. I love it.”"
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": "Câu chuyện: Tảng đá thích những ngày giông",
      "blocks": [
        {
          "id": "section_02.block_01",
          "type": "paragraph",
          "text_vi": "Trên một sườn núi cao có một tảng đá lớn."
        },
        {
          "id": "section_02.block_02",
          "type": "paragraph",
          "text_vi": "Nó đã nằm ở đó lâu đến mức chẳng còn nhớ mình xuất hiện từ khi nào."
        },
        {
          "id": "section_02.block_03",
          "type": "paragraph",
          "text_vi": "Bên cạnh nó là một cây thông già. Phía dưới là một con suối nhỏ. Còn trên cao, những đám mây vẫn ngày ngày trôi qua."
        },
        {
          "id": "section_02.block_04",
          "type": "paragraph",
          "text_vi": "Tảng đá có một mong muốn rất đơn giản:"
        },
        {
          "id": "section_02.block_05",
          "type": "pull_quote",
          "text_vi": "Nó muốn mọi thứ được yên.",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_06",
          "type": "paragraph",
          "text_vi": "Ngày nắng, nó thích."
        },
        {
          "id": "section_02.block_07",
          "type": "paragraph",
          "text_vi": "Con suối chảy đều, nó thích."
        },
        {
          "id": "section_02.block_08",
          "type": "paragraph",
          "text_vi": "Gió nhẹ, nó thích."
        },
        {
          "id": "section_02.block_09",
          "type": "paragraph",
          "text_vi": "Nhưng cứ vài tháng, giông bão lại đến."
        },
        {
          "id": "section_02.block_10",
          "type": "paragraph",
          "text_vi": "Mây đen kéo kín bầu trời."
        },
        {
          "id": "section_02.block_11",
          "type": "paragraph",
          "text_vi": "Gió quật vào cây thông."
        },
        {
          "id": "section_02.block_12",
          "type": "paragraph",
          "text_vi": "Nước từ trên núi đổ xuống, cuốn đất đá đi."
        },
        {
          "id": "section_02.block_13",
          "type": "paragraph",
          "text_vi": "Sấm nổ làm cả sườn núi rung lên."
        },
        {
          "id": "section_02.block_14",
          "type": "paragraph",
          "text_vi": "Mỗi lần như vậy, tảng đá lại nghĩ:"
        },
        {
          "id": "section_02.block_15",
          "type": "pull_quote",
          "text_vi": "“Lại nữa.”",
          "attribution_vi": null
        },
        {
          "id": "section_02.block_16",
          "type": "paragraph",
          "text_vi": "Nó ghét những ngày giông."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.block_01",
          "type": "paragraph",
          "text_vi": "Một đêm, một cơn bão rất lớn kéo đến."
        },
        {
          "id": "section_03.block_02",
          "type": "paragraph",
          "text_vi": "Mưa như trút."
        },
        {
          "id": "section_03.block_03",
          "type": "paragraph",
          "text_vi": "Nước len vào một khe nhỏ trên thân tảng đá."
        },
        {
          "id": "section_03.block_04",
          "type": "paragraph",
          "text_vi": "Rồi:"
        },
        {
          "id": "section_03.block_05",
          "type": "pull_quote",
          "text_vi": "RẮC!",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_06",
          "type": "paragraph",
          "text_vi": "Một mảnh đá vỡ ra."
        },
        {
          "id": "section_03.block_07",
          "type": "paragraph",
          "text_vi": "Tảng đá đau đớn nhìn phần thân vừa mất."
        },
        {
          "id": "section_03.block_08",
          "type": "paragraph",
          "text_vi": "Nó nói với con suối:\n\n“Đây là một thảm họa.”"
        },
        {
          "id": "section_03.block_09",
          "type": "paragraph",
          "text_vi": "Con suối không trả lời."
        },
        {
          "id": "section_03.block_10",
          "type": "paragraph",
          "text_vi": "Nó vẫn chảy."
        },
        {
          "id": "section_03.block_11",
          "type": "paragraph",
          "text_vi": "Tảng đá tức giận:\n\n“Ngươi không thấy sao? Ta vừa mất một phần của mình.”\n\nCon suối nói:\n\n“Ta thấy.”\n\n“Vậy tại sao ngươi vẫn bình thản?”"
        },
        {
          "id": "section_03.block_12",
          "type": "paragraph",
          "text_vi": "Con suối đáp:\n\n“Bởi vì hôm qua ta cũng vừa mất một khúc quanh.”"
        },
        {
          "id": "section_03.block_13",
          "type": "paragraph",
          "text_vi": "Tảng đá ngạc nhiên."
        },
        {
          "id": "section_03.block_14",
          "type": "paragraph",
          "text_vi": "Con suối kể:\n\n“Cơn mưa làm đất sạt xuống, lấp mất con đường cũ của ta.”\n\n“Vậy ngươi không tức giận sao?”\n\n“Có.”\n\n“Ngươi không muốn lấy lại con đường cũ?”\n\n“Có.”\n\n“Rồi sao?”"
        },
        {
          "id": "section_03.block_15",
          "type": "paragraph",
          "text_vi": "Con suối đáp:"
        },
        {
          "id": "section_03.block_16",
          "type": "pull_quote",
          "text_vi": "“Không lấy lại được. Nên ta chảy sang đường khác.”",
          "attribution_vi": null
        },
        {
          "id": "section_03.block_17",
          "type": "paragraph",
          "text_vi": "Rồi nó tiếp tục xuống núi."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.block_01",
          "type": "paragraph",
          "text_vi": "Nhiều năm trôi qua."
        },
        {
          "id": "section_04.block_02",
          "type": "paragraph",
          "text_vi": "Tảng đá vẫn không thích giông bão."
        },
        {
          "id": "section_04.block_03",
          "type": "paragraph",
          "text_vi": "Nhưng nó bắt đầu quan sát."
        },
        {
          "id": "section_04.block_04",
          "type": "paragraph",
          "text_vi": "Một cơn bão đến."
        },
        {
          "id": "section_04.block_05",
          "type": "paragraph",
          "text_vi": "Một cành thông gãy."
        },
        {
          "id": "section_04.block_06",
          "type": "paragraph",
          "text_vi": "Nhưng vài tháng sau, ánh sáng lọt qua khoảng trống ấy và những chồi non mọc lên."
        },
        {
          "id": "section_04.block_07",
          "type": "paragraph",
          "text_vi": "Một trận mưa lớn đến."
        },
        {
          "id": "section_04.block_08",
          "type": "paragraph",
          "text_vi": "Một phần đất bị cuốn đi."
        },
        {
          "id": "section_04.block_09",
          "type": "paragraph",
          "text_vi": "Nhưng nước mang đất ấy xuống thung lũng và những bụi hoa mọc lên."
        },
        {
          "id": "section_04.block_10",
          "type": "paragraph",
          "text_vi": "Một mùa khô đến."
        },
        {
          "id": "section_04.block_11",
          "type": "paragraph",
          "text_vi": "Con suối gần như biến mất."
        },
        {
          "id": "section_04.block_12",
          "type": "paragraph",
          "text_vi": "Nhưng chính vì nước ít đi, rễ cây thông đâm sâu hơn vào lòng núi."
        },
        {
          "id": "section_04.block_13",
          "type": "paragraph",
          "text_vi": "Tảng đá bắt đầu nhận ra một điều kỳ lạ:"
        },
        {
          "id": "section_04.block_14",
          "type": "pull_quote",
          "text_vi": "Thiên nhiên chưa bao giờ hứa rằng mọi thứ sẽ nguyên vẹn.",
          "attribution_vi": null
        },
        {
          "id": "section_04.block_15",
          "type": "paragraph",
          "text_vi": "Núi bị mưa bào mòn."
        },
        {
          "id": "section_04.block_16",
          "type": "paragraph",
          "text_vi": "Cây bị gió làm gãy."
        },
        {
          "id": "section_04.block_17",
          "type": "paragraph",
          "text_vi": "Sông đổi dòng."
        },
        {
          "id": "section_04.block_18",
          "type": "paragraph",
          "text_vi": "Đá vỡ."
        },
        {
          "id": "section_04.block_19",
          "type": "paragraph",
          "text_vi": "Hoa nở rồi tàn."
        },
        {
          "id": "section_04.block_20",
          "type": "paragraph",
          "text_vi": "Không có gì trong số đó đứng giữa trời mà hỏi:"
        },
        {
          "id": "section_04.block_21",
          "type": "pull_quote",
          "text_vi": "“Tại sao chuyện này lại xảy ra với tôi?”",
          "attribution_vi": null
        },
        {
          "id": "section_04.block_22",
          "type": "paragraph",
          "text_vi": "Chúng chỉ tiếp tục biến đổi."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.block_01",
          "type": "paragraph",
          "text_vi": "Rồi một ngày, cơn bão lớn nhất mà tảng đá từng thấy xuất hiện."
        },
        {
          "id": "section_05.block_02",
          "type": "paragraph",
          "text_vi": "Gió rít qua sườn núi."
        },
        {
          "id": "section_05.block_03",
          "type": "paragraph",
          "text_vi": "Cây thông nghiêng ngả."
        },
        {
          "id": "section_05.block_04",
          "type": "paragraph",
          "text_vi": "Con suối gầm lên."
        },
        {
          "id": "section_05.block_05",
          "type": "paragraph",
          "text_vi": "Sấm đánh xuống gần đến mức mặt đất rung chuyển."
        },
        {
          "id": "section_05.block_06",
          "type": "pull_quote",
          "text_vi": "RẮC!",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_07",
          "type": "paragraph",
          "text_vi": "Một vết nứt lớn xuất hiện giữa tảng đá."
        },
        {
          "id": "section_05.block_08",
          "type": "paragraph",
          "text_vi": "Ngày trước, có lẽ nó sẽ hoảng sợ."
        },
        {
          "id": "section_05.block_09",
          "type": "paragraph",
          "text_vi": "Nhưng lần này nó im lặng."
        },
        {
          "id": "section_05.block_10",
          "type": "paragraph",
          "text_vi": "Con suối hét lên giữa tiếng mưa:\n\n“Ngươi không sợ sao?”\n\nTảng đá đáp:\n\n“Có chứ.”\n\n“Vậy tại sao ngươi lại im?”"
        },
        {
          "id": "section_05.block_11",
          "type": "paragraph",
          "text_vi": "Tảng đá nhìn vết nứt trên mình."
        },
        {
          "id": "section_05.block_12",
          "type": "paragraph",
          "text_vi": "Rồi lần đầu tiên trong hàng trăm năm, nó bật cười:"
        },
        {
          "id": "section_05.block_13",
          "type": "pull_quote",
          "text_vi": "“This is a disaster.”",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_14",
          "type": "paragraph",
          "text_vi": "Con suối hỏi:\n\n“Rồi sao?”\n\nTảng đá đáp:"
        },
        {
          "id": "section_05.block_15",
          "type": "pull_quote",
          "text_vi": "“I love it.”",
          "attribution_vi": null
        },
        {
          "id": "section_05.block_16",
          "type": "paragraph",
          "text_vi": "Con suối tưởng nó phát điên.\n\n“Ngươi thích bị vỡ sao?”\n\n“Không.”\n\n“Vậy ngươi yêu cái gì?”"
        },
        {
          "id": "section_05.block_17",
          "type": "paragraph",
          "text_vi": "Tảng đá im lặng rất lâu."
        },
        {
          "id": "section_05.block_18",
          "type": "paragraph",
          "text_vi": "Rồi nói:"
        },
        {
          "id": "section_05.block_19",
          "type": "pull_quote",
          "text_vi": "“Ta yêu việc cuối cùng ta cũng hiểu rằng mình không cần bầu trời ngừng giông mới có thể bình yên.”",
          "attribution_vi": null
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.block_01",
          "type": "paragraph",
          "text_vi": "Sáng hôm sau, bão tan."
        },
        {
          "id": "section_06.block_02",
          "type": "paragraph",
          "text_vi": "Mặt trời xuất hiện."
        },
        {
          "id": "section_06.block_03",
          "type": "paragraph",
          "text_vi": "Nước mưa còn đọng trong vết nứt của tảng đá."
        },
        {
          "id": "section_06.block_04",
          "type": "paragraph",
          "text_vi": "Một hạt thông rất nhỏ bị gió cuốn đến và nằm lại trong đó."
        },
        {
          "id": "section_06.block_05",
          "type": "paragraph",
          "text_vi": "Nhiều ngày sau, hạt nảy mầm."
        },
        {
          "id": "section_06.block_06",
          "type": "paragraph",
          "text_vi": "Một cái cây bé xíu mọc lên ngay giữa vết nứt mà tảng đá từng gọi là thảm họa."
        },
        {
          "id": "section_06.block_07",
          "type": "paragraph",
          "text_vi": "Tảng đá nhìn nó."
        },
        {
          "id": "section_06.block_08",
          "type": "paragraph",
          "text_vi": "Con suối hỏi:\n\n“Vậy ra cơn bão là điều tốt?”\n\nTảng đá đáp:\n\n“Ta không biết.”\n\n“Vết nứt là điều tốt?”\n\n“Ta cũng không biết.”\n\n“Vậy ngươi đã học được gì?”"
        },
        {
          "id": "section_06.block_09",
          "type": "paragraph",
          "text_vi": "Tảng đá nói:"
        },
        {
          "id": "section_06.block_10",
          "type": "pull_quote",
          "text_vi": "“Ta không còn vội gọi một chuyện là tốt hay xấu khi câu chuyện của nó vẫn chưa kết thúc.”",
          "attribution_vi": null
        },
        {
          "id": "section_06.block_11",
          "type": "paragraph",
          "text_vi": "Con suối nghe xong rồi tiếp tục chảy."
        },
        {
          "id": "section_06.block_12",
          "type": "paragraph",
          "text_vi": "Gió lại thổi."
        },
        {
          "id": "section_06.block_13",
          "type": "paragraph",
          "text_vi": "Mây lại kéo đến từ phía chân trời."
        },
        {
          "id": "section_06.block_14",
          "type": "paragraph",
          "text_vi": "Và lần này, tảng đá không cầu mong mây đi nơi khác."
        },
        {
          "id": "section_06.block_15",
          "type": "paragraph",
          "text_vi": "Nó chỉ nhìn chúng và nghĩ:"
        },
        {
          "id": "section_06.block_16",
          "type": "pull_quote",
          "text_vi": "“Ah… another disaster.” 😄",
          "attribution_vi": null
        },
        {
          "id": "section_06.block_17",
          "type": "paragraph",
          "text_vi": "Rồi cái cây nhỏ trên mình nó rung rinh trong gió."
        }
      ]
    },
    {
      "id": "section_07",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_07.block_01",
          "type": "paragraph",
          "text_vi": "Tôi rất thích một ý trong câu chuyện này:"
        },
        {
          "id": "section_07.block_02",
          "type": "pull_quote",
          "text_vi": "Bình an không phải là trạng thái không còn “disaster”.\nBình an là khi disaster đến mà mình không lập tức trở thành disaster cùng với nó.",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_03",
          "type": "paragraph",
          "text_vi": "Có những chuyện cần sửa — sửa."
        },
        {
          "id": "section_07.block_04",
          "type": "paragraph",
          "text_vi": "Có những chuyện cần nói — nói."
        },
        {
          "id": "section_07.block_05",
          "type": "paragraph",
          "text_vi": "Có những chuyện người khác không hiểu — đôi khi cứ để họ không hiểu."
        },
        {
          "id": "section_07.block_06",
          "type": "paragraph",
          "text_vi": "Có những cơn mưa mình tránh được — tránh."
        },
        {
          "id": "section_07.block_07",
          "type": "paragraph",
          "text_vi": "Còn khi không tránh được thì giống con suối:"
        },
        {
          "id": "section_07.block_08",
          "type": "pull_quote",
          "text_vi": "đường cũ bị lấp thì tìm đường khác mà chảy.",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_09",
          "type": "paragraph",
          "text_vi": "Và có lẽ câu trong giấc mơ của bạn không cần hiểu theo nghĩa “Tôi yêu thảm họa.”"
        },
        {
          "id": "section_07.block_10",
          "type": "paragraph",
          "text_vi": "Tôi thích hiểu nó thành:"
        },
        {
          "id": "section_07.block_11",
          "type": "pull_quote",
          "text_vi": "“This is a disaster. I love it.”\nChuyện này thật tệ. Nhưng cuộc đời vẫn thú vị. 😄",
          "attribution_vi": null
        },
        {
          "id": "section_07.block_12",
          "type": "pull_quote",
          "text_vi": "Bởi vì mình không cần yêu cơn bão để vẫn yêu cuộc hành trình của mình.",
          "attribution_vi": null
        }
      ]
    }
