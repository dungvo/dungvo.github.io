{
  "schema_version": "1.0",
  "entity": "perspective_story",
  "id": "story.two_sides_of_one_mountain",
  "revision": 1,
  "status": "draft",
  "language": "vi",
  "title_vi": "Hai phía của một ngọn núi",
  "subtitle_vi": "Một người mang câu hỏi về những điều đối lập đi qua núi, suối và một căn nhà bỏ hoang.",
  "hero_image": null,
  "primary_theme": "self_understanding",
  "metadata": {
    "concept_ids": [],
    "emotion_tags": [],
    "keywords": [
      "âm dương",
      "đối đãi",
      "ngọn núi",
      "thung lũng",
      "cái chum",
      "quan sát"
    ],
    "story_style": "parable"
  },
  "sections": [
    {
      "id": "section_01",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_01.paragraph_01",
          "type": "paragraph",
          "text_vi": "Một người mang câu này đến hỏi một đạo gia:"
        },
        {
          "id": "section_01.paragraph_02",
          "type": "paragraph",
          "text_vi": "“Có và không sinh ra nhau; khó và dễ thành tựu lẫn nhau; dài và ngắn làm rõ nhau; cao và thấp dựa vào nhau."
        },
        {
          "id": "section_01.paragraph_03",
          "type": "paragraph",
          "text_vi": "Con đọc nhiều lần nhưng vẫn không hiểu. Tại sao những thứ đối lập lại ‘sinh ra nhau’?”"
        },
        {
          "id": "section_01.paragraph_04",
          "type": "paragraph",
          "text_vi": "Đạo gia không trả lời."
        },
        {
          "id": "section_01.paragraph_05",
          "type": "paragraph",
          "text_vi": "Ông dẫn người ấy ra khỏi am."
        },
        {
          "id": "section_01.paragraph_06",
          "type": "paragraph",
          "text_vi": "Hai người đi đến chân một ngọn núi."
        },
        {
          "id": "section_01.paragraph_07",
          "type": "paragraph",
          "text_vi": "Ông hỏi:"
        },
        {
          "id": "section_01.paragraph_08",
          "type": "paragraph",
          "text_vi": "“Ngọn núi này cao không?”"
        },
        {
          "id": "section_01.paragraph_09",
          "type": "paragraph",
          "text_vi": "“Cao.”"
        },
        {
          "id": "section_01.paragraph_10",
          "type": "paragraph",
          "text_vi": "“Con biết bằng cách nào?”"
        },
        {
          "id": "section_01.paragraph_11",
          "type": "paragraph",
          "text_vi": "Người kia nhìn lên đỉnh núi."
        },
        {
          "id": "section_01.paragraph_12",
          "type": "paragraph",
          "text_vi": "“Vì nó cao hơn mặt đất nơi chúng ta đang đứng.”"
        },
        {
          "id": "section_01.paragraph_13",
          "type": "paragraph",
          "text_vi": "Đạo gia gật đầu."
        },
        {
          "id": "section_01.paragraph_14",
          "type": "paragraph",
          "text_vi": "Rồi ông hỏi:"
        },
        {
          "id": "section_01.paragraph_15",
          "type": "paragraph",
          "text_vi": "“Nếu cả thế gian đều cao bằng đỉnh núi này, còn nơi nào thấp hơn để so sánh, con có còn gọi nó là cao không?”"
        },
        {
          "id": "section_01.paragraph_16",
          "type": "paragraph",
          "text_vi": "Người kia im lặng."
        },
        {
          "id": "section_01.paragraph_17",
          "type": "paragraph",
          "text_vi": "Đạo gia nói:"
        },
        {
          "id": "section_01.paragraph_18",
          "type": "paragraph",
          "text_vi": "“Vậy cái cao ở đâu?”"
        },
        {
          "id": "section_01.paragraph_19",
          "type": "paragraph",
          "text_vi": "“Ở ngọn núi.”"
        },
        {
          "id": "section_01.paragraph_20",
          "type": "paragraph",
          "text_vi": "Đạo gia lắc đầu."
        },
        {
          "id": "section_01.paragraph_21",
          "type": "paragraph",
          "text_vi": "“Không hoàn toàn."
        },
        {
          "id": "section_01.paragraph_22",
          "type": "paragraph",
          "text_vi": "Một nửa cái cao nằm ở núi."
        },
        {
          "id": "section_01.paragraph_23",
          "type": "paragraph",
          "text_vi": "Một nửa nằm ở thung lũng.”"
        },
        {
          "id": "section_01.paragraph_24",
          "type": "paragraph",
          "text_vi": "Người kia bắt đầu suy nghĩ."
        }
      ]
    },
    {
      "id": "section_02",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_02.paragraph_01",
          "type": "paragraph",
          "text_vi": "Hai người tiếp tục đi."
        },
        {
          "id": "section_02.paragraph_02",
          "type": "paragraph",
          "text_vi": "Đến một con suối, đạo gia nhặt hai cành cây."
        },
        {
          "id": "section_02.paragraph_03",
          "type": "paragraph",
          "text_vi": "Một cành dài."
        },
        {
          "id": "section_02.paragraph_04",
          "type": "paragraph",
          "text_vi": "Một cành ngắn."
        },
        {
          "id": "section_02.paragraph_05",
          "type": "paragraph",
          "text_vi": "Ông hỏi:"
        },
        {
          "id": "section_02.paragraph_06",
          "type": "paragraph",
          "text_vi": "“Cành nào dài?”"
        },
        {
          "id": "section_02.paragraph_07",
          "type": "paragraph",
          "text_vi": "Người kia chỉ ngay cành bên trái."
        },
        {
          "id": "section_02.paragraph_08",
          "type": "paragraph",
          "text_vi": "Đạo gia ném cành ngắn đi."
        },
        {
          "id": "section_02.paragraph_09",
          "type": "paragraph",
          "text_vi": "Rồi ông chỉ vào cành còn lại."
        },
        {
          "id": "section_02.paragraph_10",
          "type": "paragraph",
          "text_vi": "“Bây giờ nó dài hay ngắn?”"
        },
        {
          "id": "section_02.paragraph_11",
          "type": "paragraph",
          "text_vi": "Người kia định trả lời, rồi dừng lại."
        },
        {
          "id": "section_02.paragraph_12",
          "type": "paragraph",
          "text_vi": "Đạo gia hỏi:"
        },
        {
          "id": "section_02.paragraph_13",
          "type": "paragraph",
          "text_vi": "“Sao con không nói?”"
        },
        {
          "id": "section_02.paragraph_14",
          "type": "paragraph",
          "text_vi": "“Vì không còn gì để so sánh.”"
        },
        {
          "id": "section_02.paragraph_15",
          "type": "paragraph",
          "text_vi": "Đạo gia cười."
        },
        {
          "id": "section_02.paragraph_16",
          "type": "paragraph",
          "text_vi": "“Lúc nãy con tưởng ‘dài’ là thuộc tính nằm bên trong cành cây."
        },
        {
          "id": "section_02.paragraph_17",
          "type": "paragraph",
          "text_vi": "Nhưng khi cành ngắn biến mất, cái dài cũng biến mất theo.”"
        },
        {
          "id": "section_02.paragraph_18",
          "type": "paragraph",
          "text_vi": "Người kia bỗng hiểu được một chút."
        }
      ]
    },
    {
      "id": "section_03",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_03.paragraph_01",
          "type": "paragraph",
          "text_vi": "Đạo gia lại dẫn người ấy đi tiếp."
        },
        {
          "id": "section_03.paragraph_02",
          "type": "paragraph",
          "text_vi": "Đến trưa, họ dừng lại bên một căn nhà bỏ hoang."
        },
        {
          "id": "section_03.paragraph_03",
          "type": "paragraph",
          "text_vi": "Trong nhà có một cái chum bằng đất."
        },
        {
          "id": "section_03.paragraph_04",
          "type": "paragraph",
          "text_vi": "Đạo gia hỏi:"
        },
        {
          "id": "section_03.paragraph_05",
          "type": "paragraph",
          "text_vi": "“Cái gì làm cho cái chum trở thành cái chum?”"
        },
        {
          "id": "section_03.paragraph_06",
          "type": "paragraph",
          "text_vi": "“Đất.”"
        },
        {
          "id": "section_03.paragraph_07",
          "type": "paragraph",
          "text_vi": "Đạo gia lấy tay gõ vào thành chum."
        },
        {
          "id": "section_03.paragraph_08",
          "type": "paragraph",
          "text_vi": "“Đất tạo ra thành chum."
        },
        {
          "id": "section_03.paragraph_09",
          "type": "paragraph",
          "text_vi": "Nhưng nếu bên trong cũng đặc kín đất thì sao?”"
        },
        {
          "id": "section_03.paragraph_10",
          "type": "paragraph",
          "text_vi": "“Thì không đựng được gì.”"
        },
        {
          "id": "section_03.paragraph_11",
          "type": "paragraph",
          "text_vi": "“Vậy thứ làm cho cái chum có ích là đất hay khoảng trống?”"
        },
        {
          "id": "section_03.paragraph_12",
          "type": "paragraph",
          "text_vi": "Người kia đáp:"
        },
        {
          "id": "section_03.paragraph_13",
          "type": "paragraph",
          "text_vi": "“Cả hai.”"
        },
        {
          "id": "section_03.paragraph_14",
          "type": "paragraph",
          "text_vi": "Đạo gia nói:"
        },
        {
          "id": "section_03.paragraph_15",
          "type": "paragraph",
          "text_vi": "“Đất là cái có."
        },
        {
          "id": "section_03.paragraph_16",
          "type": "paragraph",
          "text_vi": "Khoảng trống là cái không."
        },
        {
          "id": "section_03.paragraph_17",
          "type": "paragraph",
          "text_vi": "Con thường nghĩ cái có là thật, cái không chẳng là gì."
        },
        {
          "id": "section_03.paragraph_18",
          "type": "paragraph",
          "text_vi": "Nhưng bỏ cái không đi, cái có cũng mất công dụng của nó.”"
        },
        {
          "id": "section_03.paragraph_19",
          "type": "paragraph",
          "text_vi": "Người kia nhìn vào lòng chum rất lâu."
        }
      ]
    },
    {
      "id": "section_04",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_04.paragraph_01",
          "type": "paragraph",
          "text_vi": "Chiều xuống, hai người quay về."
        },
        {
          "id": "section_04.paragraph_02",
          "type": "paragraph",
          "text_vi": "Trên đường, họ gặp một đoạn dốc đá rất khó đi."
        },
        {
          "id": "section_04.paragraph_03",
          "type": "paragraph",
          "text_vi": "Người kia mệt, bước rất chậm."
        },
        {
          "id": "section_04.paragraph_04",
          "type": "paragraph",
          "text_vi": "Khi qua khỏi đoạn dốc, con đường trở nên bằng phẳng."
        },
        {
          "id": "section_04.paragraph_05",
          "type": "paragraph",
          "text_vi": "Người ấy thở phào:"
        },
        {
          "id": "section_04.paragraph_06",
          "type": "paragraph",
          "text_vi": "“Đoạn này dễ đi quá.”"
        },
        {
          "id": "section_04.paragraph_07",
          "type": "paragraph",
          "text_vi": "Đạo gia hỏi:"
        },
        {
          "id": "section_04.paragraph_08",
          "type": "paragraph",
          "text_vi": "“Nếu từ đầu đến cuối đều bằng phẳng như thế này, con có nghĩ đến chữ ‘dễ’ không?”"
        },
        {
          "id": "section_04.paragraph_09",
          "type": "paragraph",
          "text_vi": "Người kia bật cười."
        },
        {
          "id": "section_04.paragraph_10",
          "type": "paragraph",
          "text_vi": "“Có lẽ không.”"
        },
        {
          "id": "section_04.paragraph_11",
          "type": "paragraph",
          "text_vi": "“Vậy cái dễ vừa từ đâu sinh ra?”"
        },
        {
          "id": "section_04.paragraph_12",
          "type": "paragraph",
          "text_vi": "Người kia quay đầu nhìn con dốc phía sau."
        },
        {
          "id": "section_04.paragraph_13",
          "type": "paragraph",
          "text_vi": "“Có lẽ… từ cái khó.”"
        },
        {
          "id": "section_04.paragraph_14",
          "type": "paragraph",
          "text_vi": "Đạo gia không nói gì nữa."
        }
      ]
    },
    {
      "id": "section_05",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_05.paragraph_01",
          "type": "paragraph",
          "text_vi": "Đến khi mặt trời gần lặn, người kia mới hỏi:"
        },
        {
          "id": "section_05.paragraph_02",
          "type": "paragraph",
          "text_vi": "“Vậy ý của câu ấy là mọi thứ đều cần một thứ đối lập để tồn tại sao?”"
        },
        {
          "id": "section_05.paragraph_03",
          "type": "paragraph",
          "text_vi": "Đạo gia đáp:"
        },
        {
          "id": "section_05.paragraph_04",
          "type": "paragraph",
          "text_vi": "“Đừng vội nói ‘cần’."
        },
        {
          "id": "section_05.paragraph_05",
          "type": "paragraph",
          "text_vi": "Con vẫn đang nghĩ chúng là hai thứ đứng riêng rồi dựa vào nhau."
        },
        {
          "id": "section_05.paragraph_06",
          "type": "paragraph",
          "text_vi": "Hãy nhìn ngọn núi và thung lũng."
        },
        {
          "id": "section_05.paragraph_07",
          "type": "paragraph",
          "text_vi": "Con có thể đào hết thung lũng đi mà vẫn giữ nguyên ngọn núi được không?”"
        },
        {
          "id": "section_05.paragraph_08",
          "type": "paragraph",
          "text_vi": "Người kia suy nghĩ."
        },
        {
          "id": "section_05.paragraph_09",
          "type": "paragraph",
          "text_vi": "Không."
        },
        {
          "id": "section_05.paragraph_10",
          "type": "paragraph",
          "text_vi": "Đất lấy từ nơi này sẽ tạo nên hình dạng nơi khác."
        },
        {
          "id": "section_05.paragraph_11",
          "type": "paragraph",
          "text_vi": "Núi và vực không phải hai câu chuyện riêng."
        },
        {
          "id": "section_05.paragraph_12",
          "type": "paragraph",
          "text_vi": "Chúng là cùng một mặt đất, chỗ nổi lên và chỗ hạ xuống."
        },
        {
          "id": "section_05.paragraph_13",
          "type": "paragraph",
          "text_vi": "Đạo gia nói:"
        },
        {
          "id": "section_05.paragraph_14",
          "type": "paragraph",
          "text_vi": "“Con người nhìn chỗ nổi lên rồi gọi là núi."
        },
        {
          "id": "section_05.paragraph_15",
          "type": "paragraph",
          "text_vi": "Nhìn chỗ hạ xuống rồi gọi là thung lũng."
        },
        {
          "id": "section_05.paragraph_16",
          "type": "paragraph",
          "text_vi": "Sau đó tưởng rằng mình đang nhìn hai thứ.”"
        },
        {
          "id": "section_05.paragraph_17",
          "type": "paragraph",
          "text_vi": "Ông lấy ngón tay vẽ một đường cong trên đất."
        },
        {
          "id": "section_05.paragraph_18",
          "type": "paragraph",
          "text_vi": "“Nhưng đất chưa bao giờ tự chia mình thành hai.”"
        },
        {
          "id": "section_05.paragraph_19",
          "type": "paragraph",
          "text_vi": "Người kia nhìn đường cong."
        },
        {
          "id": "section_05.paragraph_20",
          "type": "paragraph",
          "text_vi": "Một phía cao lên."
        },
        {
          "id": "section_05.paragraph_21",
          "type": "paragraph",
          "text_vi": "Một phía thấp xuống."
        },
        {
          "id": "section_05.paragraph_22",
          "type": "paragraph",
          "text_vi": "Nếu xóa bên thấp, bên cao cũng không còn hình dạng."
        },
        {
          "id": "section_05.paragraph_23",
          "type": "paragraph",
          "text_vi": "Đạo gia nói tiếp:"
        },
        {
          "id": "section_05.paragraph_24",
          "type": "paragraph",
          "text_vi": "“Phải và trái cũng vậy."
        },
        {
          "id": "section_05.paragraph_25",
          "type": "paragraph",
          "text_vi": "Con thử tìm một vật chỉ có bên phải mà không có bên trái xem.”"
        },
        {
          "id": "section_05.paragraph_26",
          "type": "paragraph",
          "text_vi": "Người kia không trả lời được."
        },
        {
          "id": "section_05.paragraph_27",
          "type": "paragraph",
          "text_vi": "“Trước và sau cũng vậy."
        },
        {
          "id": "section_05.paragraph_28",
          "type": "paragraph",
          "text_vi": "Trong và ngoài cũng vậy."
        },
        {
          "id": "section_05.paragraph_29",
          "type": "paragraph",
          "text_vi": "Được và mất nhiều khi cũng vậy."
        },
        {
          "id": "section_05.paragraph_30",
          "type": "paragraph",
          "text_vi": "Con người thích một phía nên gọi nó là tốt."
        },
        {
          "id": "section_05.paragraph_31",
          "type": "paragraph",
          "text_vi": "Ghét phía kia nên muốn loại bỏ nó."
        },
        {
          "id": "section_05.paragraph_32",
          "type": "paragraph",
          "text_vi": "Nhưng Đạo không đứng về phía nào."
        },
        {
          "id": "section_05.paragraph_33",
          "type": "paragraph",
          "text_vi": "Đạo là cái toàn thể khiến cả hai phía cùng xuất hiện.”"
        }
      ]
    },
    {
      "id": "section_06",
      "title_vi": null,
      "blocks": [
        {
          "id": "section_06.paragraph_01",
          "type": "paragraph",
          "text_vi": "Người kia hỏi:"
        },
        {
          "id": "section_06.paragraph_02",
          "type": "paragraph",
          "text_vi": "“Vậy Âm và Dương là hai thứ hay một thứ?”"
        },
        {
          "id": "section_06.paragraph_03",
          "type": "paragraph",
          "text_vi": "Đạo gia nhìn mặt trời đang lặn."
        },
        {
          "id": "section_06.paragraph_04",
          "type": "paragraph",
          "text_vi": "Một nửa sườn núi còn sáng."
        },
        {
          "id": "section_06.paragraph_05",
          "type": "paragraph",
          "text_vi": "Một nửa đã chìm vào bóng tối."
        },
        {
          "id": "section_06.paragraph_06",
          "type": "paragraph",
          "text_vi": "Ông nói:"
        },
        {
          "id": "section_06.paragraph_07",
          "type": "paragraph",
          "text_vi": "“Nếu con nhìn ánh sáng, con thấy Dương."
        },
        {
          "id": "section_06.paragraph_08",
          "type": "paragraph",
          "text_vi": "Nếu con nhìn bóng tối, con thấy Âm."
        },
        {
          "id": "section_06.paragraph_09",
          "type": "paragraph",
          "text_vi": "Nếu con nhìn cả ngọn núi, con thấy một.”"
        },
        {
          "id": "section_06.paragraph_10",
          "type": "paragraph",
          "text_vi": "Rồi ông quay về am."
        },
        {
          "id": "section_06.paragraph_11",
          "type": "paragraph",
          "text_vi": "Người kia đứng lại rất lâu."
        },
        {
          "id": "section_06.paragraph_12",
          "type": "paragraph",
          "text_vi": "Lần đầu tiên, anh không còn cố chọn xem ánh sáng hay bóng tối mới là phần thật của ngọn núi."
