#!/usr/bin/env ruby

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "set"
require "tempfile"
require "time"

options = {
  repo_root: File.expand_path("..", __dir__),
  validate_schema: true
}

OptionParser.new do |parser|
  parser.banner = "publish-perspective-library --channel authoring|release"

  parser.on("--channel CHANNEL") do |value|
    options[:channel] = value
  end

  parser.on("--repo-root PATH") do |value|
    options[:repo_root] = File.expand_path(value)
  end

  parser.on("--source PATH") do |value|
    options[:source] = File.expand_path(value)
  end

  parser.on("--schema-dir PATH") do |value|
    options[:schema_dir] = File.expand_path(value)
  end

  parser.on("--skip-schema") do
    options[:validate_schema] = false
  end
end.parse!

channel = options[:channel]

abort("--channel must be authoring or release") unless %w[authoring release].include?(channel)

repo_root = options.fetch(:repo_root)

source_root =
  options[:source] ||
  File.join(repo_root, "perspective-library/source/vi")

output_root =
  File.join(repo_root, "perspective-library/#{channel}/vi")

schema_root =
  options[:schema_dir] ||
  File.join(repo_root, "perspective-library/tooling/schema")


# -----------------------------------------------------------------------------
# Release lifecycle rules
# -----------------------------------------------------------------------------

RELEASE_RIGHTS_STATUSES = Set.new(
  %w[
    selflo_owned
    public_domain
    licensed
    permission_granted
  ]
).freeze


def read_json(path)
  JSON.parse(File.binread(path))
rescue Errno::ENOENT
  abort("Missing file: #{path}")
rescue JSON::ParserError => error
  abort("Invalid JSON #{path}: #{error.message}")
end


def json_bytes(value)
  JSON.pretty_generate(value) + "\n"
end


def sha(bytes)
  Digest::SHA256.hexdigest(bytes)
end


def atomic_write(path, bytes)
  FileUtils.mkdir_p(File.dirname(path))

  temporary = "#{path}.next"

  File.binwrite(temporary, bytes)
  File.rename(temporary, path)
end


def immutable_write(path, bytes)
  FileUtils.mkdir_p(File.dirname(path))

  if File.exist?(path)
    abort("Immutable path conflict: #{path}") unless File.binread(path) == bytes
    return
  end

  File.binwrite(path, bytes)
end


def revisioned_path(source_path, revision)
  extension = File.extname(source_path)
  stem = source_path.delete_suffix(extension)

  "#{stem}.r#{revision}#{extension}"
end


def valid_release_review_timestamp?(value)
  return false unless value.is_a?(String)
  return false unless value.end_with?("Z", "+00:00")

  parsed = Time.iso8601(value)

  parsed.utc_offset.zero?
rescue ArgumentError
  false
end


def release_ready_review?(entity)
  review = entity["review"] || {}
  rights = entity["rights"] || {}

  reviewer = review["reviewed_by"]

  review["status"] == "approved" &&
    reviewer.is_a?(String) &&
    !reviewer.strip.empty? &&
    valid_release_review_timestamp?(review["reviewed_at"]) &&
    RELEASE_RIGHTS_STATUSES.include?(rights["status"])
end


def release_ready_story?(story)
  story.fetch("status") == "active" &&
    release_ready_review?(story)
end


def without_revisions(value)
  case value
  when Hash
    value.each_with_object({}) do |(key, child), result|
      result[key] = without_revisions(child) unless key == "revision"
    end
  when Array
    value.map { |child| without_revisions(child) }
  else
    value
  end
end


def validate_source_index!(source_root, index)
  abort("Unsupported source schema") unless index.fetch("schema_version") == "selflo.perspective.authoring-source.v1"

  index.fetch("files").each do |entry|
    path = File.expand_path(entry.fetch("path"), source_root)

    root =
      source_root.end_with?("/") ?
        source_root :
        source_root + "/"

    abort("Unsafe source path: #{entry.fetch("path")}") unless path.start_with?(root)
    abort("Missing source file: #{entry.fetch("path")}") unless File.file?(path)
  end
end


def canonical_source_digest(source_root, index)
  material =
    index.fetch("files")
      .sort_by { |entry| entry.fetch("path") }
      .map do |entry|
        path = File.join(source_root, entry.fetch("path"))

        "#{entry.fetch("path")}\0#{sha(File.binread(path))}"
      end
      .join("\n")

  sha(material)
end


def validate_references!(payloads, channel)
  knowledge =
    payloads.fetch("knowledge_catalog").fetch(0)

  themes =
    payloads.fetch("quote_pack")

  stories =
    payloads.fetch("story", [])

  reading_intent_catalogs =
    payloads.fetch("reading_intent_catalog", [])

  quotes =
    themes.flat_map { |theme| theme.fetch("quotes") }

  theme_ids =
    themes
      .map { |theme| theme.fetch("primary_theme") }
      .to_set

  quote_ids =
    quotes.map { |quote| quote.fetch("id") }

  story_ids =
    stories
      .map { |story| story.fetch("id") }
      .to_set

  concepts =
    knowledge
      .fetch("concepts")
      .map { |item| item.fetch("id") }
      .to_set

  theories =
    knowledge
      .fetch("theories")
      .map { |item| item.fetch("id") }
      .to_set

  frameworks =
    knowledge
      .fetch("frameworks")
      .map { |item| item.fetch("id") }
      .to_set

  truths =
    knowledge
      .fetch("theories")
      .flat_map do |item|
        item
          .fetch("core_truths")
          .map { |truth| truth.fetch("id") }
      end
      .to_set

  references =
    knowledge
      .fetch("references")
      .map { |item| item.fetch("id") }
      .to_set

  abort("Quote IDs are not unique") unless quote_ids.uniq.length == quote_ids.length
  abort("Theme IDs are not unique") unless theme_ids.length == themes.length

  quotes.each do |quote|
    id = quote.fetch("id")

    abort("Theme mismatch: #{id}") unless theme_ids.include?(quote.fetch("primary_theme"))

    if quote["story_id"] && !story_ids.include?(quote.fetch("story_id"))
      abort("Broken story: #{id}")
    end

    {
      "concepts" => concepts,
      "theories" => theories,
      "frameworks" => frameworks
    }.each do |field, valid|
      values = quote.dig("metadata", field) || []

      missing =
        values.reject { |value| valid.include?(value) }

      abort("Broken #{field} on #{id}: #{missing.join(", ")}") unless missing.empty?
    end

    next unless quote["knowledge_basis"]

    missing_truths =
      quote
        .dig("knowledge_basis", "core_truth_ids")
        .reject { |value| truths.include?(value) }

    missing_refs =
      quote
        .dig("knowledge_basis", "reference_ids")
        .reject { |value| references.include?(value) }

    abort("Broken core truth on #{id}: #{missing_truths.join(", ")}") unless missing_truths.empty?
    abort("Broken reference on #{id}: #{missing_refs.join(", ")}") unless missing_refs.empty?
  end

  stories.each do |story|
    id = story.fetch("id")

    abort("Unknown story theme #{id}") unless theme_ids.include?(story.fetch("primary_theme"))

    concept_ids =
      story.dig("metadata", "concept_ids") || []

    missing =
      concept_ids.reject { |value| concepts.include?(value) }

    abort("Broken story concept #{id}: #{missing.join(", ")}") unless missing.empty?
  end

  if reading_intent_catalogs.length > 1
    abort("More than one Reading Intent Catalog")
  end

  reading_intent_catalogs.each do |catalog|
    intent_ids =
      catalog
        .fetch("intents")
        .map { |intent| intent.fetch("id") }

    abort("Reading intent IDs are not unique") unless intent_ids.uniq.length == intent_ids.length

    catalog.fetch("intents").each do |intent|
      memberships = intent.fetch("story_ids")

      unless memberships.uniq.length == memberships.length
        abort("Duplicate story membership on #{intent.fetch("id")}")
      end

      missing =
        memberships.reject { |story_id| story_ids.include?(story_id) }

      unless missing.empty?
        abort("Broken reading-intent story on #{intent.fetch("id")}: #{missing.join(", ")}")
      end
    end
  end

  knowledge.fetch("concepts").each do |concept|
    id = concept.fetch("id")

    unless concept.fetch("primary_theme_ids").all? { |theme_id| theme_ids.include?(theme_id) }
      abort("Broken concept theme #{id}")
    end

    unless concept.fetch("related_theory_ids").all? { |theory_id| theories.include?(theory_id) }
      abort("Broken related theory #{id}")
    end

    unless concept.fetch("related_framework_ids").all? { |framework_id| frameworks.include?(framework_id) }
      abort("Broken related framework #{id}")
    end
  end

  knowledge.fetch("theories").each do |theory|
    id = theory.fetch("id")

    unless theory.fetch("reference_ids").all? { |reference_id| references.include?(reference_id) }
      abort("Broken theory reference #{id}")
    end
  end

  knowledge.fetch("frameworks").each do |framework|
    id = framework.fetch("id")

    unless framework.fetch("reference_ids").all? { |reference_id| references.include?(reference_id) }
      abort("Broken framework reference #{id}")
    end
  end

  return unless channel == "release"

  unless knowledge.fetch("status") == "approved"
    abort("Release knowledge catalog is not approved")
  end

  knowledge.fetch("concepts").each do |item|
    unless item.fetch("status") == "approved"
      abort("Release concept not approved: #{item.fetch("id")}")
    end
  end

  knowledge.fetch("theories").each do |item|
    unless item.fetch("status") == "approved" &&
           item.fetch("validation_status") == "source_checked"
      abort("Release theory not approved/source_checked: #{item.fetch("id")}")
    end
  end

  knowledge.fetch("frameworks").each do |item|
    unless item.fetch("status") == "approved" &&
           item.fetch("validation_status") == "source_checked"
      abort("Release framework not approved/source_checked: #{item.fetch("id")}")
    end
  end

  knowledge.fetch("references").each do |item|
    unless item.fetch("validation_status") == "source_checked"
      abort("Release reference not source_checked: #{item.fetch("id")}")
    end
  end

  reading_intent_catalogs.each do |catalog|
    unless catalog.fetch("status") == "approved"
      abort("Release Reading Intent Catalog is not approved")
    end
  end
end


def run_schema_gate!(schema_root, manifest_path, payload_paths)
  schemas = {
    "knowledge_catalog" => "perspective-knowledge.schema.json",
    "quote_pack" => "perspective-theme.schema.json",
    "reading_intent_catalog" => "perspective-reading-intent.schema.json",
    "story" => "perspective-story.schema.json",
    "manifest" => "perspective-library-manifest.schema.json"
  }

  checks =
    payload_paths + [["manifest", manifest_path]]

  checks.each do |kind, path|
    schema =
      File.join(
        schema_root,
        schemas.fetch(kind)
      )

    abort("Missing schema: #{schema}") unless File.file?(schema)

    command = [
      "npx",
      "--yes",
      "--package=ajv-cli@5.0.0",
      "--package=ajv-formats@3.0.1",
      "ajv",
      "validate",
      "--spec=draft2020",
      "-c",
      "ajv-formats",
      "-s",
      schema,
      "-d",
      path
    ]

    stdout, stderr, status =
      Open3.capture3(*command)

    unless status.success?
      abort(
        "Schema validation failed for #{path}:\n#{stdout}#{stderr}"
      )
    end
  end
end


# -----------------------------------------------------------------------------
# Load canonical source
# -----------------------------------------------------------------------------

source_index =
  read_json(
    File.join(
      source_root,
      "source.json"
    )
  )

validate_source_index!(
  source_root,
  source_index
)

source_digest =
  canonical_source_digest(
    source_root,
    source_index
  )


content_entries =
  source_index
    .fetch("files")
    .select do |entry|
      %w[
        knowledge_catalog
        quote_pack
        reading_intent_catalog
        story
        image
      ].include?(entry.fetch("kind"))
    end


unless content_entries.count { |entry| entry.fetch("kind") == "knowledge_catalog" } == 1
  abort("Canonical source must contain exactly one Knowledge Catalog")
end


if content_entries.count { |entry| entry.fetch("kind") == "reading_intent_catalog" } > 1
  abort("Canonical source may contain at most one Reading Intent Catalog")
end


# -----------------------------------------------------------------------------
# Owner decisions
# -----------------------------------------------------------------------------

decisions_entry =
  source_index
    .fetch("files")
    .find { |entry| entry.fetch("kind") == "authoring_decisions" } ||
  abort("Missing decision ledger")


decisions =
  read_json(
    File.join(
      source_root,
      decisions_entry.fetch("path")
    )
  )


unless decisions.fetch("owner_gate_status") == "approved"
  abort("Owner has not approved CP-003")
end


# -----------------------------------------------------------------------------
# Load source payloads
# -----------------------------------------------------------------------------

source_payloads =
  content_entries
    .reject { |entry| entry.fetch("kind") == "image" }
    .to_h do |entry|
      [
        entry.fetch("id"),
        read_json(
          File.join(
            source_root,
            entry.fetch("path")
          )
        )
      ]
    end


# -----------------------------------------------------------------------------
# Load quote fragments
# -----------------------------------------------------------------------------

fragment_entries =
  source_index
    .fetch("files")
    .select { |entry| entry.fetch("kind") == "quote_fragment" }


fragments_by_id =
  fragment_entries.to_h do |entry|
    payload =
      read_json(
        File.join(
          source_root,
          entry.fetch("path")
        )
      )

    unless payload.fetch("schema_version") == "selflo.perspective.quote-fragment.v1"
      abort("Unsupported quote fragment schema: #{entry.fetch("id")}")
    end

    unless payload.fetch("entity") == "perspective_quote_fragment"
      abort("Invalid quote fragment entity: #{entry.fetch("id")}")
    end

    unless payload.fetch("fragment_id") == entry.fetch("id")
      abort("Quote fragment ID mismatch: #{entry.fetch("id")}")
    end

    unless payload.fetch("quotes").is_a?(Array) &&
           !payload.fetch("quotes").empty?
      abort("Quote fragment must contain quotes: #{entry.fetch("id")}")
    end

    [
      entry.fetch("id"),
      payload
    ]
  end


# -----------------------------------------------------------------------------
# Materialize quote fragments into themes
# -----------------------------------------------------------------------------

used_fragment_ids = []


source_payloads.each do |id, payload|
  next unless id.start_with?("theme.")
  next unless payload.key?("quote_fragment_ids")

  fragment_ids =
    payload.delete("quote_fragment_ids")

  unless fragment_ids.is_a?(Array) &&
         !fragment_ids.empty?
    abort("Theme source has no quote fragments: #{id}")
  end

  fragments =
    fragment_ids.map do |fragment_id|
      fragment =
        fragments_by_id.fetch(fragment_id) do
          abort("Missing quote fragment #{fragment_id} for #{id}")
        end

      unless fragment.fetch("primary_theme") == payload.fetch("primary_theme")
        abort("Quote fragment theme mismatch: #{fragment_id}")
      end

      fragment
    end

  used_fragment_ids.concat(fragment_ids)

  payload["quotes"] =
    fragments.flat_map do |fragment|
      fragment.fetch("quotes")
    end
end


unless used_fragment_ids.uniq.length == used_fragment_ids.length
  abort("Quote fragment referenced more than once")
end


unused_fragment_ids =
  fragments_by_id.keys -
  used_fragment_ids


unless unused_fragment_ids.empty?
  abort(
    "Unreferenced quote fragments: #{unused_fragment_ids.join(", ")}"
  )
end


# -----------------------------------------------------------------------------
# Determine Release-ready stories
# -----------------------------------------------------------------------------

stories_by_id =
  source_payloads.select do |id, _payload|
    id.start_with?("story.")
  end


release_story_ids =
  stories_by_id
    .select do |_id, story|
      release_ready_story?(story)
    end
    .keys
    .to_set


release_image_ids =
  stories_by_id
    .select do |id, _story|
      release_story_ids.include?(id)
    end
    .values
    .map do |story|
      story.dig(
        "hero_image",
        "file_id"
      )
    end
    .compact
    .to_set


# -----------------------------------------------------------------------------
# Release projection
# -----------------------------------------------------------------------------

story_links_nulled = []

release_unready_quote_skips = []

explicit_exclusions =
  decisions.fetch(
    "release_quote_exclusions"
  )


projected_payloads =
  source_payloads.transform_values do |payload|
    Marshal.load(
      Marshal.dump(payload)
    )
  end


if channel == "release"
  exclusions_by_id =
    explicit_exclusions.to_h do |entry|
      [
        entry.fetch("quote_id"),
        entry
      ]
    end


  projected_payloads.each do |id, payload|
    next unless id.start_with?("theme.")

    payload["status"] = "approved"

    original_quotes =
      payload.fetch("quotes")


    payload["quotes"] =
      original_quotes.filter_map do |quote|
        quote_id =
          quote.fetch("id")


        # Explicit owner exclusion always wins.
        next if exclusions_by_id.key?(quote_id)


        # Quote remains in canonical/authoring,
        # but is not included in Release until lifecycle is valid.
        unless release_ready_review?(quote)
          release_unready_quote_skips << {
            "quote_id" => quote_id,
            "theme_id" => id,
            "review_status" => quote.dig("review", "status"),
            "reviewed_by" => quote.dig("review", "reviewed_by"),
            "reviewed_at" => quote.dig("review", "reviewed_at"),
            "rights_status" => quote.dig("rights", "status")
          }

          next
        end


        copy =
          Marshal.load(
            Marshal.dump(quote)
          )


        # Quote is release-ready, but its story is not.
        #
        # Keep the quote in Release but remove the story link.
        if copy["story_id"] &&
           !release_story_ids.include?(copy.fetch("story_id"))

          story_links_nulled << {
            "quote_id" => copy.fetch("id"),
            "story_id" => copy.fetch("story_id")
          }

          copy["story_id"] = nil
        end


        copy
      end
  end


  # Only Release-ready stories are projected.
  projected_payloads.delete_if do |id, _payload|
    id.start_with?("story.") &&
      !release_story_ids.include?(id)
  end


  # Reading Intent remains optional for Release.
  projected_payloads.delete_if do |_id, payload|
    payload["entity"] == "perspective_reading_intent_catalog" &&
      payload.fetch("status") != "approved"
  end
end


# -----------------------------------------------------------------------------
# Read existing output state
# -----------------------------------------------------------------------------

current_manifest_path =
  File.join(
    output_root,
    "manifest.json"
  )


current_manifest =
  if File.file?(current_manifest_path)
    read_json(current_manifest_path)
  end


current_descriptors =
  (current_manifest&.fetch("files") || [])
    .to_h do |entry|
      [
        entry.fetch("id"),
        entry
      ]
    end


audit_paths =
  Dir
    .glob(
      File.join(
        output_root,
        "audit/r*.json"
      )
    )
    .sort_by do |path|
      File
        .basename(path)[/\Ar(\d+)\.json\z/, 1]
        .to_i
    end


current_audit =
  if audit_paths.empty?
    nil
  else
    read_json(audit_paths.last)
  end


current_source_files =
  (current_audit&.fetch("source_files") || [])
    .to_h do |entry|
      [
        entry.fetch("id"),
        entry
      ]
    end


# -----------------------------------------------------------------------------
# Build output descriptors
# -----------------------------------------------------------------------------

descriptors = []

payload_bytes_by_path = {}


source_audit =
  (content_entries + fragment_entries).map do |entry|
    {
      "id" => entry.fetch("id"),
      "sha256" =>
        sha(
          File.binread(
            File.join(
              source_root,
              entry.fetch("path")
            )
          )
        ),
      "path" => entry.fetch("path")
    }
  end


changed = []

reused = []


payloads_by_kind =
  Hash.new do |hash, key|
    hash[key] = []
  end


content_entries.each do |source_entry|
  id =
    source_entry.fetch("id")

  kind =
    source_entry.fetch("kind")


  next if kind == "story" &&
          !projected_payloads.key?(id)


  next if kind == "reading_intent_catalog" &&
          !projected_payloads.key?(id)


  next if kind == "image" &&
          channel == "release" &&
          !release_image_ids.include?(id)


  previous =
    current_descriptors[id]


  source_bytes =
    File.binread(
      File.join(
        source_root,
        source_entry.fetch("path")
      )
    )


  if kind == "image"
    if previous &&
       File.binread(
         File.join(
           output_root,
           previous.fetch("path")
         )
       ) == source_bytes

      descriptors << previous
      reused << id

      next
    end


    revision =
      previous ?
        previous.fetch("revision") + 1 :
        1


    bytes =
      source_bytes

  else

    payload =
      projected_payloads.fetch(id)


    previous_payload =
      previous ?
        read_json(
          File.join(
            output_root,
            previous.fetch("path")
          )
        ) :
        nil


    if previous_payload &&
       without_revisions(previous_payload) ==
         without_revisions(payload)

      descriptors << previous
      reused << id

      next
    end


    revision =
      previous ?
        previous.fetch("revision") + 1 :
        1


    if kind == "story"
      payload["revision"] = revision

    elsif kind == "quote_pack"

      previous_quotes =
        (previous_payload&.fetch("quotes") || [])
          .to_h do |quote|
            [
              quote.fetch("id"),
              quote
            ]
          end


      payload.fetch("quotes").each do |quote|
        prior =
          previous_quotes[
            quote.fetch("id")
          ]


        quote["revision"] =
          if prior &&
             without_revisions(prior) ==
               without_revisions(quote)

            prior.fetch("revision")

          elsif prior

            prior.fetch("revision") + 1

          else

            quote.fetch("revision", 1)
          end
      end
    end


    payloads_by_kind[kind] << payload


    bytes =
      json_bytes(payload)
  end


  path =
    revisioned_path(
      source_entry.fetch("path"),
      revision
    )


  descriptor = {
    "id" => id,
    "kind" => kind,
    "revision" => revision,
    "path" => path,
    "media_type" => source_entry.fetch("media_type"),
    "sha256" => sha(bytes),
    "byte_count" => bytes.bytesize
  }


  descriptors << descriptor

  payload_bytes_by_path[path] =
    bytes

  changed << id
end


# -----------------------------------------------------------------------------
# No-op publish
# -----------------------------------------------------------------------------

if changed.empty? &&
   current_manifest

  puts(
    JSON.pretty_generate(
      "status" => "already_up_to_date",
      "channel" => channel,
      "library_revision" => current_manifest.fetch("library_revision"),
      "canonical_source_digest" => source_digest,
      "release_unready_quote_skip_count" =>
        release_unready_quote_skips.length,
      "story_links_projected_to_null_count" =>
        story_links_nulled.length
    )
  )

  exit(0)
end


# -----------------------------------------------------------------------------
# Build manifest
# -----------------------------------------------------------------------------

library_revision =
  current_manifest ?
    current_manifest.fetch("library_revision") + 1 :
    1


library_id =
  if channel == "authoring"
    "selflo.perspective.authoring.vi"
  else
    "selflo.perspective.vi"
  end


manifest = {
  "schema_version" => "1.0",
  "entity" => "perspective_library_manifest",
  "library_id" => library_id,
  "library_revision" => library_revision,
  "content_version" => source_index.fetch("content_version"),
  "language" => "vi",
  "generated_at" => Time.now.utc.iso8601,
  "files" =>
    descriptors.sort_by do |entry|
      [
        entry.fetch("kind"),
        entry.fetch("id")
      ]
    end
}


# -----------------------------------------------------------------------------
# Validate projected package
# -----------------------------------------------------------------------------

Dir.mktmpdir(
  "selflo-perspective-publish"
) do |temporary|

  payload_paths = []


  manifest.fetch("files").each do |descriptor|
    bytes =
      payload_bytes_by_path[
        descriptor.fetch("path")
      ] ||
      File.binread(
        File.join(
          output_root,
          descriptor.fetch("path")
        )
      )


    path =
      File.join(
        temporary,
        descriptor.fetch("path")
      )


    FileUtils.mkdir_p(
      File.dirname(path)
    )


    File.binwrite(
      path,
      bytes
    )


    unless descriptor.fetch("kind") == "image"
      payload_paths << [
        descriptor.fetch("kind"),
        path
      ]
    end
  end


  manifest_path =
    File.join(
      temporary,
      "manifest.json"
    )


  File.binwrite(
    manifest_path,
    json_bytes(manifest)
  )


  grouped =
    payload_paths
      .group_by(&:first)
      .transform_values do |items|
        items.map do |_kind, path|
          read_json(path)
        end
      end


  validate_references!(
    grouped,
    channel
  )


  if options[:validate_schema]
    run_schema_gate!(
      schema_root,
      manifest_path,
      payload_paths
    )
  end
end


# -----------------------------------------------------------------------------
# Write immutable output revisions
# -----------------------------------------------------------------------------

payload_bytes_by_path.each do |path, bytes|
  immutable_write(
    File.join(
      output_root,
      path
    ),
    bytes
  )
end


manifest_bytes =
  json_bytes(manifest)


atomic_write(
  current_manifest_path,
  manifest_bytes
)


# -----------------------------------------------------------------------------
# Audit
# -----------------------------------------------------------------------------

audit = {
  "schema_version" => "selflo.perspective.publish-audit.v1",
  "channel" => channel,
  "library_revision" => library_revision,
  "canonical_source_revision" => source_index.fetch("source_revision"),
  "canonical_source_digest" => source_digest,
  "canonical_quote_count" => source_index.fetch("canonical_quote_count"),

  "source_files" =>
    source_audit.sort_by do |entry|
      entry.fetch("id")
    end,

  "changed_file_ids" =>
    changed.sort,

  "reused_file_ids" =>
    reused.sort,

  "story_links_projected_to_null" =>
    story_links_nulled,

  "release_unready_quote_skips" =>
    release_unready_quote_skips,

  "explicit_quote_exclusions" =>
    explicit_exclusions,

  "manifest_sha256" =>
    sha(manifest_bytes),

  "generated_at" =>
    manifest.fetch("generated_at")
}


immutable_write(
  File.join(
    output_root,
    "audit/r#{library_revision}.json"
  ),
  json_bytes(audit)
)


# -----------------------------------------------------------------------------
# Result
# -----------------------------------------------------------------------------

puts(
  JSON.pretty_generate(
    "status" => "published_locally",
    "channel" => channel,
    "library_revision" => library_revision,
    "canonical_source_digest" => source_digest,
    "canonical_quote_count" => source_index.fetch("canonical_quote_count"),

    "changed_file_ids" =>
      changed.sort,

    "reused_file_ids" =>
      reused.sort,

    "release_unready_quote_skip_count" =>
      release_unready_quote_skips.length,

    "story_links_projected_to_null_count" =>
      story_links_nulled.length,

    "story_links_projected_to_null" =>
      story_links_nulled,

    "explicit_quote_exclusion_count" =>
      explicit_exclusions.length,

    "explicit_quote_exclusions" =>
      explicit_exclusions,

    "manifest_sha256" =>
      audit.fetch("manifest_sha256"),

    "output" =>
      output_root
  )
)