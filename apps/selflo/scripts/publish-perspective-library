#!/usr/bin/env ruby

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "set"
require "tmpdir"
require "time"


# =============================================================================
# CLI
# =============================================================================

options = {
  repo_root: File.expand_path("..", __dir__),
  validate_schema: true
}

OptionParser.new do |parser|
  parser.banner =
    "publish-perspective-library --channel authoring|release"

  parser.on("--channel CHANNEL") do |value|
    options[:channel] = value
  end

  parser.on("--repo-root PATH") do |value|
    options[:repo_root] =
      File.expand_path(value)
  end

  parser.on("--source PATH") do |value|
    options[:source] =
      File.expand_path(value)
  end

  parser.on("--schema-dir PATH") do |value|
    options[:schema_dir] =
      File.expand_path(value)
  end

  parser.on("--skip-schema") do
    options[:validate_schema] = false
  end
end.parse!


channel =
  options[:channel]

unless %w[authoring release].include?(channel)
  abort("--channel must be authoring or release")
end


repo_root =
  options.fetch(:repo_root)


source_root =
  options[:source] ||
  File.join(
    repo_root,
    "perspective-library/source/vi"
  )


output_root =
  File.join(
    repo_root,
    "perspective-library/#{channel}/vi"
  )


schema_root =
  options[:schema_dir] ||
  File.join(
    repo_root,
    "perspective-library/tooling/schema"
  )


# =============================================================================
# Release lifecycle constants
# =============================================================================

RELEASE_RIGHTS_STATUSES =
  Set.new(
    %w[
      selflo_owned
      public_domain
      licensed
      permission_granted
    ]
  ).freeze


# =============================================================================
# Generic helpers
# =============================================================================

def read_json(path)
  JSON.parse(
    File.binread(path)
  )
rescue Errno::ENOENT
  abort("Missing file: #{path}")
rescue JSON::ParserError => error
  abort(
    "Invalid JSON #{path}: #{error.message}"
  )
end


def json_bytes(value)
  JSON.pretty_generate(value) + "\n"
end


def sha(bytes)
  Digest::SHA256.hexdigest(bytes)
end


def deep_copy(value)
  Marshal.load(
    Marshal.dump(value)
  )
end


def atomic_write(path, bytes)
  FileUtils.mkdir_p(
    File.dirname(path)
  )

  temporary =
    "#{path}.next"

  File.binwrite(
    temporary,
    bytes
  )

  File.rename(
    temporary,
    path
  )
end


def immutable_write(path, bytes)
  FileUtils.mkdir_p(
    File.dirname(path)
  )

  if File.exist?(path)
    unless File.binread(path) == bytes
      abort(
        "Immutable path conflict: #{path}"
      )
    end

    return
  end

  File.binwrite(
    path,
    bytes
  )
end


def revisioned_path(source_path, revision)
  extension =
    File.extname(source_path)

  stem =
    source_path.delete_suffix(extension)

  "#{stem}.r#{revision}#{extension}"
end


def without_revisions(value)
  case value
  when Hash
    value.each_with_object({}) do |(key, child), result|
      next if key == "revision"

      result[key] =
        without_revisions(child)
    end

  when Array
    value.map do |child|
      without_revisions(child)
    end

  else
    value
  end
end


# =============================================================================
# Release readiness
# =============================================================================

def valid_release_review_timestamp?(value)
  return false unless value.is_a?(String)

  return false unless \
    value.end_with?("Z") ||
    value.end_with?("+00:00")

  parsed =
    Time.iso8601(value)

  parsed.utc_offset.zero?
rescue ArgumentError
  false
end


def release_ready_review?(entity)
  review =
    entity["review"] || {}

  rights =
    entity["rights"] || {}

  reviewer =
    review["reviewed_by"]

  review["status"] == "approved" &&
    reviewer.is_a?(String) &&
    !reviewer.strip.empty? &&
    valid_release_review_timestamp?(
      review["reviewed_at"]
    ) &&
    RELEASE_RIGHTS_STATUSES.include?(
      rights["status"]
    )
end


def release_ready_story?(story)
  story["status"] == "active" &&
    release_ready_review?(story)
end


def release_ready_concept?(concept)
  concept["status"] == "approved"
end


def release_ready_theory?(theory)
  theory["status"] == "approved" &&
    theory["validation_status"] ==
      "source_checked"
end


def release_ready_framework?(framework)
  framework["status"] == "approved" &&
    framework["validation_status"] ==
      "source_checked"
end


def release_ready_reference?(reference)
  reference["validation_status"] ==
    "source_checked"
end


# =============================================================================
# Canonical source
# =============================================================================

def validate_source_index!(
  source_root,
  index
)
  unless index.fetch("schema_version") ==
         "selflo.perspective.authoring-source.v1"

    abort(
      "Unsupported source schema"
    )
  end


  index.fetch("files").each do |entry|
    path =
      File.expand_path(
        entry.fetch("path"),
        source_root
      )

    root =
      source_root.end_with?("/") ?
        source_root :
        source_root + "/"


    unless path.start_with?(root)
      abort(
        "Unsafe source path: #{entry.fetch("path")}"
      )
    end


    unless File.file?(path)
      abort(
        "Missing source file: #{entry.fetch("path")}"
      )
    end
  end
end


def canonical_source_digest(
  source_root,
  index
)
  material =
    index.fetch("files")
      .sort_by do |entry|
        entry.fetch("path")
      end
      .map do |entry|
        path =
          File.join(
            source_root,
            entry.fetch("path")
          )

        digest =
          sha(
            File.binread(path)
          )

        "#{entry.fetch("path")}\0#{digest}"
      end
      .join("\n")

  sha(material)
end


# =============================================================================
# Dependency-based Knowledge projection
# =============================================================================

def project_release_knowledge(
  knowledge,
  themes,
  stories
)
  projected =
    deep_copy(knowledge)


  release_theme_ids =
    themes
      .map do |theme|
        theme.fetch("primary_theme")
      end
      .to_set


  concepts_by_id =
    knowledge
      .fetch("concepts")
      .to_h do |item|
        [
          item.fetch("id"),
          item
        ]
      end


  theories_by_id =
    knowledge
      .fetch("theories")
      .to_h do |item|
        [
          item.fetch("id"),
          item
        ]
      end


  frameworks_by_id =
    knowledge
      .fetch("frameworks")
      .to_h do |item|
        [
          item.fetch("id"),
          item
        ]
      end


  references_by_id =
    knowledge
      .fetch("references")
      .to_h do |item|
        [
          item.fetch("id"),
          item
        ]
      end


  theory_by_truth_id = {}

  knowledge
    .fetch("theories")
    .each do |theory|

      theory
        .fetch("core_truths")
        .each do |truth|

          truth_id =
            truth.fetch("id")


          if theory_by_truth_id.key?(
               truth_id
             )

            abort(
              "Core truth belongs to more than one theory: #{truth_id}"
            )
          end


          theory_by_truth_id[
            truth_id
          ] =
            theory.fetch("id")
        end
    end


  required_concepts =
    Set.new

  required_theories =
    Set.new

  required_frameworks =
    Set.new

  required_references =
    Set.new

  required_truths =
    Set.new


  # ---------------------------------------------------------------------------
  # Dependencies directly referenced by Release quotes
  # ---------------------------------------------------------------------------

  themes.each do |theme|
    theme
      .fetch("quotes")
      .each do |quote|

        metadata =
          quote["metadata"] || {}


        Array(
          metadata["concepts"]
        ).each do |id|

          required_concepts << id
        end


        Array(
          metadata["theories"]
        ).each do |id|

          required_theories << id
        end


        Array(
          metadata["frameworks"]
        ).each do |id|

          required_frameworks << id
        end


        knowledge_basis =
          quote["knowledge_basis"] || {}


        Array(
          knowledge_basis[
            "core_truth_ids"
          ]
        ).each do |id|

          required_truths << id
        end


        Array(
          knowledge_basis[
            "reference_ids"
          ]
        ).each do |id|

          required_references << id
        end
      end
  end


  # ---------------------------------------------------------------------------
  # Dependencies directly referenced by Release stories
  # ---------------------------------------------------------------------------

  stories.each do |story|
    metadata =
      story["metadata"] || {}


    Array(
      metadata["concept_ids"]
    ).each do |id|

      required_concepts << id
    end
  end


  # ---------------------------------------------------------------------------
  # Core truth -> owning theory
  # ---------------------------------------------------------------------------

  required_truths.each do |truth_id|
    theory_id =
      theory_by_truth_id[
        truth_id
      ]


    unless theory_id
      abort(
        "Release dependency missing core truth: #{truth_id}"
      )
    end


    required_theories <<
      theory_id
  end


  # ---------------------------------------------------------------------------
  # Concept dependencies
  # ---------------------------------------------------------------------------

  required_concepts.to_a.each do |concept_id|
    concept =
      concepts_by_id[
        concept_id
      ]


    unless concept
      abort(
        "Release dependency missing concept: #{concept_id}"
      )
    end


    Array(
      concept[
        "related_theory_ids"
      ]
    ).each do |id|

      required_theories << id
    end


    Array(
      concept[
        "related_framework_ids"
      ]
    ).each do |id|

      required_frameworks << id
    end
  end


  # ---------------------------------------------------------------------------
  # Validate concepts
  # ---------------------------------------------------------------------------

  required_concepts.each do |concept_id|
    concept =
      concepts_by_id[
        concept_id
      ]


    unless concept
      abort(
        "Release dependency missing concept: #{concept_id}"
      )
    end


    unless release_ready_concept?(
             concept
           )

      abort(
        "Release concept not approved: #{concept_id}"
      )
    end
  end


  # ---------------------------------------------------------------------------
  # Theory dependencies + references
  # ---------------------------------------------------------------------------

  required_theories.each do |theory_id|
    theory =
      theories_by_id[
        theory_id
      ]


    unless theory
      abort(
        "Release dependency missing theory: #{theory_id}"
      )
    end


    unless release_ready_theory?(
             theory
           )

      abort(
        "Release theory not approved/source_checked: #{theory_id}"
      )
    end


    Array(
      theory["reference_ids"]
    ).each do |id|

      required_references << id
    end
  end


  # ---------------------------------------------------------------------------
  # Framework dependencies + references
  # ---------------------------------------------------------------------------

  required_frameworks.each do |framework_id|
    framework =
      frameworks_by_id[
        framework_id
      ]


    unless framework
      abort(
        "Release dependency missing framework: #{framework_id}"
      )
    end


    unless release_ready_framework?(
             framework
           )

      abort(
        "Release framework not approved/source_checked: #{framework_id}"
      )
    end


    Array(
      framework["reference_ids"]
    ).each do |id|

      required_references << id
    end
  end


  # ---------------------------------------------------------------------------
  # References
  # ---------------------------------------------------------------------------

  required_references.each do |reference_id|
    reference =
      references_by_id[
        reference_id
      ]


    unless reference
      abort(
        "Release dependency missing reference: #{reference_id}"
      )
    end


    unless release_ready_reference?(
             reference
           )

      abort(
        "Release reference not source_checked: #{reference_id}"
      )
    end
  end


  # ---------------------------------------------------------------------------
  # Project concepts
  #
  # IMPORTANT:
  # A concept can reference several canonical themes.
  # Partial Release may contain only one of them.
  #
  # Keep only Release-visible theme references.
  # ---------------------------------------------------------------------------

  projected_concepts =
    knowledge
      .fetch("concepts")
      .select do |item|

        required_concepts.include?(
          item.fetch("id")
        )
      end
      .map do |item|

        copy =
          deep_copy(item)


        if copy.key?(
             "primary_theme_ids"
           )

          copy[
            "primary_theme_ids"
          ] =
            Array(
              copy["primary_theme_ids"]
            ).select do |theme_id|

              release_theme_ids.include?(
                theme_id
              )
            end
        end


        copy
      end


  projected_theories =
    knowledge
      .fetch("theories")
      .select do |item|

        required_theories.include?(
          item.fetch("id")
        )
      end


  projected_frameworks =
    knowledge
      .fetch("frameworks")
      .select do |item|

        required_frameworks.include?(
          item.fetch("id")
        )
      end


  projected_references =
    knowledge
      .fetch("references")
      .select do |item|

        required_references.include?(
          item.fetch("id")
        )
      end


  # Release catalog is a generated projection containing only validated
  # dependencies. This does NOT modify canonical Knowledge lifecycle.
  projected["status"] =
    "approved"

  projected["concepts"] =
    projected_concepts

  projected["theories"] =
    projected_theories

  projected["frameworks"] =
    projected_frameworks

  projected["references"] =
    projected_references


  audit = {
    "concept_ids" =>
      required_concepts
        .to_a
        .sort,

    "theory_ids" =>
      required_theories
        .to_a
        .sort,

    "framework_ids" =>
      required_frameworks
        .to_a
        .sort,

    "reference_ids" =>
      required_references
        .to_a
        .sort,

    "core_truth_ids" =>
      required_truths
        .to_a
        .sort
  }


  [
    projected,
    audit
  ]
end


# =============================================================================
# Referential integrity
# =============================================================================

def validate_references!(
  payloads,
  channel
)
  knowledge =
    payloads
      .fetch("knowledge_catalog")
      .fetch(0)


  themes =
    payloads.fetch(
      "quote_pack"
    )


  stories =
    payloads.fetch(
      "story",
      []
    )


  reading_intent_catalogs =
    payloads.fetch(
      "reading_intent_catalog",
      []
    )


  quotes =
    themes.flat_map do |theme|
      theme.fetch("quotes")
    end


  theme_ids =
    themes
      .map do |theme|
        theme.fetch("primary_theme")
      end
      .to_set


  quote_ids =
    quotes.map do |quote|
      quote.fetch("id")
    end


  story_ids =
    stories
      .map do |story|
        story.fetch("id")
      end
      .to_set


  concepts =
    knowledge
      .fetch("concepts")
      .map do |item|
        item.fetch("id")
      end
      .to_set


  theories =
    knowledge
      .fetch("theories")
      .map do |item|
        item.fetch("id")
      end
      .to_set


  frameworks =
    knowledge
      .fetch("frameworks")
      .map do |item|
        item.fetch("id")
      end
      .to_set


  truths =
    knowledge
      .fetch("theories")
      .flat_map do |item|

        item
          .fetch("core_truths")
          .map do |truth|

            truth.fetch("id")
          end
      end
      .to_set


  references =
    knowledge
      .fetch("references")
      .map do |item|
        item.fetch("id")
      end
      .to_set


  # ---------------------------------------------------------------------------
  # Global uniqueness
  # ---------------------------------------------------------------------------

  unless quote_ids.uniq.length ==
         quote_ids.length

    abort(
      "Quote IDs are not unique"
    )
  end


  unless theme_ids.length ==
         themes.length

    abort(
      "Theme IDs are not unique"
    )
  end


  # ---------------------------------------------------------------------------
  # Quote references
  # ---------------------------------------------------------------------------

  quotes.each do |quote|
    quote_id =
      quote.fetch("id")


    unless theme_ids.include?(
             quote.fetch(
               "primary_theme"
             )
           )

      abort(
        "Theme mismatch: #{quote_id}"
      )
    end


    if quote["story_id"] &&
       !story_ids.include?(
         quote.fetch("story_id")
       )

      abort(
        "Broken story: #{quote_id}"
      )
    end


    metadata =
      quote["metadata"] || {}


    {
      "concepts" =>
        concepts,

      "theories" =>
        theories,

      "frameworks" =>
        frameworks
    }.each do |field, valid|

      values =
        Array(
          metadata[field]
        )


      missing =
        values.reject do |value|
          valid.include?(value)
        end


      unless missing.empty?
        abort(
          "Broken #{field} on #{quote_id}: #{missing.join(", ")}"
        )
      end
    end


    next unless quote[
      "knowledge_basis"
    ]


    missing_truths =
      Array(
        quote.dig(
          "knowledge_basis",
          "core_truth_ids"
        )
      ).reject do |value|

        truths.include?(value)
      end


    missing_refs =
      Array(
        quote.dig(
          "knowledge_basis",
          "reference_ids"
        )
      ).reject do |value|

        references.include?(value)
      end


    unless missing_truths.empty?
      abort(
        "Broken core truth on #{quote_id}: #{missing_truths.join(", ")}"
      )
    end


    unless missing_refs.empty?
      abort(
        "Broken reference on #{quote_id}: #{missing_refs.join(", ")}"
      )
    end
  end


  # ---------------------------------------------------------------------------
  # Story references
  # ---------------------------------------------------------------------------

  stories.each do |story|
    story_id =
      story.fetch("id")


    unless theme_ids.include?(
             story.fetch(
               "primary_theme"
             )
           )

      abort(
        "Unknown story theme #{story_id}"
      )
    end


    concept_ids =
      Array(
        story.dig(
          "metadata",
          "concept_ids"
        )
      )


    missing =
      concept_ids.reject do |value|
        concepts.include?(value)
      end


    unless missing.empty?
      abort(
        "Broken story concept #{story_id}: #{missing.join(", ")}"
      )
    end
  end


  # ---------------------------------------------------------------------------
  # Strict Story ownership
  #
  # Every released story must have exactly one released owning quote.
  # Quotes are still allowed to have no story.
  # ---------------------------------------------------------------------------

  story_owner_counts =
    Hash.new(0)


  quotes.each do |quote|
    next unless quote["story_id"]

    story_owner_counts[
      quote.fetch("story_id")
    ] += 1
  end


  stories.each do |story|
    story_id =
      story.fetch("id")

    count =
      story_owner_counts[
        story_id
      ]


    unless count == 1
      abort(
        "Release story must have exactly one owning quote: #{story_id} has #{count}"
      )
    end
  end


  # ---------------------------------------------------------------------------
  # Reading Intent
  # ---------------------------------------------------------------------------

  if reading_intent_catalogs.length > 1
    abort(
      "More than one Reading Intent Catalog"
    )
  end


  reading_intent_catalogs.each do |catalog|
    intent_ids =
      catalog
        .fetch("intents")
        .map do |intent|

          intent.fetch("id")
        end


    unless intent_ids.uniq.length ==
           intent_ids.length

      abort(
        "Reading intent IDs are not unique"
      )
    end


    catalog
      .fetch("intents")
      .each do |intent|

        memberships =
          intent.fetch(
            "story_ids"
          )


        unless memberships.uniq.length ==
               memberships.length

          abort(
            "Duplicate story membership on #{intent.fetch("id")}"
          )
        end


        missing =
          memberships.reject do |story_id|
            story_ids.include?(
              story_id
            )
          end


        unless missing.empty?
          abort(
            "Broken reading-intent story on #{intent.fetch("id")}: #{missing.join(", ")}"
          )
        end
      end
  end


  # ---------------------------------------------------------------------------
  # Knowledge references
  # ---------------------------------------------------------------------------

  knowledge
    .fetch("concepts")
    .each do |concept|

      concept_id =
        concept.fetch("id")


      theme_refs =
        Array(
          concept[
            "primary_theme_ids"
          ]
        )


      unless theme_refs.all? do |id|
        theme_ids.include?(id)
      end

        abort(
          "Broken concept theme #{concept_id}"
        )
      end


      theory_refs =
        Array(
          concept[
            "related_theory_ids"
          ]
        )


      unless theory_refs.all? do |id|
        theories.include?(id)
      end

        abort(
          "Broken related theory #{concept_id}"
        )
      end


      framework_refs =
        Array(
          concept[
            "related_framework_ids"
          ]
        )


      unless framework_refs.all? do |id|
        frameworks.include?(id)
      end

        abort(
          "Broken related framework #{concept_id}"
        )
      end
    end


  knowledge
    .fetch("theories")
    .each do |theory|

      theory_id =
        theory.fetch("id")


      reference_ids =
        Array(
          theory[
            "reference_ids"
          ]
        )


      unless reference_ids.all? do |id|
        references.include?(id)
      end

        abort(
          "Broken theory reference #{theory_id}"
        )
      end
    end


  knowledge
    .fetch("frameworks")
    .each do |framework|

      framework_id =
        framework.fetch("id")


      reference_ids =
        Array(
          framework[
            "reference_ids"
          ]
        )


      unless reference_ids.all? do |id|
        references.include?(id)
      end

        abort(
          "Broken framework reference #{framework_id}"
        )
      end
    end


  # ---------------------------------------------------------------------------
  # Release-specific lifecycle validation
  # ---------------------------------------------------------------------------

  return unless channel == "release"


  unless knowledge["status"] ==
         "approved"

    abort(
      "Projected Release Knowledge Catalog is not approved"
    )
  end


  knowledge
    .fetch("concepts")
    .each do |item|

      unless release_ready_concept?(
               item
             )

        abort(
          "Release concept not approved: #{item.fetch("id")}"
        )
      end
    end


  knowledge
    .fetch("theories")
    .each do |item|

      unless release_ready_theory?(
               item
             )

        abort(
          "Release theory not approved/source_checked: #{item.fetch("id")}"
        )
      end
    end


  knowledge
    .fetch("frameworks")
    .each do |item|

      unless release_ready_framework?(
               item
             )

        abort(
          "Release framework not approved/source_checked: #{item.fetch("id")}"
        )
      end
    end


  knowledge
    .fetch("references")
    .each do |item|

      unless release_ready_reference?(
               item
             )

        abort(
          "Release reference not source_checked: #{item.fetch("id")}"
        )
      end
    end


  reading_intent_catalogs.each do |catalog|
    unless catalog["status"] ==
           "approved"

      abort(
        "Release Reading Intent Catalog is not approved"
      )
    end
  end
end


# =============================================================================
# JSON Schema gate
# =============================================================================

def run_schema_gate!(
  schema_root,
  manifest_path,
  payload_paths
)
  schemas = {
    "knowledge_catalog" =>
      "perspective-knowledge.schema.json",

    "quote_pack" =>
      "perspective-theme.schema.json",

    "reading_intent_catalog" =>
      "perspective-reading-intent.schema.json",

    "story" =>
      "perspective-story.schema.json",

    "manifest" =>
      "perspective-library-manifest.schema.json"
  }


  checks =
    payload_paths +
    [
      [
        "manifest",
        manifest_path
      ]
    ]


  checks.each do |kind, path|
    schema =
      File.join(
        schema_root,
        schemas.fetch(kind)
      )


    unless File.file?(schema)
      abort(
        "Missing schema: #{schema}"
      )
    end


    command = [
      "npx",
      "--yes",
      "--package=ajv-cli@5.0.0",
      "--package=ajv-formats@3.0.1",
      "ajv",
      "validate",
      "--spec=draft2020",
      "-c",
      "ajv-formats",
      "-s",
      schema,
      "-d",
      path
    ]


    stdout,
    stderr,
    status =
      Open3.capture3(
        *command
      )


    unless status.success?
      abort(
        "Schema validation failed for #{path}:\n#{stdout}#{stderr}"
      )
    end
  end
end


# =============================================================================
# Load source index
# =============================================================================

source_index =
  read_json(
    File.join(
      source_root,
      "source.json"
    )
  )


validate_source_index!(
  source_root,
  source_index
)


source_digest =
  canonical_source_digest(
    source_root,
    source_index
  )


content_entries =
  source_index
    .fetch("files")
    .select do |entry|

      %w[
        knowledge_catalog
        quote_pack
        reading_intent_catalog
        story
        image
      ].include?(
        entry.fetch("kind")
      )
    end


knowledge_entries =
  content_entries.select do |entry|
    entry.fetch("kind") ==
      "knowledge_catalog"
  end


unless knowledge_entries.length == 1
  abort(
    "Canonical source must contain exactly one Knowledge Catalog"
  )
end


reading_intent_entries =
  content_entries.select do |entry|
    entry.fetch("kind") ==
      "reading_intent_catalog"
  end


if reading_intent_entries.length > 1
  abort(
    "Canonical source may contain at most one Reading Intent Catalog"
  )
end


knowledge_entry =
  knowledge_entries.fetch(0)


knowledge_id =
  knowledge_entry.fetch("id")


# =============================================================================
# Owner decision ledger
# =============================================================================

decisions_entry =
  source_index
    .fetch("files")
    .find do |entry|

      entry.fetch("kind") ==
        "authoring_decisions"
    end


unless decisions_entry
  abort(
    "Missing decision ledger"
  )
end


decisions =
  read_json(
    File.join(
      source_root,
      decisions_entry.fetch("path")
    )
  )


unless decisions[
  "owner_gate_status"
] == "approved"

  abort(
    "Owner has not approved CP-003"
  )
end


explicit_exclusions =
  decisions.fetch(
    "release_quote_exclusions",
    []
  )


# =============================================================================
# Load canonical content payloads
# =============================================================================

source_payloads =
  content_entries
    .reject do |entry|

      entry.fetch("kind") ==
        "image"
    end
    .to_h do |entry|

      [
        entry.fetch("id"),

        read_json(
          File.join(
            source_root,
            entry.fetch("path")
          )
        )
      ]
    end


# =============================================================================
# Quote fragments
# =============================================================================

fragment_entries =
  source_index
    .fetch("files")
    .select do |entry|

      entry.fetch("kind") ==
        "quote_fragment"
    end


fragments_by_id =
  fragment_entries.to_h do |entry|
    payload =
      read_json(
        File.join(
          source_root,
          entry.fetch("path")
        )
      )


    unless payload[
      "schema_version"
    ] ==
      "selflo.perspective.quote-fragment.v1"

      abort(
        "Unsupported quote fragment schema: #{entry.fetch("id")}"
      )
    end


    unless payload[
      "entity"
    ] ==
      "perspective_quote_fragment"

      abort(
        "Invalid quote fragment entity: #{entry.fetch("id")}"
      )
    end


    unless payload[
      "fragment_id"
    ] ==
      entry.fetch("id")

      abort(
        "Quote fragment ID mismatch: #{entry.fetch("id")}"
      )
    end


    unless payload[
      "quotes"
    ].is_a?(Array) &&
      !payload[
        "quotes"
      ].empty?

      abort(
        "Quote fragment must contain quotes: #{entry.fetch("id")}"
      )
    end


    [
      entry.fetch("id"),
      payload
    ]
  end


used_fragment_ids = []


source_payloads.each do |id, payload|
  next unless id.start_with?(
    "theme."
  )

  next unless payload.key?(
    "quote_fragment_ids"
  )


  fragment_ids =
    payload.delete(
      "quote_fragment_ids"
    )


  unless fragment_ids.is_a?(Array) &&
         !fragment_ids.empty?

    abort(
      "Theme source has no quote fragments: #{id}"
    )
  end


  fragments =
    fragment_ids.map do |fragment_id|
      fragment =
        fragments_by_id[
          fragment_id
        ]


      unless fragment
        abort(
          "Missing quote fragment #{fragment_id} for #{id}"
        )
      end


      unless fragment[
        "primary_theme"
      ] ==
        payload[
          "primary_theme"
        ]

        abort(
          "Quote fragment theme mismatch: #{fragment_id}"
        )
      end


      fragment
    end


  used_fragment_ids.concat(
    fragment_ids
  )


  payload["quotes"] =
    fragments.flat_map do |fragment|

      fragment.fetch("quotes")
    end
end


unless used_fragment_ids.uniq.length ==
       used_fragment_ids.length

  abort(
    "Quote fragment referenced more than once"
  )
end


unused_fragment_ids =
  fragments_by_id.keys -
  used_fragment_ids


unless unused_fragment_ids.empty?
  abort(
    "Unreferenced quote fragments: #{unused_fragment_ids.join(", ")}"
  )
end


# =============================================================================
# Release-ready canonical stories
# =============================================================================

stories_by_id =
  source_payloads.select do |id, _payload|

    id.start_with?(
      "story."
    )
  end


release_ready_story_ids =
  stories_by_id
    .select do |_id, story|

      release_ready_story?(
        story
      )
    end
    .keys
    .to_set


# =============================================================================
# Project channel
# =============================================================================

projected_payloads =
  source_payloads
    .transform_values do |payload|

      deep_copy(payload)
    end


story_links_nulled = []

release_unready_quote_skips = []

release_empty_theme_skips = []

release_unpaired_story_skips = []

reading_intent_story_memberships_removed = []


release_knowledge_projection = {
  "concept_ids" => [],
  "theory_ids" => [],
  "framework_ids" => [],
  "reference_ids" => [],
  "core_truth_ids" => []
}


actual_release_story_ids =
  Set.new


release_image_ids =
  Set.new


if channel == "release"

  # ---------------------------------------------------------------------------
  # Explicit exclusions
  # ---------------------------------------------------------------------------

  exclusion_ids =
    explicit_exclusions.map do |entry|

      entry.fetch("quote_id")
    end


  if exclusion_ids.uniq.length !=
     exclusion_ids.length

    abort(
      "Duplicate explicit quote exclusion"
    )
  end


  canonical_quote_ids =
    source_payloads
      .select do |id, _payload|

        id.start_with?(
          "theme."
        )
      end
      .values
      .flat_map do |theme|

        theme.fetch("quotes")
      end
      .map do |quote|

        quote.fetch("id")
      end
      .to_set


  unknown_exclusions =
    exclusion_ids.reject do |id|

      canonical_quote_ids.include?(
        id
      )
    end


  unless unknown_exclusions.empty?
    abort(
      "Unknown explicit quote exclusion(s): #{unknown_exclusions.join(", ")}"
    )
  end


  exclusions_by_id =
    explicit_exclusions.to_h do |entry|

      [
        entry.fetch("quote_id"),
        entry
      ]
    end


  # ---------------------------------------------------------------------------
  # Quote projection
  # ---------------------------------------------------------------------------

  projected_payloads.each do |id, payload|
    next unless id.start_with?(
      "theme."
    )


    payload["status"] =
      "approved"


    original_quotes =
      payload.fetch("quotes")


    payload["quotes"] =
      original_quotes.map do |quote|

        quote_id =
          quote.fetch("id")


        # Owner explicitly withheld this quote.
        next nil if exclusions_by_id.key?(
          quote_id
        )


        # Pending/unverified quote stays canonical + authoring only.
        unless release_ready_review?(
                 quote
               )

          release_unready_quote_skips << {
            "quote_id" =>
              quote_id,

            "theme_id" =>
              id,

            "review_status" =>
              quote.dig(
                "review",
                "status"
              ),

            "reviewed_by" =>
              quote.dig(
                "review",
                "reviewed_by"
              ),

            "reviewed_at" =>
              quote.dig(
                "review",
                "reviewed_at"
              ),

            "rights_status" =>
              quote.dig(
                "rights",
                "status"
              )
          }


          next nil
        end


        copy =
          deep_copy(
            quote
          )


        # Quote can ship without its story.
        if copy["story_id"] &&
           !release_ready_story_ids.include?(
             copy.fetch("story_id")
           )

          story_links_nulled << {
            "quote_id" =>
              copy.fetch("id"),

            "story_id" =>
              copy.fetch("story_id")
          }


          copy["story_id"] =
            nil
        end


        copy

      end.compact
  end


  # ---------------------------------------------------------------------------
  # Remove empty Release themes
  # ---------------------------------------------------------------------------

  projected_payloads.delete_if do |id, payload|
    next false unless id.start_with?(
      "theme."
    )


    next false unless payload
      .fetch("quotes")
      .empty?


    release_empty_theme_skips << {
      "theme_id" =>
        id,

      "primary_theme" =>
        payload[
          "primary_theme"
        ]
    }


    true
  end


  # ---------------------------------------------------------------------------
  # Determine which stories still have a released owning quote
  # ---------------------------------------------------------------------------

  released_quote_story_ids =
    projected_payloads
      .select do |id, _payload|

        id.start_with?(
          "theme."
        )
      end
      .values
      .flat_map do |theme|

        theme.fetch("quotes")
      end
      .map do |quote|

        quote["story_id"]
      end
      .compact
      .to_set


  # ---------------------------------------------------------------------------
  # Story projection
  #
  # A story is Release-visible only when:
  #   1. story itself is Release-ready
  #   2. at least one Release quote still points to it
  #
  # Strict one-quote-per-story is validated later.
  # ---------------------------------------------------------------------------

  projected_payloads.delete_if do |id, _payload|
    next false unless id.start_with?(
      "story."
    )


    unless release_ready_story_ids.include?(
             id
           )

      next true
    end


    unless released_quote_story_ids.include?(
             id
           )

      release_unpaired_story_skips << {
        "story_id" =>
          id,

        "reason" =>
          "no_release_ready_owning_quote"
      }


      next true
    end


    false
  end


  actual_release_story_ids =
    projected_payloads
      .select do |id, _payload|

        id.start_with?(
          "story."
        )
      end
      .keys
      .to_set


  # ---------------------------------------------------------------------------
  # Safety:
  # if a story vanished after pairing projection, remove dangling links.
  #
  # Normally this should not happen, but it keeps projection internally safe.
  # ---------------------------------------------------------------------------

  projected_payloads.each do |id, payload|
    next unless id.start_with?(
      "theme."
    )


    payload.fetch("quotes").each do |quote|
      next unless quote["story_id"]

      next if actual_release_story_ids.include?(
        quote.fetch("story_id")
      )


      story_links_nulled << {
        "quote_id" =>
          quote.fetch("id"),

        "story_id" =>
          quote.fetch("story_id")
      }


      quote["story_id"] =
        nil
    end
  end


  # ---------------------------------------------------------------------------
  # Release images only for stories actually in Release
  # ---------------------------------------------------------------------------

  release_image_ids =
    projected_payloads
      .select do |id, _payload|

        id.start_with?(
          "story."
        )
      end
      .values
      .map do |story|

        story.dig(
          "hero_image",
          "file_id"
        )
      end
      .compact
      .to_set


  # ---------------------------------------------------------------------------
  # Reading Intent projection
  # ---------------------------------------------------------------------------

  projected_payloads.each do |_id, payload|
    next unless payload[
      "entity"
    ] ==
      "perspective_reading_intent_catalog"


    next unless payload[
      "status"
    ] ==
      "approved"


    payload
      .fetch("intents")
      .each do |intent|

        original_story_ids =
          intent.fetch(
            "story_ids"
          )


        retained_story_ids =
          original_story_ids.select do |story_id|

            actual_release_story_ids.include?(
              story_id
            )
          end


        removed_story_ids =
          original_story_ids -
          retained_story_ids


        removed_story_ids.each do |story_id|
          reading_intent_story_memberships_removed << {
            "intent_id" =>
              intent.fetch("id"),

            "story_id" =>
              story_id
          }
        end


        intent["story_ids"] =
          retained_story_ids
      end
  end


  # Unapproved Reading Intent Catalog remains Authoring-only.
  projected_payloads.delete_if do |_id, payload|

    payload["entity"] ==
      "perspective_reading_intent_catalog" &&
      payload["status"] !=
        "approved"
  end


  # ---------------------------------------------------------------------------
  # Knowledge dependency projection
  # ---------------------------------------------------------------------------

  release_themes =
    projected_payloads
      .select do |id, _payload|

        id.start_with?(
          "theme."
        )
      end
      .values


  release_stories =
    projected_payloads
      .select do |id, _payload|

        id.start_with?(
          "story."
        )
      end
      .values


  canonical_knowledge =
    source_payloads.fetch(
      knowledge_id
    )


  projected_knowledge,
  release_knowledge_projection =
    project_release_knowledge(
      canonical_knowledge,
      release_themes,
      release_stories
    )


  projected_payloads[
    knowledge_id
  ] =
    projected_knowledge
end


# =============================================================================
# Existing generated output
# =============================================================================

current_manifest_path =
  File.join(
    output_root,
    "manifest.json"
  )


current_manifest =
  if File.file?(
       current_manifest_path
     )

    read_json(
      current_manifest_path
    )

  else
    nil
  end


current_descriptors =
  (
    current_manifest&.fetch(
      "files"
    ) || []
  ).to_h do |entry|

    [
      entry.fetch("id"),
      entry
    ]
  end


audit_paths =
  Dir.glob(
    File.join(
      output_root,
      "audit/r*.json"
    )
  ).sort_by do |path|

    File.basename(path)[
      /\Ar(\d+)\.json\z/,
      1
    ].to_i
  end


# =============================================================================
# Build generated descriptors
# =============================================================================

descriptors = []

payload_bytes_by_path = {}

changed = []

reused = []


source_audit =
  (
    content_entries +
    fragment_entries
  ).map do |entry|

    {
      "id" =>
        entry.fetch("id"),

      "sha256" =>
        sha(
          File.binread(
            File.join(
              source_root,
              entry.fetch("path")
            )
          )
        ),

      "path" =>
        entry.fetch("path")
    }
  end


content_entries.each do |source_entry|
  id =
    source_entry.fetch("id")


  kind =
    source_entry.fetch("kind")


  # ---------------------------------------------------------------------------
  # Entity omitted from projected channel
  # ---------------------------------------------------------------------------

  if kind == "story" &&
     !projected_payloads.key?(
       id
     )

    next
  end


  if kind ==
       "reading_intent_catalog" &&
     !projected_payloads.key?(
       id
     )

    next
  end


  if kind ==
       "quote_pack" &&
     !projected_payloads.key?(
       id
     )

    next
  end


  if kind == "image" &&
     channel == "release" &&
     !release_image_ids.include?(
       id
     )

    next
  end


  previous =
    current_descriptors[
      id
    ]


  source_bytes =
    File.binread(
      File.join(
        source_root,
        source_entry.fetch("path")
      )
    )


  # ---------------------------------------------------------------------------
  # Image
  # ---------------------------------------------------------------------------

  if kind == "image"
    if previous
      previous_path =
        File.join(
          output_root,
          previous.fetch("path")
        )


      if File.file?(previous_path) &&
         File.binread(previous_path) ==
           source_bytes

        descriptors <<
          previous

        reused <<
          id

        next
      end
    end


    revision =
      previous ?
        previous.fetch("revision") + 1 :
        1


    bytes =
      source_bytes


  # ---------------------------------------------------------------------------
  # JSON payload
  # ---------------------------------------------------------------------------

  else
    payload =
      projected_payloads.fetch(
        id
      )


    previous_payload =
      if previous
        previous_path =
          File.join(
            output_root,
            previous.fetch("path")
          )


        if File.file?(
             previous_path
           )

          read_json(
            previous_path
          )

        else
          nil
        end

      else
        nil
      end


    if previous_payload &&
       without_revisions(
         previous_payload
       ) ==
       without_revisions(
         payload
       )

      descriptors <<
        previous

      reused <<
        id

      next
    end


    revision =
      previous ?
        previous.fetch("revision") + 1 :
        1


    # Story file revision
    if kind == "story"
      payload["revision"] =
        revision


    # Quote-level revisions
    elsif kind ==
          "quote_pack"

      previous_quotes =
        (
          previous_payload&.fetch(
            "quotes"
          ) || []
        ).to_h do |quote|

          [
            quote.fetch("id"),
            quote
          ]
        end


      payload
        .fetch("quotes")
        .each do |quote|

          prior =
            previous_quotes[
              quote.fetch("id")
            ]


          quote["revision"] =
            if prior &&
               without_revisions(
                 prior
               ) ==
               without_revisions(
                 quote
               )

              prior.fetch(
                "revision"
              )

            elsif prior

              prior.fetch(
                "revision"
              ) + 1

            else

              quote.fetch(
                "revision",
                1
              )
            end
        end
    end


    bytes =
      json_bytes(
        payload
      )
  end


  path =
    revisioned_path(
      source_entry.fetch("path"),
      revision
    )


  descriptor = {
    "id" =>
      id,

    "kind" =>
      kind,

    "revision" =>
      revision,

    "path" =>
      path,

    "media_type" =>
      source_entry.fetch(
        "media_type"
      ),

    "sha256" =>
      sha(bytes),

    "byte_count" =>
      bytes.bytesize
  }


  descriptors <<
    descriptor


  payload_bytes_by_path[
    path
  ] =
    bytes


  changed <<
    id
end


# =============================================================================
# No-op
# =============================================================================

if changed.empty? &&
   current_manifest

  puts(
    JSON.pretty_generate(
      {
        "status" =>
          "already_up_to_date",

        "channel" =>
          channel,

        "library_revision" =>
          current_manifest.fetch(
            "library_revision"
          ),

        "canonical_source_digest" =>
          source_digest,

        "release_unready_quote_skip_count" =>
          release_unready_quote_skips.length,

        "release_empty_theme_skip_count" =>
          release_empty_theme_skips.length,

        "release_unpaired_story_skip_count" =>
          release_unpaired_story_skips.length,

        "story_links_projected_to_null_count" =>
          story_links_nulled.length,

        "reading_intent_membership_removal_count" =>
          reading_intent_story_memberships_removed.length,

        "release_knowledge_projection" =>
          release_knowledge_projection
      }
    )
  )

  exit(0)
end


# =============================================================================
# Manifest
# =============================================================================

library_revision =
  current_manifest ?
    current_manifest.fetch(
      "library_revision"
    ) + 1 :
    1


library_id =
  if channel == "authoring"

    "selflo.perspective.authoring.vi"

  else

    "selflo.perspective.vi"
  end


manifest = {
  "schema_version" =>
    "1.0",

  "entity" =>
    "perspective_library_manifest",

  "library_id" =>
    library_id,

  "library_revision" =>
    library_revision,

  "content_version" =>
    source_index.fetch(
      "content_version"
    ),

  "language" =>
    "vi",

  "generated_at" =>
    Time.now.utc.iso8601,

  "files" =>
    descriptors.sort_by do |entry|

      [
        entry.fetch("kind"),
        entry.fetch("id")
      ]
    end
}


# =============================================================================
# Validate projected package before writing
# =============================================================================

Dir.mktmpdir(
  "selflo-perspective-publish"
) do |temporary|

  payload_paths = []


  manifest
    .fetch("files")
    .each do |descriptor|

      bytes =
        payload_bytes_by_path[
          descriptor.fetch("path")
        ] ||
        File.binread(
          File.join(
            output_root,
            descriptor.fetch("path")
          )
        )


      path =
        File.join(
          temporary,
          descriptor.fetch("path")
        )


      FileUtils.mkdir_p(
        File.dirname(path)
      )


      File.binwrite(
        path,
        bytes
      )


      unless descriptor[
        "kind"
      ] == "image"

        payload_paths << [
          descriptor.fetch("kind"),
          path
        ]
      end
    end


  manifest_path =
    File.join(
      temporary,
      "manifest.json"
    )


  File.binwrite(
    manifest_path,
    json_bytes(manifest)
  )


  grouped =
    payload_paths
      .group_by do |item|

        item.fetch(0)
      end
      .transform_values do |items|

        items.map do |_kind, path|

          read_json(path)
        end
      end


  validate_references!(
    grouped,
    channel
  )


  if options[
       :validate_schema
     ]

    run_schema_gate!(
      schema_root,
      manifest_path,
      payload_paths
    )
  end
end


# =============================================================================
# Write immutable revisioned payloads
# =============================================================================

payload_bytes_by_path.each do |path, bytes|
  immutable_write(
    File.join(
      output_root,
      path
    ),
    bytes
  )
end


manifest_bytes =
  json_bytes(
    manifest
  )


atomic_write(
  current_manifest_path,
  manifest_bytes
)


# =============================================================================
# Audit
# =============================================================================

audit = {
  "schema_version" =>
    "selflo.perspective.publish-audit.v1",

  "channel" =>
    channel,

  "library_revision" =>
    library_revision,

  "canonical_source_revision" =>
    source_index.fetch(
      "source_revision"
    ),

  "canonical_source_digest" =>
    source_digest,

  "canonical_quote_count" =>
    source_index.fetch(
      "canonical_quote_count"
    ),

  "source_files" =>
    source_audit.sort_by do |entry|

      entry.fetch("id")
    end,

  "changed_file_ids" =>
    changed.sort,

  "reused_file_ids" =>
    reused.sort,

  "story_links_projected_to_null" =>
    story_links_nulled,

  "release_unready_quote_skips" =>
    release_unready_quote_skips,

  "release_empty_theme_skips" =>
    release_empty_theme_skips,

  "release_unpaired_story_skips" =>
    release_unpaired_story_skips,

  "explicit_quote_exclusions" =>
    explicit_exclusions,

  "reading_intent_story_memberships_removed" =>
    reading_intent_story_memberships_removed,

  "release_knowledge_projection" =>
    release_knowledge_projection,

  "manifest_sha256" =>
    sha(
      manifest_bytes
    ),

  "generated_at" =>
    manifest.fetch(
      "generated_at"
    )
}


immutable_write(
  File.join(
    output_root,
    "audit/r#{library_revision}.json"
  ),
  json_bytes(audit)
)


# =============================================================================
# Result
# =============================================================================

puts(
  JSON.pretty_generate(
    {
      "status" =>
        "published_locally",

      "channel" =>
        channel,

      "library_revision" =>
        library_revision,

      "canonical_source_digest" =>
        source_digest,

      "canonical_quote_count" =>
        source_index.fetch(
          "canonical_quote_count"
        ),

      "changed_file_ids" =>
        changed.sort,

      "reused_file_ids" =>
        reused.sort,

      "release_unready_quote_skip_count" =>
        release_unready_quote_skips.length,

      "release_empty_theme_skip_count" =>
        release_empty_theme_skips.length,

      "release_empty_theme_skips" =>
        release_empty_theme_skips,

      "release_unpaired_story_skip_count" =>
        release_unpaired_story_skips.length,

      "release_unpaired_story_skips" =>
        release_unpaired_story_skips,

      "story_links_projected_to_null_count" =>
        story_links_nulled.length,

      "story_links_projected_to_null" =>
        story_links_nulled,

      "explicit_quote_exclusion_count" =>
        explicit_exclusions.length,

      "explicit_quote_exclusions" =>
        explicit_exclusions,

      "reading_intent_membership_removal_count" =>
        reading_intent_story_memberships_removed.length,

      "reading_intent_story_memberships_removed" =>
        reading_intent_story_memberships_removed,

      "release_knowledge_projection" =>
        release_knowledge_projection,

      "manifest_sha256" =>
        audit.fetch(
          "manifest_sha256"
        ),

      "output" =>
        output_root
    }
  )
)