{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selflo.app/schemas/website-environment.v1.json",
  "title": "Selflo website environment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "base_path", "robots", "content_channel", "developer_navigation", "allowed_feature_states", "allow_authoring_data", "allow_fixtures", "output_policy"],
  "properties": {
    "schema_version": {"const": "selflo.website-environment.v1"},
    "id": {"enum": ["public", "studio"]},
    "revision": {"type": "integer", "minimum": 1},
    "base_path": {"type": "string", "pattern": "^/apps/selflo/(studio/)?$"},
    "robots": {"enum": ["index,follow", "noindex,nofollow"]},
    "content_channel": {"enum": ["release", "preview"]},
    "developer_navigation": {"type": "boolean"},
    "allowed_feature_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["studio_only", "public_candidate", "released", "retired"]}},
    "allow_authoring_data": {"type": "boolean"},
    "allow_fixtures": {"type": "boolean"},
    "output_policy": {"enum": ["release_only", "staging"]}
  }
}
