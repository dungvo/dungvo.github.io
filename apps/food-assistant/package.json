{
  "name": "food-assistant",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node server/api.mjs",
    "start:local": "node --env-file=.env server/api.mjs",
    "demo": "node scripts/demo.mjs",
    "setup:lan": "node scripts/setup-lan.mjs",
    "start:lan": "node --env-file-if-exists=.env --env-file=.env.lan server/api.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/browser.mjs"
  }
}
