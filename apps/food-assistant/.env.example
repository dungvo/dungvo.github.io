# Copy this file to .env and set your own values.
# Generate the shared shop token with: openssl rand -hex 32
FOOD_TOKEN=
FOOD_AI_PROVIDER=groq
GROQ_API_KEY=
# Install FFmpeg and set this to 1 to enable server speech recognition.
FOOD_TRANSCRIBE=0
FOOD_DB=food-assistant.sqlite
HOST=127.0.0.1
PORT=8787
# For LAN HTTPS use a certificate trusted by the devices.
# FOOD_TLS_CERT=/absolute/path/to/cert.pem
# FOOD_TLS_KEY=/absolute/path/to/key.pem
